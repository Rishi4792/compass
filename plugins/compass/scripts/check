});

check('P5.1', 'attacks: conformance forced for parts with a mock or sketch, load for timed promises, product classes at the last part, ids by promise', () => {
  const cat = read(path.join(ROOT, 'shared', 'failure-catalogue.md')); const n = (cat.match(/^## [a-z-]+$/gm) || []).length; if (n !== 21) throw new Error(`${n} classes, expected 21 (13 build + 4 idea + 4 plan)`);
  if (!/mocks\/part-<n>\.html/.test(cat) || !/Tolerance:/.test(cat)) throw new Error('conformance recipe lacks the mock path or tolerance');
  const a = run(['attacks', F('idea-visual'), 'build', '--json']); const rows = JSON.parse(a.slice(a.indexOf('[')));
  if (a !== run(['attacks', F('idea-visual'), 'build', '--json'])) throw new Error('not deterministic');
  const pm = rows.filter(r => r.key === 'picture-mismatch'); if (pm.length !== 2 || !pm.every(r => /^P1\./.test(r.promise))) throw new Error(`picture-mismatch rows: ${pm.map(r => r.promise).join(',')}`);
  if (!rows.some(r => r.key === 'load' && r.promise === 'P1.1')) throw new Error('no load row for "within 10 seconds"');
  if (!rows.filter(r => r.promise === 'all').every(r => r.when === 'last part')) throw new Error('product rows not at the last part');
  for (const st of ['idea', 'plan']) { const o = run(['attacks', F('idea-data'), st, '--json']); if (JSON.parse(o.slice(o.indexOf('['))).length !== 4) throw new Error(`${st}: not 4 fixed attacks`); }
  const md = read(F('idea-visual/attacks.md')); if (!/\| State \|/.test(md)) throw new Error('no state column');
  const { t, b } = toyRepo();
  for (const bad of [['A3 P1.1 held', 'class: x'], ['A99 P9.9 attempt 1 held', 'class: x'], ['A2 P1.2 attempt 2 held', 'class: x'], ['A2 P1.2 attempt 1 broke', 'class: x']]) if (!fails(['receipt', b, 'attack', ...bad], t)) throw new Error(`attack receipt accepted: ${bad[0]}`);
  if (!fails(['receipt', b, 'attack', 'A2 P1.2 attempt 1 held'], t)) throw new Error('attack receipt without a class accepted');
  run(['receipt', b, 'attack', 'L1 P1.1 attempt 1 held', 'class: look'], t); if (!fails(['receipt', b, 'attack', 'L2 P2.1 attempt 1 held', 'class: look'], t)) throw new Error('a look receipt for a part with no screen was accepted');
  const r1 = read(path.join(b, 'attacks.md')).match(/^\|\s*(A\d+)\s*\|\s*P1\.2\s*\|\s*(\S+)/m); run(['receipt', b, 'attack', `${r1[1]} P1.2 attempt 1 broke`, `class: ${r1[2]}`, 'reproduction: node check.js → observed x, expected y'], t); run(['receipt', b, 'build', `fix ${r1[1]}`, 'check added: tests/born.test.js', 'red: node tests/born.test.js → FAIL'], t); run(['receipt', b, 'attack', `${r1[1]} P1.2 attempt 2 broke`, `class: ${r1[2]}`, 'reproduction: node check.js → observed x2, expected y'], t); run(['receipt', b, 'attack', `${r1[1]} P1.2 attempt 2 resolved`, 'answered: move on', 'leftover: broke twice; fixed'], t);
  const stt = JSON.parse(run(['state', b, '--json'], t)); if (!stt.attacks.find(a => a.key === `${r1[1]} P1.2` && a.resolved)) throw new Error('resolved receipt was refused or ignored');
  return '21 classes; conformance forced on the screen part; load forced on a timed promise; product rows last; idea/plan 4 each; state column; malformed, unknown, out-of-order and class-less attack receipts refused';
});

check('P5.3b', 'a reviewer may only say held or broke, in one line, with no smuggled list', () => {
  run(['attack-receipt-check', 'held']); run(['attack-receipt-check', 'broke: node check.js → observed exit 1, expected exit 0']);
  for (const bad of ['I found three issues', 'broke: it is wrong', 'held, but note that', 'HELD', 'broke: x → observed 1, expected 0. Also found: (1) y (2) z', 'first line\nheld', 'broke: x → observed 1, expected 0 and another break: y → observed 2, expected 3', 'broke: x → observed 1, expected 0 — plus y is broken']) if (!fails(['attack-receipt-check', bad])) throw new Error(`accepted: ${bad}`);
  return '2 shapes accepted; prose, trailing notes, "also found", multi-line all rejected';
});

check('S3.7', 'the look rubric has 13 items incl. depth, structure, controls; median and bar hold; shots size to content', () => {
  run(['rubric-check']); const good = 'scores: hierarchy=4 spacing=4 type=5 color=4 components=4 states=4 alignment=4 polish=4 responsive=4 copy=5 depth=4 structure=4 controls=4';
  run(['look-score', 'premium', good, good, good]);
  const two = fails(['look-score', 'premium', good, good.replace('controls=4', 'controls=2 | low: controls@"native select"'), good.replace('controls=4', 'controls=2 | low: controls@"default button"')]) || ''; if (!/controls=2 \(native select \/ default button\)/.test(two)) throw new Error('two low reviewers on controls did not break with regions');
  if (!fails(['attack-receipt-check', '--look', 'scores: hierarchy=4 spacing=4'])) throw new Error('a short look line accepted');
  let note = 'screenshots: skipped (no Chrome)';
  try { const page = path.join(os.tmpdir(), 'compass-look-page.html'); run(['idea-page', F('idea-visual'), '--full', `--out=${page}`]); const o = run(['shots', page, `--out=${path.join(os.tmpdir(), 'compass-shots')}`, '--name=tt']).trim().split('\n'); if (o.length !== 2 || !o.every(f => fs.existsSync(f) && fs.statSync(f).size > 20000)) throw new Error('shots did not produce 2 PNGs'); note = 'screenshots: phone + desktop sized to the page'; } catch (e) { if (!/no Chrome/.test(e.stderr || '')) throw e; }
  if (!fs.existsSync(path.join(ROOT, 'design', 'house-style', 'SYSTEM.md')) || !fs.existsSync(path.join(ROOT, 'templates', 'tokens.css'))) throw new Error('design system or tokens missing');
  for (const f of ['shared/interview.md', 'skills/build/SKILL.md']) if (!/design\/house-style\/SYSTEM\.md/.test(read(path.join(ROOT, f))) || !/tokens\.css/.test(read(path.join(ROOT, f)))) throw new Error(`${f} does not bind the design system and tokens`);
  return `13 items; median bar; ${note}; system and tokens bound in interview and build`;
});

check('P3.2', 'plan check: 21 sections, real path, skeleton, two-way trace, command + expected per step, spec and runbook, ≤6 h', () => {
  const full = F('plan-full'); run(['plan-check', full]);
  const variants = { 'a promise with no step': t => t.replace(/\bP1\.3\b/g, 'P1.1'), 'a step with no promise': t => t.replace(/(S2\.3 [^\n]*?)→ P2\.5/, '$1→'), 'a fake path in §3': t => { const [a, rest] = t.split(/^## 3\. /m); const [s3, ...after] = rest.split(/^## 4\. /m); return a + '## 3. ' + s3.replace(/`[^`]+`/g, '`nowhere/none.js`') + '## 4. ' + after.join('## 4. '); }, 'slice 1 not the skeleton': t => t.replace('### Slice 1 — Skeleton', '### Slice 1 — Setup'), 'a verify without expected': t => t.replace(/(S1\.2 [^\n]*?)` → [^·\n]*/, '$1`'), 'a missing section': t => t.replace(/^## 19\. Runbook[\s\S]*?(?=^## 20\.)/m, ''), 'a 9 h step': t => t.replace(/(S1\.2 [^\n]*?)≈ 2 h/, '$1≈ 9 h') };
  const expectMsg = { 'a promise with no step': /P1\.3 has no step/, 'a step with no promise': /S2\.3 serves no promise/, 'a fake path in §3': /§3 cites no path/, 'slice 1 not the skeleton': /must be the walking skeleton/, 'a verify without expected': /S1\.2: verify needs/, 'a missing section': /section 19 \(Runbook\) missing/, 'a 9 h step': /S1\.2 is estimated at 9 h/ };
  for (const [name, mutate] of Object.entries(variants)) { const root = tmpdir('compass-plan-'); const tmp = path.join(root, '.claude', 'builds', 'x'); fs.mkdirSync(tmp, { recursive: true }); fs.mkdirSync(path.join(root, 'compass', 'scripts'), { recursive: true }); fs.mkdirSync(path.join(root, 'compass', 'templates')); fs.writeFileSync(path.join(root, 'compass', 'scripts', 'compass'), ''); fs.writeFileSync(path.join(root, 'compass', 'templates', 'card.html'), ''); for (const n of ['idea.md', 'spec.md']) fs.copyFileSync(path.join(full, n), path.join(tmp, n)); const m = mutate(read(path.join(full, 'plan.md'))); if (m === read(path.join(full, 'plan.md'))) throw new Error(`variant "${name}" changed nothing`); fs.writeFileSync(path.join(tmp, 'plan.md'), m); const out = fails(['plan-check', tmp]) || ''; if (!out) throw new Error(`plan-check accepted ${name}`); if (!expectMsg[name].test(out)) throw new Error(`${name}: refused for the wrong reason: ${out.trim().split('\n')[0]}`); }
  const card = run(['plan-card', full]); if (card.split('\n').length > 40 || /\/Users\//.test(card) || /slice/i.test(card) || !/The biggest risks/.test(card)) throw new Error('plan card too long, shows a path, or says slice');
  return 'full plan passes; 7 broken variants refused; card ≤40 lines with no path';
});

check('P7.2', 'the door and the stages ask only at gates, record asks and answers, define every option', () => {
  const door = read(path.join(ROOT, 'skills', 'compass', 'SKILL.md'));
  for (const must of ['Gate 3', '"gate 3"', 'for you:', 'Look at a past build', 'print each past build', 'Fix one first, ask which item', 'No build here yet', 'Node', 'Idea approved · next: the screens', 'Building again']) if (!door.includes(must)) throw new Error(`door missing: ${must}`);
  if (!/node_modules|command -v node/.test(read(path.join(ROOT, 'hooks', 'hooks.json')))) throw new Error('the session hook does not guard for Node');
  const plan = read(path.join(ROOT, 'skills', 'plan', 'SKILL.md')); if (!/Your questions first/.test(plan) || !/renumber/.test(plan)) throw new Error('plan skill: Q lines not asked first, or split ids not renumbered');
  const idea = read(path.join(ROOT, 'skills', 'idea', 'SKILL.md')); if (!/attacks <dir> idea/.test(idea) || !/never change/.test(idea)) throw new Error('idea skill: idea attacks not wired or ids not stable');
  const dep = read(path.join(ROOT, 'skills', 'deploy', 'SKILL.md')); if (!/--record/.test(dep) || !/--close-watch/.test(dep) || !/COMPASS_TARGET/.test(dep)) throw new Error('deploy skill: gates record, close-watch or URL target missing');
  const bld = read(path.join(ROOT, 'skills', 'build', 'SKILL.md')); if (!/part-line <dir>/.test(bld) || !/--record/.test(bld)) throw new Error('build skill: part-line or gates --record missing');
  const readme = read(path.join(ROOT, '..', '..', 'README.md')); if (!/nodejs\.org/.test(readme)) throw new Error('README does not say where Node comes from');
  const deploy = read(path.join(ROOT, 'skills', 'deploy', 'SKILL.md')); if (!/"gate 4"/.test(deploy) || !/Make <title> live for real users now\?/.test(deploy) || /Deploy now \(Recommended\)/.test(deploy)) throw new Error('gate 4 not recorded or not in plain words');
  const build = read(path.join(ROOT, 'skills', 'build', 'SKILL.md')); if (!/Build it as written \(Recommended\)/.test(build) || !/drift stop at S<n>/.test(build)) throw new Error('drift stop does not ask with a recommended answer');
  const amend = read(path.join(ROOT, 'skills', 'amend', 'SKILL.md')); if (!/Ask before anything changes/.test(amend)) throw new Error('amend does not ask first');
  const attack = read(path.join(ROOT, 'skills', 'attack', 'SKILL.md')); if (!/Move on, note it on the card \(Recommended\)/.test(attack) || !/never `fork`/.test(attack) || !/entire final message/.test(attack) || !/five times/.test(attack) || !/second break at A<n>/.test(attack) || !/replacement reviewer/.test(attack)) throw new Error('attack protocol missing a fix');
  return 'gates 3 and 4 recorded; drift stop and amend ask first; attack protocol tightened';
});

check('P7.1', 'the card renders the plain line, one row per promise, and no codes', () => {
  const out = path.join(os.tmpdir(), 'compass-card-check.html'); run(['card', F('mid-build'), `--out=${out}`]); const html = read(out); const st = JSON.parse(run(['state', F('mid-build'), '--json']));
  if (!html.includes(esc(st.lineBare))) throw new Error('status line missing'); if ((html.match(/class="row"/g) || []).length !== st.promises.length) throw new Error('rows ≠ promises');
  if (!/For you/.test(html) || html.includes(esc(st.line))) throw new Error('the question must appear once, in its own box'); if (/\b(S\d+\.\d+|A\d+ P|SLICE)\b/.test(html.replace(/<style[\s\S]*?<\/style>/, ''))) throw new Error('codes on the card');
  if (!/tested, passed|broke once, now fixed|not built yet/.test(html)) throw new Error('plain state words missing');
  return `${st.promises.length} rows; line once; question once; plain words; no codes`;
});
function esc(s) { return String(s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c])); }

check('P3.1', 'the plan screen fits 40 lines, shows no path and no builder words', () => {
  const card = run(['plan-card', F('plan-full')]); const ls = card.trim().split('\n'); if (ls.length > 40) throw new Error(`${ls.length} lines`);
  if (/\/Users\//.test(card) || /\bslice\b/i.test(card) || !/Your parts, in build order/.test(card) || !/The biggest risks/.test(card) || !/thin version of the whole thing/.test(card)) throw new Error('path, slice, or missing sections');
  return `${ls.length} lines of 40; parts, risks; no path, no slice`;
});

check('P4.4', 'plan check refuses a step over one sitting', () => {
  const root = tmpdir('compass-est-'); const tmp = path.join(root, '.claude', 'builds', 'x'); fs.mkdirSync(tmp, { recursive: true }); fs.mkdirSync(path.join(root, 'compass', 'scripts'), { recursive: true }); fs.mkdirSync(path.join(root, 'compass', 'templates')); fs.writeFileSync(path.join(root, 'compass', 'scripts', 'compass'), ''); fs.writeFileSync(path.join(root, 'compass', 'templates', 'card.html'), '');
  for (const n of ['idea.md', 'spec.md']) fs.copyFileSync(F(`plan-full/${n}`), path.join(tmp, n)); fs.writeFileSync(path.join(tmp, 'plan.md'), read(F('plan-full/plan.md')).replace(/(S1\.2 [^\n]*?)≈ 2 h/, '$1≈ 9 h'));
  const out = fails(['plan-check', tmp]) || ''; if (!/S1\.2 is estimated at 9 h/.test(out)) throw new Error('a 9 h step passed'); return 'a 9 h step is refused with the split instruction';
});

check('S8.1', 'core instruction text under 10,000 words', () => {
  let words = 0; const walk = d => { for (const n of fs.readdirSync(d)) { const p = path.join(d, n); if (fs.statSync(p).isDirectory()) walk(p); else if (p.endsWith('.md')) words += read(p).split(/\s+/).filter(Boolean).length; } };
  for (const d of ['skills', 'shared']) walk(path.join(ROOT, d)); if (words > 10000) throw new Error(`${words} words`); return `${words} words of 10,000`;
});

if (only && !results.length) { console.log(`✗ no such check: ${only}`); console.log('\n0 of 0 checks green: unknown id'); process.exit(1); }
for (const [id, name, r, d] of results) console.log(`${r === 'green' ? '✓' : '✗'} ${id.padEnd(5)} ${name} — ${d}`);
const red = results.filter(r => r[2] === 'RED').length;
console.log(`\n${results.length - red} of ${results.length} checks green`);
process.exit(red ? 1 : 0);
