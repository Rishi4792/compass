    for (const [f, s] of [['sales.js', 'total 540'], ['check.js', 'ok'], ['stock.js', '1 message'], ['tests/born.test.js', 'ok']]) fs.writeFileSync(path.join(t, f), `console.log(${JSON.stringify(s)})`);
    gitIn(t, 'init -q'); gitIn(t, 'add -A'); gitIn(t, 'commit -qm toy'); return { t, b }; };
  const jsonRows = (o, kind) => { const out = run(['attacks', o.b, kind, '--json'], o.t); return JSON.parse(out.slice(out.indexOf('['))); };
  const make = upTo => { const o = files(); for (let k = 1; k <= 11; k++) run(['answer', o.b, 'question', String(k), '11'], o.t); ok(o.b, 'idea', 'drafted', ASKI); for (const r of jsonRows(o, 'idea')) ok(o.b, 'attack', `${r.id} page attempt 1 held`, `class: ${r.key}`); ok(o.b, 'idea', 'approved', 'answered: approve'); if (upTo === 'ideaApproved') return o;
    ok(o.b, 'idea', 'look ready', ASKL); ok(o.b, 'idea', 'look approved', 'answered: looks right'); ok(o.b, 'plan', 'drafted', ASKP); if (upTo === 'planDrafted') return o; for (const r of jsonRows(o, 'plan')) ok(o.b, 'attack', `${r.id} plan attempt 1 held`, `class: ${r.key}`); ok(o.b, 'plan', 'approved', 'answered: approve'); run(['attacks', o.b, 'build'], o.t); return o; };
  const clone = o => { const t = tmpdir('compass-s96c-'); fs.cpSync(o.t, t, { recursive: true }); const b = path.join(t, '.claude', 'builds', 'till'); const rf = path.join(b, 'receipts.md'); fs.writeFileSync(rf, read(rf).split(`ran on: ${o.t}\n`).join(`ran on: ${t}\n`)); return { t, b }; };
