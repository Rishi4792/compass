check('S9.4', 'round 6: every way around the record that QA found (V1–V43), plain decision lines, and the first-timer items (W) are refused or accepted as the rules say', () => {
  const ASK = (q, a = 'Yes (Recommended) → I go on', n = 'Not yet → nothing happens') => `[ ] ask: ${q} · ${a} · ${n}`;
  const ASKI = ASK('Approve the Idea page?'), ASKL = ASK('Do the screens look right?'), ASKP = ASK('Approve the plan?'), ASK3 = ASK('Accept what was set aside?', 'Accept (Recommended) → it ships as it is', 'No → I keep fixing it'), ASK4 = ASK('Make Till live for real users now?');
  const rootOf = b => path.resolve(b, '..', '..', '..'); const ok = (b, ...a) => run(['receipt', b, ...a], rootOf(b)); const R = (b, ...a) => fails(['receipt', b, ...a], rootOf(b));
  const want = (id, re, out) => { if (!out || !re.test(out)) throw new Error(`${id}: ${out ? 'refused for another reason: ' + out.trim().split('\n').filter(Boolean).pop().slice(0, 170) : 'accepted'}`); };
  const sub = (f, from, to) => { const x = read(f); if (!x.includes(from)) throw new Error(`S9.4 setup: "${from}" not in ${path.basename(f)}`); fs.writeFileSync(f, x.replace(from, to)); };
  const P = o => path.join(o.b, 'plan.md'), I = o => path.join(o.b, 'idea.md'); const gitIn = (t, c) => execSync(`git -c user.email=t@t -c user.name=t -c tag.gpgsign=false -c commit.gpgsign=false ${c}`, { cwd: t, stdio: 'ignore' });
  const ymd = d => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`; const tomorrow = ymd(new Date(Date.now() + 86400000));
  const files = () => { const t = tmpdir('compass-s94-'); const b = path.join(t, '.claude', 'builds', 'till'); fs.mkdirSync(path.join(b, 'pictures'), { recursive: true }); fs.mkdirSync(path.join(t, 'tests'));
    for (const f of ['idea.md', 'spec.md']) fs.copyFileSync(F('idea-visual/' + f), path.join(b, f)); fs.copyFileSync(F('idea-visual/pictures/sketch-1.svg'), path.join(b, 'pictures', 'sketch-1.svg'));
    fs.writeFileSync(path.join(b, 'plan.md'), read(F('plan-approved/plan.md')).replace('`node sales.js till.csv` → total', '`node sales.js` → total 540').replace('`node stock.js --dry` → 1 message', '`node stock.js` → 1 message'));
    for (const [f, s] of [['sales.js', 'total 540'], ['check.js', 'ok'], ['stock.js', '1 message'], ['tests/born.test.js', 'ok']]) fs.writeFileSync(path.join(t, f), `console.log(${JSON.stringify(s)})`); fs.writeFileSync(path.join(t, 'fail.js'), 'console.log("bad"); process.exit(1)');
    gitIn(t, 'init -q'); gitIn(t, 'add -A'); gitIn(t, 'commit -qm toy'); return { t, b }; };
  const jsonRows = (o, kind) => { const out = run(['attacks', o.b, kind, '--json'], o.t); return JSON.parse(out.slice(out.indexOf('['))); };
  const make = (upTo, noLook) => { const o = files(); if (noLook) fs.writeFileSync(I(o), read(I(o)).replace(/^look: match\n/m, '').replace(/^screen: yes\n/m, '').replace(/^sketch: .*\n/m, ''));
    for (let k = 1; k <= 11; k++) run(['answer', o.b, 'question', String(k), '11'], o.t); if (upTo === 'answers') return o;
    ok(o.b, 'idea', 'drafted', ASKI); if (upTo === 'drafted') return o; for (const r of jsonRows(o, 'idea')) ok(o.b, 'attack', `${r.id} page attempt 1 held`, `class: ${r.key}`); ok(o.b, 'idea', 'approved', 'answered: approve');
    if (!noLook) { ok(o.b, 'idea', 'look ready', ASKL); ok(o.b, 'idea', 'look approved', 'answered: looks right'); } if (upTo === 'look') return o;
    ok(o.b, 'plan', 'drafted', ASKP); if (upTo === 'planDrafted') return o; for (const r of jsonRows(o, 'plan')) ok(o.b, 'attack', `${r.id} plan attempt 1 held`, `class: ${r.key}`); ok(o.b, 'plan', 'approved', 'answered: approve'); run(['attacks', o.b, 'build'], o.t); return o; };
  const clone = o => { const t = tmpdir('compass-s94c-'); fs.cpSync(o.t, t, { recursive: true }); const b = path.join(t, '.claude', 'builds', 'till'); const rf = path.join(b, 'receipts.md'); fs.writeFileSync(rf, read(rf).split(`ran on: ${o.t}\n`).join(`ran on: ${t}\n`)); return { t, b }; };
  const rows = o => read(path.join(o.b, 'attacks.md')).split('\n').map(l => l.match(/^\|\s*(A\d+)\s*\|\s*(\S+)\s*\|\s*(\S+)/)).filter(Boolean).map(m => ({ id: m[1], promise: m[2], key: m[3] }));
  const closeRows = o => { const have = new Set(JSON.parse(run(['state', o.b, '--json'], o.t)).attacks.map(a => a.key)); for (const r of rows(o)) if (!have.has(`${r.id} ${r.promise}`)) ok(o.b, 'attack', `${r.id} ${r.promise} attempt 1 held`, `class: ${r.key}`); };
  const proveAll = o => { for (const s of ['S1.1', 'S1.2', 'S2.1']) ok(o.b, 'build', `step ${s} proven`, 'x'); };
  const gatesRec = o => run(['gates', o.b, '--run', '--record'], o.t); const safety = o => { run(['preflight', o.b, '--record'], o.t); ok(o.b, 'deploy', 'rehearsal', 'ran: undo on a copy → back as it was'); };
