  const sc = tmpdir('compass-screen-'); fs.writeFileSync(path.join(sc, 'idea.md'), read(F('idea-visual/idea.md')).replace('look: match', 'look: premium').replace(/sketch: pictures\/sketch-1\.svg\n/, '')); if (!/needs a mock:/.test(fails(['idea-page', sc, '--check']) || '')) throw new Error('a premium screen part with neither mock nor sketch passed');
