  const broken = o => { fs.writeFileSync(path.join(o.t, 'check.js'), 'console.log("broken"); process.exit(1)'); gitIn(o.t, 'commit -qam broke'); };
  // V1–V4, V22, V23: going live needs the last recorded run green, on this project, at the code as it is now, after every change; the release command is a real proof
  { const o = clone(READY); broken(o); fails(['gates', o.b, '--run', '--record'], o.t); run(['preflight', o.b, '--record'], o.t); want('V1', /last recorded gate run is red/, R(o.b, 'deploy', 'gate 4', ASK4)); const s = JSON.parse(run(['state', o.b, '--json'], o.t)); if (!/^Built · next: I fix the red checks/.test(s.line) || s.route !== 'build') throw new Error(`V1: line "${s.line}", route ${s.route}`); }
  { const o = clone(READY); broken(o); run(['preflight', o.b, '--record'], o.t); want('V2', /the code changed since the last green run; run the gate suite again/, R(o.b, 'deploy', 'gate 4', ASK4)); }
  { const o = clone(LIVE); sub(P(o), 'verify: `node sales.js` → total 540', 'verify: `node sales.js --today` → total 540'); askChange(o); ok(o.b, 'amend', 'part 1 edited', 'decision: the total counts today only', 'supersede: S1.1', 'answered: change the page'); ok(o.b, 'build', 'step S1.1 proven', 'x'); closeRows(o); gatesRec(o); run(['preflight', o.b, '--record'], o.t); gate4yes(o);
    want('V3', /writeback before released: /, fails(['writeback', o.b, '--target=local', `--watch-until=${tomorrow}`], o.t)); }
  { const o = clone(BUILT); fs.writeFileSync(path.join(o.t, 'check.js'), 'if (process.env.COMPASS_TARGET) console.log("ok"); else { console.log("broken"); process.exit(1); }'); gitIn(o.t, 'commit -qam target'); run(['gates', o.b, '--run', '--record', '--target=https://staging.example'], o.t); safety(o); want('V4', /web address is recorded but does not open the gate/, R(o.b, 'deploy', 'gate 4', ASK4)); }
  { const o = clone(READY); sub(P(o), '## 21. Decision log', '## 21. Decision log\n- the undo line now names the tag'); ok(o.b, 'plan', 'revised', 'decision: the undo line is clearer'); gatesRec(o); want('V22', /safety checks ran before the last change/, R(o.b, 'deploy', 'gate 4', ASK4)); }
  { const o = clone(READY); gate4yes(o); want('V23', /the release command/, R(o.b, 'deploy', 'released', 'git --version → git version')); }
  // V5, V11, V20, V29, V31: the answer verb never writes a line idea.md reads as structure, never reads a file outside the build folder, and refuses before it writes
  { const o = clone(LIVE); run(['answer', o.b, 'part', '1', P11], o.t); want('V5', /starts with "-"/, fails(['answer', o.b, 'part', '1', '--prose=- P1.2 Export the day to the accountant. → 1 file'], o.t)); if (/Export the day/.test(read(I(o)))) throw new Error('V5: the refused prose reached idea.md'); }
  { const o = files(); fs.writeFileSync(path.join(o.t, '.env'), 'STRIPE_SECRET=sk_live_do_not_show\n'); want('V11', /outside the build folder/, fails(['answer', o.b, 'part', '1', '--mock=../../../.env'], o.t)); want('V11 (picture)', /outside the build folder/, fails(['answer', o.b, 'part', '1', '--picture=file:../../../.env'], o.t)); if (/\.env/.test(read(I(o)))) throw new Error('V11: the secrets file was named on the page'); }
  { const d = tmpdir('compass-s96p-'); fs.copyFileSync(F('idea-visual/idea.md'), path.join(d, 'idea.md')); const before = read(path.join(d, 'idea.md')); want('V20', /starts with "#"/, fails(['answer', d, 'part', '1', '--prose=### Part 9 — Injected'], d)); want('V29', /no such question/, fails(['answer', d, 'set', 'purpose', 'A purpose nobody approved', '--question=12'], d)); if (read(path.join(d, 'idea.md')) !== before) throw new Error('V20/V29: idea.md was written before the refusal');
    run(['answer', d, 'open', 'Is a refund a sale → or a return? → a return'], d); run(['answer', d, 'open', 'Is a refund a sale → or a loss? → a loss'], d); if (((read(path.join(d, 'idea.md')).split('## Open')[1] || '').match(/^- /gm) || []).length !== 2) throw new Error('V31: an open question with "→" in it replaced another'); if (!/<b>Is a refund a sale → or a return\?<\/b> a return/.test(read(path.join(d, 'idea-page.html')))) throw new Error('V31: the page splits an open question at its first →'); }
  // V6, V8, V18, V24: attack rows are the script's own choice with stable ids; the old proof rules stay only with the old command
  { const o = clone(APP); proveAll(o); const row = rows(o).find(r => r.promise === 'P2.1' && r.key !== 'wrong-person'); fs.rmSync(path.join(o.b, 'attacks.md')); want('V6', /attack in attacks\.md; this receipt says class wrong-person/, R(o.b, 'attack', `${row.id} P2.1 attempt 1 held`, 'class: wrong-person')); want('V18', /written only by its own verb/, R(o.b, 'build', 'attacks chosen')); }
