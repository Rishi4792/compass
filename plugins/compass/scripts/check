  const closeRows = o => { const have = new Set(JSON.parse(run(['state', o.b, '--json'], o.t)).attacks.map(a => a.key)); for (const r of rows(o)) if (!have.has(`${r.id} ${r.promise}`)) ok(o.b, 'attack', `${r.id} ${r.promise} attempt 1 held`, `class: ${r.key}`); };
  const proveAll = o => { for (const s of ['S1.1', 'S1.2', 'S2.1']) ok(o.b, 'build', `step ${s} proven`, 'x'); }; const gatesRec = o => run(['gates', o.b, '--run', '--record'], o.t);
  const safety = o => { run(['preflight', o.b, '--record'], o.t); ok(o.b, 'deploy', 'rehearsal', 'ran: undo on a copy → back as it was'); }; const gate4yes = o => { ok(o.b, 'deploy', 'gate 4', ASK4); ok(o.b, 'deploy', 'gate 4', 'answered: go live'); };
  const askChange = o => ok(o.b, 'build', 'change asked', CHANGE_ASK); const toyPlan = (o, cmd, step = 'S1.2') => sub(P(o), step === 'S1.2' ? 'verify: `node check.js` → ok' : 'verify: `node sales.js` → total 540', `verify: \`${cmd}\` → ${step === 'S1.2' ? 'ok' : 'total 540'}`);
  const twoBreaks = () => { const o = toyRepo(); ok(o.b, 'build', 'step S1.2 proven', 'x'); const r1 = rows(o).find(r => r.promise === 'P1.2'); ok(o.b, 'attack', `${r1.id} P1.2 attempt 1 broke`, `class: ${r1.key}`, 'reproduction: node check.js → observed x, expected y'); ok(o.b, 'build', `fix ${r1.id}`, 'check added: tests/born.test.js', 'red: node tests/born.test.js → FAIL'); ok(o.b, 'attack', `${r1.id} P1.2 attempt 2 broke`, `class: ${r1.key}`, 'reproduction: node check.js → observed x2, expected y'); return { ...o, r1 }; };
