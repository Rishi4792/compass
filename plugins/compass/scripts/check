#!/usr/bin/env node
'use strict';
// check — the gate suite for Compass's own build. One check per promise that has a step proven so far,
// plus every check born from a break. Exit 0 = all green. Run: node scripts/check
const { execFileSync } = require('child_process');
const fs = require('fs'); const os = require('os'); const path = require('path');
const ROOT = path.resolve(__dirname, '..');
const run = (args, cwd = ROOT) => execFileSync('node', [path.join(ROOT, 'scripts', 'compass'), ...args], { cwd, encoding: 'utf8' });
const results = [];
const check = (id, name, fn) => { try { const d = fn(); results.push([id, name, 'green', d || '']); } catch (e) { results.push([id, name, 'RED', e.message.split('\n')[0]]); } };
const fixtures = ['fresh', 'plan-approved', 'mid-build', 'live'];

check('P7.4', 'state reads only idea.md, plan.md, receipts.md', () => {
  for (const f of fixtures) {
    const dir = path.join(ROOT, 'fixtures', f);
    const full = run(['state', dir, '--json']);
    const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'compass-')); const copy = path.join(tmp, f); fs.mkdirSync(copy);
    for (const n of ['idea.md', 'plan.md', 'receipts.md']) if (fs.existsSync(path.join(dir, n))) fs.copyFileSync(path.join(dir, n), path.join(copy, n));
    const bare = run(['state', copy, '--json']);
    if (full !== bare) throw new Error(`${f}: state differs when decoy files are removed`);
    const exp = path.join(ROOT, 'fixtures', 'expected', f + '.json');
    if (fs.existsSync(exp) && fs.readFileSync(exp, 'utf8') !== full) throw new Error(`${f}: state differs from expected.json`);
  }
  return `${fixtures.length} fixtures, decoy files ignored, expected.json matched`;
});

check('P4.1', 'promise states come from receipts alone', () => {
  const st = JSON.parse(run(['state', path.join(ROOT, 'fixtures', 'mid-build'), '--json']));
  const want = { 'P1.1': 'held', 'P1.2': 'fixed', 'P2.1': 'planned' };
  for (const p of st.promises) if (want[p.id] !== p.state) throw new Error(`${p.id}: ${p.state}, wanted ${want[p.id]}`);
  if (st.ask !== 'Should refunds count as negative sales on the daily line? (suggest yes)') throw new Error('ask not surfaced');
  const live = JSON.parse(run(['state', path.join(ROOT, 'fixtures', 'live'), '--json']));
  if (!live.promises.every(p => p.state === 'live')) throw new Error('live fixture: not all promises live');
  if (live.leftovers.length !== 1 || live.decisions.length !== 3) throw new Error(`live fixture: ${live.leftovers.length} leftovers, ${live.decisions.length} decisions`);
  // an attack that still breaks on attempt 2 must surface as "needs you"
  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'compass-needs-'));
  for (const n of ['idea.md', 'plan.md']) fs.copyFileSync(path.join(ROOT, 'fixtures', 'mid-build', n), path.join(tmp, n));
  fs.writeFileSync(path.join(tmp, 'receipts.md'), fs.readFileSync(path.join(ROOT, 'fixtures', 'plan-approved', 'receipts.md'), 'utf8') +
    '## RECEIPT — attack · x · A2 P1.2 attempt 1 broke · 2026-10-21T11:20:00Z\n- [x] reproduction: r\n## RECEIPT — attack · x · A2 P1.2 attempt 2 broke · 2026-10-21T12:30:00Z\n- [x] reproduction: r\n- [ ] ask: Promise P1.2 still breaks. What now?\n');
  const ny = JSON.parse(run(['state', tmp, '--json']));
  if (ny.promises.find(p => p.id === 'P1.2').state !== 'needs you') throw new Error('attempt-2 break not shown as needs you');
  return 'held / fixed / planned / live / needs you / ask / decisions / leftovers all as expected';
});

check('P7.1', 'card renders the status line and one row per promise', () => {
  const dir = path.join(ROOT, 'fixtures', 'mid-build');
  const out = path.join(os.tmpdir(), 'compass-card-check.html');
  run(['card', dir, `--out=${out}`]);
  const html = fs.readFileSync(out, 'utf8');
  const st = JSON.parse(run(['state', dir, '--json']));
  if (!html.includes(st.line.replace(/&/g, '&amp;'))) throw new Error('status line missing');
  const rows = (html.match(/class="row"/g) || []).length;
  if (rows !== st.promises.length) throw new Error(`${rows} rows for ${st.promises.length} promises`);
  if (!html.includes('For you')) throw new Error('the question for the person is missing');
  return `${rows} rows, status line, question present`;
});

check('P1.1', 'one door: exactly one user-visible entry', () => {
  const skills = fs.readdirSync(path.join(ROOT, 'skills'));
  const visible = skills.filter(s => !/user-invocable:\s*false/.test(fs.readFileSync(path.join(ROOT, 'skills', s, 'SKILL.md'), 'utf8')));
  if (fs.existsSync(path.join(ROOT, 'commands'))) throw new Error('a commands/ folder exists; the door is a skill');
  if (visible.length !== 1 || visible[0] !== 'compass') throw new Error(`visible skills: ${visible.join(', ')}`);
  return `skills: ${skills.length}, visible: compass`;
});

check('P2.3', 'idea page: ≤150 words per part, a number on every promise, a picture per part', () => {
  for (const f of ['idea-visual', 'idea-data']) run(['idea-page', path.join(ROOT, 'fixtures', f), '--check']);
  const bad = path.join(os.tmpdir(), 'compass-bad-idea'); fs.rmSync(bad, { recursive: true, force: true }); fs.mkdirSync(bad);
  fs.writeFileSync(path.join(bad, 'idea.md'), '# Idea — bad\ntitle: Bad\npurpose: x\n\n### Part 1 — Big\npicture: nope\n' + 'word '.repeat(160) + '\n- P1.1 No number here\n');
  let failed = false; try { run(['idea-page', bad, '--check']); } catch { failed = true; }
  if (!failed) throw new Error('a 160-word part with no number and an unknown picture passed the lint');
  return '2 samples within limits; an over-limit sample is refused';
});

check('P2.5', 'sketch shown for visual parts only', () => {
  const v = path.join(os.tmpdir(), 'compass-idea-v.html'), d = path.join(os.tmpdir(), 'compass-idea-d.html');
  run(['idea-page', path.join(ROOT, 'fixtures', 'idea-visual'), `--out=${v}`]); run(['idea-page', path.join(ROOT, 'fixtures', 'idea-data'), `--out=${d}`]);
  const nv = (fs.readFileSync(v, 'utf8').match(/How it will look/g) || []).length, nd = (fs.readFileSync(d, 'utf8').match(/How it will look/g) || []).length;
  if (nv !== 1 || nd !== 0) throw new Error(`visual sample has ${nv} sketches, data sample has ${nd}`);
  return 'visual sample: 1 sketch · data sample: 0';
});

check('P2.2', 'spec: every rule points at a promise; no engineering words in the interview questions', () => {
  run(['spec-check', path.join(ROOT, 'fixtures', 'idea-data')]);
  const banned = /\b(rollback|flag|schema|migration|idempotent|environment|env|RBAC|invariant|endpoint|API|database|table|cache|queue|latency|token)\b/i;
  const text = fs.readFileSync(path.join(ROOT, 'shared', 'interview.md'), 'utf8');
  const qs = text.split('\n').filter(l => /^\d+\.\s+\*\*/.test(l));
  const hits = qs.filter(l => banned.test(l.replace(/^\d+\.\s+\*\*[^*]+\*\*/, m => m)));
  if (qs.length !== 10) throw new Error(`${qs.length} questions in interview.md, expected 10`);
  if (!/\*\*Clarify/.test(text) || !/\*\*Expand/.test(text) || !/10x/.test(text)) throw new Error('clarify or expand step missing');
  const hitQ = qs.filter(l => banned.test(l.match(/\*\*([^*]+)\*\*/)[1]));
  if (hitQ.length) throw new Error(`banned word in question: ${hitQ[0].slice(0, 50)}`);
  return `10 questions incl. clarify + expand, 0 banned words in any question; spec sample: every rule → P`;
});

check('P5.1', 'attacks: chosen by script, ≤3 per promise, product classes once, deterministic', () => {
  const cat = fs.readFileSync(path.join(ROOT, 'shared', 'failure-catalogue.md'), 'utf8');
  const n = (cat.match(/^## [a-z-]+$/gm) || []).length;
  if (n !== 13) throw new Error(`${n} classes in the catalogue, expected 13`);
  for (const f of ['name', 'scope', 'damage', 'applies', 'likely', 'attack', 'break', 'check']) if ((cat.match(new RegExp(`^${f}: `, 'gm')) || []).length !== 13) throw new Error(`field ${f} missing on some class`);
  for (const f of ['idea-visual', 'idea-data']) {
    const dir = path.join(ROOT, 'fixtures', f);
    const a = run(['attacks', dir, 'build', '--json']); const b = run(['attacks', dir, 'build', '--json']);
    if (a !== b) throw new Error(`${f}: not deterministic`);
    const rows = JSON.parse(a.slice(a.indexOf('[')));
    const per = {}; for (const r of rows) { if (!/^(P\d+\.\d+|all)$/.test(r.promise)) throw new Error(`${f}: row without a promise`); per[r.promise] = (per[r.promise] || 0) + 1; }
    for (const [p, c] of Object.entries(per)) if (p !== 'all' && c > 3) throw new Error(`${f}: ${c} attacks on ${p}`);
    const prodKeys = rows.filter(r => r.promise === 'all').map(r => r.key); if (new Set(prodKeys).size !== prodKeys.length) throw new Error(`${f}: a product class repeated`);
  }
  const ideaRows = JSON.parse((s => s.slice(s.indexOf('[')))(run(['attacks', path.join(ROOT, 'fixtures', 'idea-data'), 'idea', '--json'])));
  if (ideaRows.length !== 4) throw new Error('idea stage should have 4 fixed attacks');
  return '13 classes × 8 fields; 2 samples deterministic; ≤3 per promise; product classes once; idea stage 4 fixed';
});

check('P5.3', 'a reviewer may only say held or broke with a reproduction', () => {
  run(['attack-receipt-check', 'held']);
  run(['attack-receipt-check', 'broke: node check.js → observed exit 1, expected exit 0']);
  for (const bad of ['I found three issues', 'broke: it is wrong', 'held, but note that', 'HELD']) { let rejected = false; try { run(['attack-receipt-check', bad]); } catch { rejected = true; } if (!rejected) throw new Error(`accepted: ${bad}`); }
  return '2 valid shapes accepted, 4 prose shapes rejected';
});

check('S3.7', 'the look: rubric, bar, screenshots', () => {
  run(['rubric-check']);
  const good = 'scores: hierarchy=4 spacing=4 type=5 color=4 components=4 states=4 alignment=4 polish=4 responsive=4 copy=5';
  run(['look-score', 'premium', good, good, good]);
  let out = ''; try { run(['look-score', 'premium', good, good, 'scores: hierarchy=4 spacing=2 type=5 color=4 components=4 states=2 alignment=4 polish=4 responsive=4 copy=5 | low: spacing@"x"; states@"y"']); } catch (e) { out = e.stdout || ''; }
  // one low reviewer out of three does not move the median: still held
  if (!/held/.test(out) && out !== '') throw new Error('one low reviewer moved the median');
  try { run(['look-score', 'premium', good, 'scores: hierarchy=4 spacing=3 type=5 color=4 components=4 states=2 alignment=4 polish=4 responsive=4 copy=5 | low: states@"empty list is blank"', 'scores: hierarchy=4 spacing=3 type=4 color=4 components=4 states=2 alignment=4 polish=4 responsive=4 copy=4 | low: states@"no empty state"']); throw new Error('two low reviewers should break'); } catch (e) { if (!/broke: look below the premium bar/.test(e.stdout || '')) throw e; if (!/states=2 \(empty list is blank \/ no empty state\)/.test(e.stdout)) throw new Error('broke line did not name item and regions'); }
  let rejected = false; try { run(['attack-receipt-check', '--look', 'the hierarchy is fine']); } catch { rejected = true; } if (!rejected) throw new Error('prose accepted as a look line');
  let shotsNote = 'screenshots: skipped (no Chrome)';
  try { const page = path.join(os.tmpdir(), 'compass-look-page.html'); run(['idea-page', path.join(ROOT, 'fixtures', 'idea-visual'), '--full', `--out=${page}`]); const o = run(['shots', page, `--out=${path.join(os.tmpdir(), 'compass-shots')}`, '--name=tt']).trim().split('\n'); if (o.length !== 2 || !o.every(f => fs.existsSync(f) && fs.statSync(f).size > 20000)) throw new Error('shots did not produce 2 PNGs'); shotsNote = 'screenshots: phone + desktop PNGs'; } catch (e) { if (!/no Chrome/.test(e.stderr || '')) throw e; }
  if (!fs.existsSync(path.join(ROOT, 'design', 'house-style', 'SYSTEM.md'))) throw new Error('bundled design system missing');
  return `rubric 10×anchors; median holds against one low reviewer; two low → broke with regions; prose rejected; ${shotsNote}; design system bundled`;
});

check('P3.2', 'plan check: 21 sections, scan cited, skeleton first, two-way trace, verify per step', () => {
  const full = path.join(ROOT, 'fixtures', 'plan-full'); run(['plan-check', full]);
  const variants = {
    'a promise with no step': t => t.replace(/\bP1\.3\b/g, 'P1.1'),
    'a step with no promise': t => t.replace(/(S2\.3 [^\n]*?)→ P2\.5/, '$1→'),
    'a fake path in §3': t => { const [a, rest] = t.split(/^## 3\. /m); const [s3, ...after] = rest.split(/^## 4\. /m); return a + '## 3. ' + s3.replace(/`[^`]+`/g, '`nowhere/does-not-exist.js`') + '## 4. ' + after.join('## 4. '); },
    'slice 1 not the skeleton': t => t.replace('### Slice 1 — Skeleton', '### Slice 1 — Setup'),
    'a step with no verify': t => t.replace(/(S1\.2 [^\n]*?)· verify: [^·\n]*/, '$1'),
    'a missing section': t => t.replace(/^## 19\. Runbook[\s\S]*?(?=^## 20\.)/m, ''),
  };
  for (const [name, mutate] of Object.entries(variants)) {
    const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'compass-plan-')); fs.copyFileSync(path.join(full, 'idea.md'), path.join(tmp, 'idea.md'));
    const mutated = mutate(fs.readFileSync(path.join(full, 'plan.md'), 'utf8')); if (mutated === fs.readFileSync(path.join(full, 'plan.md'), 'utf8')) throw new Error(`variant "${name}" did not change the plan`);
    fs.writeFileSync(path.join(tmp, 'plan.md'), mutated);
    let failed = false; try { run(['plan-check', tmp]); } catch { failed = true; } if (!failed) throw new Error(`plan-check accepted ${name}`);
  }
  return `full plan passes; 6 broken variants refused`;
});

check('P3.1', 'plan card fits one screen and names slices, risks, questions', () => {
  const out = run(['plan-card', path.join(ROOT, 'fixtures', 'plan-full')]); const lines = out.trim().split('\n');
  if (lines.length > 40) throw new Error(`${lines.length} lines`);
  for (const must of ['Slices, in order', 'The biggest risks', 'Questions for you', 'Full plan:']) if (!out.includes(must)) throw new Error(`missing "${must}"`);
  return `${lines.length} lines of 40; slices, risks, questions, link`;
});

const { execSync } = require('child_process');
function toyRepo() {
  const t = fs.mkdtempSync(path.join(os.tmpdir(), 'compass-toy-')); const b = path.join(t, '.claude', 'builds', 'till'); fs.mkdirSync(b, { recursive: true }); fs.mkdirSync(path.join(t, 'tests'));
  fs.copyFileSync(path.join(ROOT, 'fixtures', 'idea-visual', 'idea.md'), path.join(b, 'idea.md'));
  fs.writeFileSync(path.join(b, 'plan.md'), '# Plan\n\n### Slice 1 — Skeleton\n- [ ] S1.1 Print the total. → P1.1, P1.2 · verify: `node sales.js` prints total · ≈ 1 h\n- [ ] S1.2 Stock message. → P2.1 · verify: `node stock.js` prints 1 · ≈ 1 h\n');
  fs.writeFileSync(path.join(t, 'sales.js'), 'console.log("total 540")'); fs.writeFileSync(path.join(t, 'stock.js'), 'console.log(1)');
  fs.writeFileSync(path.join(t, 'tests', 'born.test.js'), 'console.log("ok")'); fs.writeFileSync(path.join(t, 'tests', 'stray.test.js'), 'console.log("stray")');
  fs.writeFileSync(path.join(b, 'receipts.md'), '## RECEIPT — idea · till · approved · 2026-10-20T09:00:00Z\n- [x] decision: ok\n## RECEIPT — plan · till · approved · 2026-10-20T10:00:00Z\n- [x] decision: ok\n## RECEIPT — build · till · step S1.1 proven · 2026-10-21T09:00:00Z\n- [x] verify: `node sales.js` → total 540\n## RECEIPT — build · till · fix A1 · 2026-10-21T10:00:00Z\n- [x] check added: tests/born.test.js\n');
  const git = c => execSync(`git -c user.email=t@t -c user.name=t ${c}`, { cwd: t, stdio: 'ignore' });
  git('init -q'); git('add -A'); git('commit -qm toy');
  return { t, b, git };
}

check('P4.3', 'gate suite = promise checks + checks born from breaks, nothing else', () => {
  const { t, b } = toyRepo();
  const list = run(['gates', b], t);
  if (!/promise P1\.1 ← S1\.1/.test(list) || !/break   A1: tests\/born\.test\.js/.test(list)) throw new Error('gate list incomplete');
  if (/stray/.test(list)) throw new Error('a stray test was listed as a gate');
  const out = run(['gates', b, '--run'], t); if (!/3 of 3 gate checks green/.test(out)) throw new Error(out.trim().split('\n').pop());
  return '2 promise checks + 1 break check listed and run; the stray test is not a gate';
});

check('P8.1', 'amend: a supersede line un-proves only that part\'s steps', () => {
  const { t, b } = toyRepo();
  fs.appendFileSync(path.join(b, 'receipts.md'), '## RECEIPT — build · till · step S1.2 proven · 2026-10-21T11:00:00Z\n- [x] verify: ok\n## RECEIPT — amend · till · part 1 edited · 2026-10-22T09:00:00Z\n- [x] decision: total now excludes voids\n- [x] supersede: S1.1\n');
  const st = JSON.parse(run(['state', b, '--json'], t));
  if (st.steps.next !== 'S1.1' || st.steps.proven !== 1) throw new Error(`next ${st.steps.next}, proven ${st.steps.proven}`);
  if (st.promises.find(p => p.id === 'P2.1').state !== 'built') throw new Error('the other part lost its state');
  return 'S1.1 un-proved and next; S1.2 and part 2 untouched';
});

check('P6.3', 'pre-flight: restore point, config keys, secret scan', () => {
  const { t, b, git } = toyRepo();
  fs.writeFileSync(path.join(t, '.env.example'), 'TILL_PATH=\nSHOP_TOKEN=\n'); fs.writeFileSync(path.join(t, 'leak.js'), 'const token = "sk-abcdefghijklmnopqrstuvwxyz0123";\n'); git('add -A'); git('commit -qm leak');
  let out = ''; try { run(['preflight', b], t); throw new Error('pre-flight passed with a planted secret and a missing key'); } catch (e) { out = e.stdout || ''; if (!/secret scan: 1 hit/.test(out) || !/missing here: TILL_PATH, SHOP_TOKEN|missing here: SHOP_TOKEN, TILL_PATH/.test(out) && !/are missing here/.test(out)) throw new Error('pre-flight did not name the secret and the keys: ' + out.trim().split('\n').join(' | ')); }
  fs.unlinkSync(path.join(t, 'leak.js')); git('add -A'); git('commit -qm clean');
  const env = { ...process.env, TILL_PATH: '/tmp', SHOP_TOKEN: 'x' };
  const ok = execFileSync('node', [path.join(ROOT, 'scripts', 'compass'), 'preflight', b], { cwd: t, encoding: 'utf8', env });
  if (!/restore point: tag compass-restore-/.test(ok) || !/pre-flight passed/.test(ok)) throw new Error('clean pre-flight did not pass with a restore tag');
  return 'fails naming the secret and the 2 missing keys; passes clean with a restore tag';
});

check('P6.1', 'write-back puts a live badge beside every promise and the watch date on the card', () => {
  const { t, b } = toyRepo();
  run(['writeback', b, 'P1.1=7 s ✓', 'P1.2=₹0 ✓', 'P2.1=2 messages ✗', '--watch-until=2026-11-02'], t);
  const page = fs.readFileSync(path.join(b, 'idea-page.html'), 'utf8');
  if ((page.match(/class="live/g) || []).length !== 3 || !/live: 2 messages ✗/.test(page)) throw new Error('live badges missing or ✗ hidden');
  const st = JSON.parse(run(['state', b, '--json'], t)); if (st.watch !== '2026-11-02' || !/watch period until 2026-11-02/.test(st.line)) throw new Error('watch date not in state');
  const note = run(['release-note', b], t); if (note.split(/\s+/).length > 200 || !/live: ₹0 ✓/.test(note) || !/Watch period until 2026-11-02/.test(note)) throw new Error('release note wrong');
  return '3 badges incl. one ✗; watch date in state and note; note under 200 words';
});

check('P4.4', 'plan check refuses a step over one sitting', () => {
  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'compass-est-')); fs.copyFileSync(path.join(ROOT, 'fixtures', 'plan-full', 'idea.md'), path.join(tmp, 'idea.md'));
  fs.writeFileSync(path.join(tmp, 'plan.md'), fs.readFileSync(path.join(ROOT, 'fixtures', 'plan-full', 'plan.md'), 'utf8').replace(/(S1\.2 [^\n]*?)≈ 2 h/, '$1≈ 9 h'));
  let out = ''; try { run(['plan-check', tmp]); throw new Error('a 9 h step passed'); } catch (e) { out = e.stdout || ''; if (!/S1\.2 is estimated at 9 h/.test(out)) throw e; }
  return 'a 9 h step is refused with the split instruction';
});

check('S8.1', 'core instruction text under 10,000 words', () => {
  let words = 0;
  const walk = d => { for (const n of fs.readdirSync(d)) { const p = path.join(d, n); if (fs.statSync(p).isDirectory()) walk(p); else if (p.endsWith('.md')) words += fs.readFileSync(p, 'utf8').split(/\s+/).filter(Boolean).length; } };
  for (const d of ['skills', 'shared']) if (fs.existsSync(path.join(ROOT, d))) walk(path.join(ROOT, d));
  if (words > 10000) throw new Error(`${words} words`);
  return `${words} words of 10,000`;
});

for (const [id, name, r, d] of results) console.log(`${r === 'green' ? '✓' : '✗'} ${id.padEnd(5)} ${name} — ${d}`);
const red = results.filter(r => r[2] === 'RED').length;
console.log(`\n${results.length - red} of ${results.length} checks green`);
process.exit(red ? 1 : 0);
