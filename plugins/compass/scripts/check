  // V7, V19: a proof runs the product; a file tool, a printf answer or a pipe that hides the exit is refused
  { const o = toyRepo(); const plan = read(P(o)); for (const [cmd, step] of [['nl check.js', 'S1.2'], ['more check.js', 'S1.2'], ['xxd check.js', 'S1.2'], ['dd if=check.js', 'S1.2'], ['git show HEAD:check.js', 'S1.2'], ['cd tests && echo ok', 'S1.2'], ['node --check sales.js && echo total 540', 'S1.1'], ["test -f sales.js && printf 'total %d' 540", 'S1.1']]) { fs.writeFileSync(P(o), plan); toyPlan(o, cmd, step); want(`V7 \`${cmd}\``, /starts with|names its own answer|ends with printf|never runs the product/, R(o.b, 'build', `step ${step} proven`, 'x')); }
