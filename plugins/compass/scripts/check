    fs.appendFileSync(path.join(b, 'receipts.md'), '## RECEIPT — build · till · step S1.2 proven · 2026-10-21T09:10:00Z\n- [x] verify: test -d / && echo ok → ok\n'); run(['receipt', b, 'build', 'step S2.1 proven', 'x'], t);
