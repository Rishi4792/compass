  { const o = twoBreaks(); want('V12', /never recorded/, R(o.b, 'build', `second break at ${o.r1.id}`, 'answered: try once more')); want('V12 (attempt 3)', /try once more/, R(o.b, 'attack', `${o.r1.id} P1.2 attempt 3 held`, `class: ${o.r1.key}`)); ok(o.b, 'build', `second break at ${o.r1.id}`, ASKB);
