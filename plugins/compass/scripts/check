check('P5.1', 'attacks: conformance forced for parts with a mock or sketch, load for timed promises, product classes at the last part, ids by promise', () => {
  const cat = read(path.join(ROOT, 'shared', 'failure-catalogue.md')); const n = (cat.match(/^## [a-z-]+$/gm) || []).length; if (n !== 21) throw new Error(`${n} classes, expected 21 (13 build + 4 idea + 4 plan)`);
  if (!/mocks\/part-<n>\.html/.test(cat) || !/Tolerance:/.test(cat)) throw new Error('conformance recipe lacks the mock path or tolerance');
  const av = tmpdir('compass-attacks-'); for (const f of ['idea.md', 'spec.md', 'attacks.md']) fs.copyFileSync(F('idea-visual/' + f), path.join(av, f));
  const a = run(['attacks', av, 'build', '--json']); const rows = JSON.parse(a.slice(a.indexOf('[')));
  if (a !== run(['attacks', av, 'build', '--json'])) throw new Error('not deterministic');
  const pm = rows.filter(r => r.key === 'picture-mismatch'); if (pm.length !== 1 || !pm.every(r => /^P1\./.test(r.promise))) throw new Error(`picture-mismatch rows: ${pm.map(r => r.promise).join(',')}`);
  if (rows.some(r => r.key === 'load' && r.promise === 'P1.1')) throw new Error('a time phrase alone ("within 10 seconds") forced a load row; only a named volume does');
  if (!rows.filter(r => r.promise === 'all').every(r => r.when === 'last part')) throw new Error('product rows not at the last part');
  for (const st of ['idea', 'plan']) { const o = run(['attacks', F('idea-data'), st, '--json']); if (JSON.parse(o.slice(o.indexOf('['))).length !== 4) throw new Error(`${st}: not 4 fixed attacks`); }
  const md = read(F('idea-visual/attacks.md')); if (!/\| State \|/.test(md)) throw new Error('no state column');
  const { t, b } = toyRepo();
  for (const bad of [['A3 P1.1 held', 'class: x'], ['A99 P9.9 attempt 1 held', 'class: x'], ['A2 P1.2 attempt 2 held', 'class: x'], ['A2 P1.2 attempt 1 broke', 'class: x']]) if (!fails(['receipt', b, 'attack', ...bad], t)) throw new Error(`attack receipt accepted: ${bad[0]}`);
  if (!fails(['receipt', b, 'attack', 'A2 P1.2 attempt 1 held'], t)) throw new Error('attack receipt without a class accepted');
  run(['receipt', b, 'attack', 'L1 P1.1 attempt 1 held', 'class: look'], t); if (!fails(['receipt', b, 'attack', 'L2 P2.1 attempt 1 held', 'class: look'], t)) throw new Error('a look receipt for a part with no screen was accepted');
  run(['receipt', b, 'build', 'step S1.2 proven', 'x'], t); const r1 = read(path.join(b, 'attacks.md')).match(/^\|\s*(A\d+)\s*\|\s*P1\.2\s*\|\s*(\S+)/m); run(['receipt', b, 'attack', `${r1[1]} P1.2 attempt 1 broke`, `class: ${r1[2]}`, 'reproduction: node check.js → observed x, expected y'], t); run(['receipt', b, 'build', `fix ${r1[1]}`, 'check added: tests/born.test.js', 'red: node tests/born.test.js → FAIL'], t); run(['receipt', b, 'attack', `${r1[1]} P1.2 attempt 2 broke`, `class: ${r1[2]}`, 'reproduction: node check.js → observed x2, expected y'], t); if (!fails(['receipt', b, 'attack', `${r1[1]} P1.2 attempt 2 resolved`], t)) throw new Error('resolved accepted without the person\'s yes and a leftover note'); run(['receipt', b, 'attack', `${r1[1]} P1.2 attempt 2 resolved`, 'answered: move on', 'leftover: broke twice; fixed'], t); if (JSON.parse(run(['state', b, '--json'], t)).promises.find(p => p.id === 'P1.2').plain !== 'broke twice and was set aside') throw new Error('a resolved attack is not shown as set aside');
  const stt = JSON.parse(run(['state', b, '--json'], t)); if (!stt.attacks.find(a => a.key === `${r1[1]} P1.2` && a.resolved)) throw new Error('resolved receipt was refused or ignored');
  return '21 classes; conformance forced on the screen part; load forced on a timed promise; product rows last; idea/plan 4 each; state column; malformed, unknown, out-of-order and class-less attack receipts refused';
});

