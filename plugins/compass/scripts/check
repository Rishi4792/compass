check('P3.2', 'plan check: 21 sections, real path, skeleton, two-way trace, command + expected per step, spec and runbook, ≤6 h', () => {
  const full = F('plan-full'); run(['plan-check', full]);
  const variants = { 'a promise with no step': t => t.replace(/\bP1\.3\b/g, 'P1.1'), 'a step with no promise': t => t.replace(/(S2\.3 [^\n]*?)→ P2\.5/, '$1→'), 'a fake path in §3': t => { const [a, rest] = t.split(/^## 3\. /m); const [s3, ...after] = rest.split(/^## 4\. /m); return a + '## 3. ' + s3.replace(/`[^`]+`/g, '`nowhere/none.js`') + '## 4. ' + after.join('## 4. '); }, 'slice 1 not the skeleton': t => t.replace('### Slice 1 — Skeleton', '### Slice 1 — Setup'), 'a verify without expected': t => t.replace(/(S1\.2 [^\n]*?)` → [^·\n]*/, '$1`'), 'a missing section': t => t.replace(/^## 19\. Runbook[\s\S]*?(?=^## 20\.)/m, ''), 'a 9 h step': t => t.replace(/(S1\.2 [^\n]*?)≈ 2 h/, '$1≈ 9 h') };
  const expectMsg = { 'a promise with no step': /P1\.3 has no step/, 'a step with no promise': /S2\.3 serves no promise/, 'a fake path in §3': /§3 cites no path/, 'slice 1 not the skeleton': /must be the walking skeleton/, 'a verify without expected': /S1\.2: verify needs/, 'a missing section': /section 19 \(Runbook\) missing/, 'a 9 h step': /S1\.2 is estimated at 9 h/ };
  for (const [name, mutate] of Object.entries(variants)) { const root = tmpdir('compass-plan-'); const tmp = path.join(root, '.claude', 'builds', 'x'); fs.mkdirSync(tmp, { recursive: true }); fs.mkdirSync(path.join(root, 'compass', 'scripts'), { recursive: true }); fs.mkdirSync(path.join(root, 'compass', 'templates')); fs.writeFileSync(path.join(root, 'compass', 'scripts', 'compass'), ''); fs.writeFileSync(path.join(root, 'compass', 'templates', 'card.html'), ''); for (const n of ['idea.md', 'spec.md']) fs.copyFileSync(path.join(full, n), path.join(tmp, n)); const m = mutate(read(path.join(full, 'plan.md'))); if (m === read(path.join(full, 'plan.md'))) throw new Error(`variant "${name}" changed nothing`); fs.writeFileSync(path.join(tmp, 'plan.md'), m); const out = fails(['plan-check', tmp]) || ''; if (!out) throw new Error(`plan-check accepted ${name}`); if (!expectMsg[name].test(out)) throw new Error(`${name}: refused for the wrong reason: ${out.trim().split('\n')[0]}`); }
  const card = run(['plan-card', full]); if (card.split('\n').length > 40 || /\/Users\//.test(card) || /slice/i.test(card) || !/The biggest risks/.test(card)) throw new Error('plan card too long, shows a path, or says slice');
  return 'full plan passes; 7 broken variants refused; card ≤40 lines with no path';
});

