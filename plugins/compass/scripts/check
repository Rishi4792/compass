});

check('S9.5', 'round 7: the door routes on one word, a finished part with open attacks reads Testing, a stale page cannot be drafted, the release note and the Idea page read plainly', () => {
  const ask = '[ ] ask: Approve? · Yes (Recommended) → go · No → stop';
  for (const [fx, want] of [['idea-visual', 'idea'], ['plan-approved', 'build'], ['live', 'live']]) { const r = run(['state', F(fx), '--route']).trim(); if (r !== want) throw new Error(`${fx} routes to ${r}, not ${want}`); }
  { const e = tmpdir('compass-route-'); if (run(['state', 'auto', '--route'], e).trim() !== 'none') throw new Error('an empty folder does not route to none'); const j = JSON.parse(run(['state', 'auto', '--json'], e)); if (j.route !== 'none' || j.ask !== null) throw new Error('state --json with no build is not plain JSON'); }
  { const { t, b } = toyRepo(); run(['receipt', b, 'build', 'step S1.2 proven', 'x'], t); const line = run(['state', b], t); if (!/^Testing · Part 1, /.test(line)) throw new Error('a finished part with open attacks did not read Testing: ' + line); if (run(['state', b, '--route'], t).trim() !== 'build') throw new Error('Testing does not route to build');
    const note = run(['release-note', b], t).catch ? '' : ''; }
  { const d = tmpdir('compass-stale-'); for (const f of ['idea.md', 'spec.md']) fs.copyFileSync(F('idea-visual/' + f), path.join(d, f)); fs.mkdirSync(path.join(d, 'pictures')); fs.copyFileSync(F('idea-visual/pictures/sketch-1.svg'), path.join(d, 'pictures', 'sketch-1.svg'));
    for (let k = 1; k <= 11; k++) run(['answer', d, 'question', String(k), '11']); const out = run(['answer', d, 'set', 'done', '0 wrong totals in 14 days']); if (/needs a mock/.test(out)) throw new Error('answer nags for a mock before approval');
    const rows = JSON.parse(run(['attacks', d, 'idea', '--json']).replace(/^[^[]*/, '')); for (const r of rows) run(['receipt', d, 'attack', `${r.id} page attempt 1 held`, `class: ${r.key}`]);
    run(['answer', d, 'set', 'purpose', 'A different purpose, so the page changed']); if (!/not closed on this version of the page/.test(fails(['receipt', d, 'idea', 'drafted', ask]) || '')) throw new Error('a changed page was drafted on stale attacks');
    for (const r of rows) run(['receipt', d, 'attack', `${r.id} page attempt 1 held`, `class: ${r.key}`]); run(['receipt', d, 'idea', 'drafted', ask]);
    run(['answer', d, 'open', 'When does the count reset? → every night at midnight']); const html = read(path.join(d, 'idea-page.html')); if (!/Settled along the way/.test(html) || !/every night at midnight/.test(html)) throw new Error('the Idea page does not show the settled questions');
    const build = JSON.parse(run(['attacks', d, 'build', '--json']).replace(/^[^[]*/, '')); if (build.some(r => r.promise === 'all' && r.key === 'load')) throw new Error('a whole-product load row was chosen with no volume named'); }
  { const { t, b } = toyRepo(); fs.writeFileSync(path.join(b, 'plan.md'), read(path.join(b, 'plan.md')).replace(/## 19\. Runbook[\s\S]*$/, '## 19. Runbook\nRun: node sales.js\nTotal missing → check till.csv exists\n')); const note = run(['release-note', b], t); if (/\(live: /.test(note)) throw new Error('the release note prints raw live values'); if (/Not included, by design/.test(note)) throw new Error('Never lines are listed as exclusions'); }
  return 'route words for fixtures and an empty folder; Testing · Part 1 with open rows; a stale page is refused until its attacks run again; no mock nag before approval; settled questions on the page; no load row without a volume; the release note reads plainly';
});

check('S9.6', 'round 8: the confirmation QA findings (V1–V31): the last gate run decides and names its commit, an answer uses its question up, a value cannot add page structure, attack ids stay stable', () => {
  const ASK = (q, a = 'Yes (Recommended) → I go on', n = 'Not yet → nothing happens') => `[ ] ask: ${q} · ${a} · ${n}`;
  const ASKI = ASK('Approve the Idea page?'), ASKL = ASK('Do the screens look right?'), ASKP = ASK('Approve the plan?'), ASK3 = ASK('Accept what was set aside?', 'Accept (Recommended) → it ships as it is', 'No → I keep fixing it'), ASK4 = ASK('Make Till live for real users now?'), ASKB = ASK('Part 1 broke twice. What now?', 'Move on, note it (Recommended) → it ships', 'Try once more and show me → one more fresh test');
  const P11 = "--promise=P1.1 See today's total within 10 seconds of opening. → under 10 s", P12 = '--promise=P1.2 The total matches the till to the rupee. → ₹0 difference', P12x = '--promise=P1.2 The total matches the till to the rupee. → ₹500 difference';
  const rootOf = b => path.resolve(b, '..', '..', '..'); const ok = (b, ...a) => run(['receipt', b, ...a], rootOf(b)); const R = (b, ...a) => fails(['receipt', b, ...a], rootOf(b));
  const last = out => out.trim().split('\n').filter(Boolean).pop().slice(0, 170); const want = (id, re, out) => { if (!out || !re.test(out)) throw new Error(`${id}: ${out ? 'refused for another reason: ' + last(out) : 'accepted'}`); }; const accept = (id, out) => { if (out) throw new Error(`${id}: refused: ${last(out)}`); };
  const sub = (f, from, to) => { const x = read(f); if (!x.includes(from)) throw new Error(`S9.6 setup: "${from}" not in ${path.basename(f)}`); fs.writeFileSync(f, x.replace(from, to)); };
  const P = o => path.join(o.b, 'plan.md'), I = o => path.join(o.b, 'idea.md'); const gitIn = (t, c) => execSync(`git -c user.email=t@t -c user.name=t -c tag.gpgsign=false -c commit.gpgsign=false ${c}`, { cwd: t, stdio: 'ignore' });
  const ymd = d => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`; const tomorrow = ymd(new Date(Date.now() + 86400000));
  const files = () => { const t = tmpdir('compass-s96-'); const b = path.join(t, '.claude', 'builds', 'till'); fs.mkdirSync(path.join(b, 'pictures'), { recursive: true }); fs.mkdirSync(path.join(t, 'tests'));
