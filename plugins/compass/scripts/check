check('P8.1', 'amend: supersede is bounded to the part, resets its attacks, bumps the version', () => {
  const { t, b } = toyRepo(); run(['receipt', b, 'build', 'step S1.2 proven', 'verify: node check.js → ok'], t); run(['receipt', b, 'build', 'step S2.1 proven', 'verify: node stock.js → 1 message'], t);
  const row = read(path.join(b, 'attacks.md')).match(/^\|\s*(A\d+)\s*\|\s*P1\.1\s*\|\s*(\S+)/m); run(['receipt', b, 'attack', `${row[1]} P1.1 attempt 1 held`, `class: ${row[2]}`], t);
  if (!fails(['receipt', b, 'amend', 'part 2 edited', 'decision: x', 'supersede: S1.1'], t)) throw new Error('an amend of part 2 superseded a part-1 step');
  if (!fails(['receipt', b, 'amend', 'part 1 edited', 'supersede: S1.1'], t)) throw new Error('an amend without a decision was accepted');
  run(['receipt', b, 'build', 'change asked', CHANGE_ASK], t); run(['receipt', b, 'amend', 'part 1 edited', 'decision: total excludes voids', 'supersede: S1.1', 'answered: change the page'], t);
  const st = JSON.parse(run(['state', b, '--json'], t)); const p11 = st.promises.find(p => p.id === 'P1.1');
  if (st.steps.next !== 'S1.1' || p11.state !== 'planned' || st.promises.find(p => p.id === 'P2.1').state !== 'built' || st.version !== 2) throw new Error(`next ${st.steps.next}, P1.1 ${p11.state}, v${st.version}`);
  run(['attacks', b, 'build'], t); if (new RegExp(`${row[1]} \\| P1\\.1[^\\n]*attempt 1 held`).test(read(path.join(b, 'attacks.md')))) throw new Error('attacks.md still shows a superseded attack as held');
  // ids stay stable when a promise is removed through answer
  const a = tmpdir('compass-ids-'); run(['answer', a, 'part', '1', '--title=T', '--picture=box', '--prose=p', '--promise=First one → 1', '--promise=Second one → 2'], a);
  run(['answer', a, 'part', '1', '--promise=Second one → 2'], a); const id = read(path.join(a, 'idea.md')).match(/- (P1\.\d) Second one/)[1]; if (id !== 'P1.2') throw new Error(`id renumbered to ${id}`);
  if (!/starts with "-"/.test(fails(['answer', a, 'part', '1', '--prose=- a line that starts with a dash'], a) || '')) throw new Error('a prose line that starts with a dash was accepted; the page would read it as a list line or a promise'); run(['answer', a, 'set', 'purpose', 'x', '--verbose'], a); const txt = read(path.join(a, 'idea.md')); if (/a line that starts with a dash/.test(txt) || /purpose: x --verbose/.test(txt)) throw new Error('a refused dash line was written, or a flag written into a value');
  return 'cross-part supersede refused; decision required; P1.1 reset; attacks.md reset; part 2 untouched; v2; ids stable; a value that starts with a dash refused; flags stripped';
});

