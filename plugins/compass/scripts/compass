#!/usr/bin/env node
'use strict';
// compass — the one script. No dependencies.
// Status is a pure function of three files in a build folder: idea.md, plan.md, receipts.md. Nothing else is read for state.
// Verbs: state · line · card · receipt · answer · idea-page · spec-check · plan-check · plan-card · attacks ·
//        attack-receipt-check · shots · look-score · rubric-check · gates · part-line · preflight · writeback · release-note

const fs = require('fs');
const path = require('path'); const crypto = require('crypto');
const os = require('os');
const { execSync, execFileSync } = require('child_process');

const PLUGIN_ROOT = path.resolve(__dirname, '..');
const D = '[—–-]'; // any dash a person or an editor might type
const read = p => { try { return fs.readFileSync(p, 'utf8'); } catch { return ''; } };
const lines = t => t.split(/\r?\n/);
const esc = s => String(s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
const day = ts => { const d = new Date(ts); return isNaN(d) ? ts : d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }); };
const today = () => { const d = new Date(); return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`; }; // the person's own calendar date, not UTC
const die = (m, code = 1) => { console.error(m); process.exit(code); };
const repoOf = dir => path.resolve(dir, '..', '..', '..'); // .claude/builds/<slug> → the project root
const STEP = 'S\\d+\\.\\d+[a-z]?';
const PLAIN = { planned: 'not built yet', building: 'being built', built: 'built and not yet tested', held: 'tested and passed', fixed: 'broke once and is fixed', 'set aside': 'broke twice and was set aside', broke: 'broke and is being fixed', 'needs you': 'needs you', live: 'live ✓', 'live ✗': 'live ✗' };
const YES = /^answered:\s*(yes|accept|accepted|approve|approved|go|go live|ship|release|move on|looks right|build it as written|build as written|as written)\s*[.!]?$/i;
const ASK_FOR = { 'idea approved': ['drafted'], 'idea look approved': ['look ready'], 'plan approved': ['drafted', 'revised'], 'build gate 3': ['gate 3'], 'deploy gate 4': ['gate 4'] };
const AMEND_NO = /^answered:\s*(no|keep|as written|build it as written|build as written|not yet|stop|cancel)\b/i; // the person kept the page
const RECORD_IDS = /\b(?:[SPQ]\d+\.\d+[a-z]?|Q\d+|[AL]\d+\s+(?:P\d+\.\d+|all|page|plan)|L\d+)\b/i; // ids the person never reads; a bare "A4" is paper
const BUILDER_WORDS = /\b(slices?|receipts?|pre-?flights?|canar(?:y|ies)|rollbacks?|writebacks?|redeploy\w*|supersed\w*|gates?|specs?|deploy\w*|skeletons?|verif(?:y|ied|ies)|drift\w*|invariants?)\b|\b[\w.-]+\.(?:md|js|mjs|cjs|ts|json|html|css|sh|py|ya?ml)\b/i;
const PAGE_WORDS = /\b(slices?|skeletons?|receipts?|pre-?flights?|canar(?:y|ies)|rollbacks?|step ids?|promise ids?)\b/i; // words the Idea page may not use; the person reads it // words a decision: or leftover: line may not use
const KNOWN_RESULT = new RegExp(`^(step ${STEP} proven|gate [34]|gates (green|red)|preflight|rehearsal|released|writeback|drafted|approved|revised|look ready|look approved|fix [AL]\\d+.*|part \\d+ edited|[AL]\\d+ (P\\d+\\.\\d+|all|page|plan) attempt \\d (held|broke|resolved)|question \\d+ of \\d+.*|second break at [AL]\\d+|drift stop at ${STEP}|drift answered|switch proven|release note)$`);
const QUESTIONS = 11; const SKIPPABLE = [5, 9, 11];
const askedBefore = (receipts, before, stage, results) => receipts.some(q => q.idx < before && q.stage === stage && results.includes(q.result) && q.lines.some(l => !l.done && /^ask:/.test(l.text)));
const approvedBy = (receipts, r) => { const asks = ASK_FOR[`${r.stage} ${r.result}`]; return !!asks && r.lines.filter(l => /^answered:/.test(l.text)).length === 1 && answeredYes(r) && askedBefore(receipts, r.idx, r.stage, asks); };
const sha = s => crypto.createHash('sha1').update(s).digest('hex').slice(0, 12); const stepPin = s => sha([s.id, s.promises.join(','), s.verify.cmd, s.verify.expected].join('|'));
const pinOf = (dir, what) => { if (what === 'plan') return sha(parsePlan(read(path.join(dir, 'plan.md'))).steps.map(s => [s.id, s.promises.join(','), s.verify.cmd, s.verify.expected].join('|')).join('\n')); const i = parseIdea(read(path.join(dir, 'idea.md'))); return sha([i.look || '', ...i.promises.map(p => [p.id, p.text, p.number].join('|'))].join('\n')); };
// v2 pins (written as "v2:<hash>"; a bare hash is read with the old formula above). The plan pin covers each step's whole line;
// the idea pin covers the whole page as parsed, except the page:/card: links and the mock:/sketch: lines, which the look pin covers.
const stepPin2 = s => sha([s.id, s.text, s.promises.join(','), s.verify.cmd, s.verify.expected, s.estimate == null ? '' : s.estimate].join('|'));
const planPin2 = dir => sha(parsePlan(read(path.join(dir, 'plan.md'))).steps.map(stepPin2).join('\n'));
const ideaPin2 = dir => { const i = parseIdea(read(path.join(dir, 'idea.md'))); return sha(serializeIdea({ ...i, page: '', card: '', parts: i.parts.map(p => ({ ...p, mock: '', sketch: '' })) })); };
const lookPinOf = dir => { const i = parseIdea(read(path.join(dir, 'idea.md'))); return sha(i.parts.map(p => [p.n, p.mock, p.sketch, p.mock ? read(path.join(dir, p.mock)) : '', p.sketch ? read(path.join(dir, p.sketch)) : ''].join('|')).join('\n')); };
const specPinOf = dir => sha(read(path.join(dir, 'spec.md')));
const attackedPin = (dir, kind) => (kind === 'page' ? `v2:${ideaPin2(dir)}` : `v2:${planPin2(dir)}+${specPinOf(dir)}`); // the version a page or plan attack ran on
const promisePin = p => `${sha(p.text).slice(0, 8)}.${sha(`${p.text}|${p.number}`).slice(0, 8)}`; // text part . text+number part
const planStepsLine = dir => { const steps = parsePlan(read(path.join(dir, 'plan.md'))).steps; return steps.length ? `v2 ${steps.map(s => `${s.id}=${stepPin2(s)}@${s.promises.join(',')}`).join(' ')}` : '0'; };
const stepPinMatches = (s, pin) => (/^v2:/.test(pin) ? `v2:${stepPin2(s)}` : stepPin(s)) === pin;
const samePath = (a, b) => { const r = p => { try { return fs.realpathSync(p); } catch { return path.resolve(p); } }; return r(a) === r(b); };
const answeredOnceYes = r => { const a = r.lines.filter(l => /^answered:/.test(l.text)); return a.length === 1 && YES.test(a[0].text); };
const leftoverItems = receipts => receipts.flatMap(r => r.lines.filter(l => /^leftover:/.test(l.text)).map(() => ({ idx: r.idx, accepted: r.stage === 'attack' && /\sattempt\s+[23]\s+resolved$/.test(r.result) && answeredOnceYes(r) })));
const isChange = r => (r.stage === 'build' && (new RegExp(`^step\\s+${STEP}\\s+proven$`).test(r.result) || /^fix\s+(A|L)\d+/.test(r.result))) || (r.stage === 'plan' && r.result === 'revised') || (r.stage === 'amend' && /^part\s+\d+\s+edited$/.test(r.result)) || r.stage === 'attack';
const lastIdx = (receipts, pred) => receipts.reduce((a, r) => (pred(r) ? r.idx : a), -1);
const hasAsk = r => r.lines.some(l => !l.done && /^ask:/.test(l.text));
// a question line: the options are the trailing " · " segments that hold "→"; the segments before them are the question (it may quote a line with " · ")
function splitAsk(text) { const segs = String(text).split(' · '); let k = segs.length; while (k > 0 && segs[k - 1].includes('→')) k--; return { question: segs.slice(0, k).join(' · ').trim(), options: segs.slice(k).map(s => { const at = s.indexOf('→'); return { label: s.slice(0, at).trim(), consequence: s.slice(at + 1).trim(), arrows: s.split('→').length - 1 }; }) }; }
const askLineOf = r => { const l = r && r.lines.find(x => !x.done && /^ask:/.test(x.text)); return l ? l.text.replace(/^ask:\s*/, '') : ''; };
const normLabel = s => String(s).replace(/\(recommended\)/ig, '').replace(/^answered:\s*/i, '').replace(/[.!]+\s*$/, '').replace(/\s+/g, ' ').trim().toLowerCase();
const STAY = /^\s*(keep|pause|not yet)\b|^\s*leave\b(?!.*\bout\b)|\bas written\b/i; // an option that keeps the page as it is: it starts with keep, pause, not yet or leave, or says "as written" ("Leave this promise out" and "Part 2, Keep stock low" change it)
const isAmendEdit = r => r.stage === 'amend' && /^part\s+\d+\s+edited$/.test(r.result);
const hasAnswer = r => r.lines.some(l => /^answered:/.test(l.text));
// the latest ask of a kind; open = no answer of its kind after it and no amend after it (an answer, yes or no, uses the question up)
function openAsk(receipts, isAsk, isAnswer) { const q = [...receipts].reverse().find(r => isAsk(r) && hasAsk(r)); if (!q) return null; return { q, answered: receipts.some(r => r.idx > q.idx && isAnswer(r) && hasAnswer(r)), stale: receipts.some(r => r.idx > q.idx && isAmendEdit(r)) }; }
// a change question after the last look approval reopens the look (an amend redoes a screen)
const lookReopened = receipts => { const la = lastIdx(receipts, q => q.stage === 'idea' && q.result === 'look approved'); return receipts.some(q => q.idx > la && (q.stage === 'build' || q.stage === 'amend') && q.result === 'change asked' && hasAsk(q)); };
const realOr = p => { try { return fs.realpathSync(p); } catch { return path.resolve(p); } };
const insideDir = (dir, rel) => { if (!rel || path.isAbsolute(rel)) return false; const base = realOr(dir); const abs = path.resolve(base, rel); const real = fs.existsSync(abs) ? realOr(abs) : abs; return real.startsWith(base + path.sep); };
const gitOut = (cwd, args, raw) => { try { const o = execFileSync('git', args, { cwd, encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }); return raw ? o : o.trim(); } catch { return null; } };
const gitHead = cwd => (gitOut(cwd, ['rev-parse', '--is-inside-work-tree']) === 'true' && gitOut(cwd, ['rev-parse', 'HEAD'])) || 'none';
const treeState = cwd => { if (gitHead(cwd) === 'none') return 'clean'; const s = gitOut(cwd, ['status', '--porcelain', '--untracked-files=no'], true); if (s === null) return 'dirty'; return s.split('\n').filter(l => l.trim() && !/(^|[\s/"])\.claude\//.test(l.slice(3))).length ? 'dirty' : 'clean'; }; // tracked files only, Compass's own record left out
const verifyCmdOf = r => { const l = r.lines.find(x => /^verify:/.test(x.text)); if (!l) return null; const t = l.text.replace(/^verify:\s*/, ''); const at = t.indexOf(' → '); return (at < 0 ? t : t.slice(0, at)).replace(/^`|`$/g, '').trim(); };
// steps whose standing proof was recorded before 1.0.6 (no "step-pin: v2:") keep the rules they were proven under, but only while the command is the one
// on that proof's verify: line, or the one a per-step plan pin recorded after that proof still matches; a changed command gets the new rules
function legacyProofs(dir) {
  const receipts = parseReceipts(read(path.join(dir, 'receipts.md'))); const plan = parsePlan(read(path.join(dir, 'plan.md'))); const m = new Map(); let x;
  for (const r of receipts) { if (r.stage === 'build' && (x = r.result.match(new RegExp(`^step\\s+(${STEP})\\s+proven$`)))) m.set(x[1], { legacy: !r.lines.some(l => /^step-pin:\s*v2:/.test(l.text)), cmd: verifyCmdOf(r), idx: r.idx }); if (r.stage === 'amend') for (const l of r.lines) { const s = l.text.match(/^supersede:\s*(.+)$/); if (s) for (const id of s[1].split(/[\s,]+/).filter(Boolean)) { m.delete(id); for (const st of plan.steps) if (st.promises.includes(id)) m.delete(st.id); } } }
  const pinAfter = (id, idx) => { let pin = null, v2 = false; for (const r of receipts) { if (r.idx <= idx) continue; for (const l of r.lines) { const pm = l.text.match(/^plan-steps:\s*(.+?)\s*$/); if (!pm || /^\d+$/.test(pm[1])) continue; const e = pm[1].split(/\s+/).find(t => t.startsWith(`${id}=`)); if (e) { pin = e.split('=')[1].split('@')[0]; v2 = /^v2(\s|$)/.test(pm[1]); } } } return pin && { pin, v2 }; };
  const out = new Set(); for (const [id, p] of m) { if (!p.legacy) continue; const s = plan.steps.find(z => z.id === id); if (!s) continue; const pa = pinAfter(id, p.idx); if ((p.cmd && p.cmd === s.verify.cmd) || (pa && (pa.v2 ? stepPin2(s) : stepPin(s)) === pa.pin)) out.add(id); }
  return out;
}
function provenIds(receipts, plan) { const p = new Set(); let x; for (const r of receipts) { if (r.stage === 'build' && (x = r.result.match(new RegExp(`^step\\s+(${STEP})\\s+proven$`)))) p.add(x[1]); if (r.stage === 'amend') for (const l of r.lines) { const s = l.text.match(/^supersede:\s*(.+)$/); if (s) for (const id of s[1].split(/[\s,]+/).filter(Boolean)) { p.delete(id); for (const st of plan.steps) if (st.promises.includes(id)) p.delete(st.id); } } } return p; }
// what changed since the pins the person last saw; known = false when the record has no pins (legacy), so nothing can be told
function changesSince(dir, st, plan, idea) {
  const f = st.flags; const out = { known: false, any: false, steps: [], promises: [] };
  if (f.planPin) { out.known = true; if ((/^v2:/.test(f.planPin) ? `v2:${planPin2(dir)}` : pinOf(dir, 'plan')) !== f.planPin) out.any = true; }
  if (f.ideaPin) { out.known = true; if ((/^v2:/.test(f.ideaPin) ? `v2:${ideaPin2(dir)}` : pinOf(dir, 'idea')) !== f.ideaPin) out.any = true; }
  if (f.specPin) { out.known = true; if (specPinOf(dir) !== f.specPin) out.any = true; }
  if (f.lookPin) { out.known = true; if (lookPinOf(dir) !== (f.lookPinBase || f.lookPin)) out.any = true; }
  if (f.planStepPins) { for (const [id, pin] of Object.entries(f.planStepPins)) { const s = plan.steps.find(x => x.id === id); if (!s) out.steps.push({ id, removed: true, promises: (f.planStepPromises || {})[id] || null }); else if ((f.planStepsV2 ? stepPin2(s) : stepPin(s)) !== pin) out.steps.push({ id, promises: s.promises }); } for (const s of plan.steps) if (!(s.id in f.planStepPins)) out.steps.push({ id: s.id, added: true, promises: s.promises }); }
  for (const [id, pin] of Object.entries(f.stepPins || {})) { const s = plan.steps.find(x => x.id === id); if (s && !stepPinMatches(s, pin) && !out.steps.some(x => x.id === id)) out.steps.push({ id, promises: s.promises }); }
  if (f.ideaPromises) { for (const [id, pin] of Object.entries(f.ideaPromises)) { const p = idea.promises.find(x => x.id === id); if (!p) out.promises.push({ id, removed: true }); else if (promisePin(p) !== pin) out.promises.push({ id }); } for (const p of idea.promises) if (!(p.id in f.ideaPromises)) out.promises.push({ id: p.id, added: true }); }
  if (out.steps.length || out.promises.length) out.any = true; return out;
}
function driftOf(dir, st, skip = []) {
  const f = st.flags;
  if (!skip.includes('plan') && f.planPin && (/^v2:/.test(f.planPin) ? `v2:${planPin2(dir)}` : pinOf(dir, 'plan')) !== f.planPin) return 'plan.md changed since the person saw it; record "plan revised" after plan-check (a revision may only add steps), or go through amend';
  if (!skip.includes('idea') && f.ideaPin && (/^v2:/.test(f.ideaPin) ? `v2:${ideaPin2(dir)}` : pinOf(dir, 'idea')) !== f.ideaPin) return 'the Idea page changed since it was approved; changes go through amend';
  if (!skip.includes('spec') && f.specPin && specPinOf(dir) !== f.specPin) return 'spec.md changed since the person saw the plan; changes go through amend';
  if (!skip.includes('look') && f.lookPin && lookPinOf(dir) !== f.lookPin) return 'the approved screens (a mock or sketch file) changed since the person approved them; changes go through amend';
  return null;
}

// ---------- idea.md ----------
const HEAD_KEYS = ['title', 'page', 'card', 'for', 'hurts', 'exists', 'because', 'purpose', 'done', 'look', 'approved'];
function parseIdea(text) {
  const parts = []; const journey = []; const later = [], never = [], open = []; const head = {};
  let cur = null, list = null, inJourney = false, inFence = false;
  for (const line of lines(text)) {
    if (/^```/.test(line)) { inFence = !inFence; if (cur) cur.fence = true; continue; }
    if (inFence) continue;
    const h = line.match(new RegExp(`^###\\s+Part\\s+(\\d+)\\s+${D}\\s+(.+)$`));
    if (h) { cur = { n: +h[1], title: h[2].trim(), picture: '', prose: [], promises: [], sketch: '', mock: '', screen: false, fence: false }; parts.push(cur); list = null; inJourney = false; continue; }
    if (/^##\s+Journey/.test(line)) { inJourney = true; list = null; cur = null; continue; }
    if (/^##\s+Later/.test(line)) { list = later; cur = null; inJourney = false; continue; }
    if (/^##\s+Never/.test(line)) { list = never; cur = null; inJourney = false; continue; }
    if (/^##\s+Open/.test(line)) { list = open; cur = null; inJourney = false; continue; }
    if (/^##?\s/.test(line) && !/^###/.test(line)) { list = null; cur = null; inJourney = false; }
    const kv = line.match(new RegExp(`^(${HEAD_KEYS.join('|')}):\\s*(.*)$`));
    if (kv && !cur && !inJourney) { head[kv[1]] = kv[2].trim(); continue; }
    if (inJourney) { const j = line.match(/^-\s+([\w:./-]+):\s*(.+)$/); if (j) journey.push({ picture: j[1], caption: j[2].trim() }); continue; }
    if (cur) {
      let m;
      if ((m = line.match(/^picture:\s*(\S+)/))) { cur.picture = m[1]; continue; }
      if ((m = line.match(/^sketch:\s*(\S+)/))) { cur.sketch = m[1]; continue; }
      if ((m = line.match(/^mock:\s*(\S+)/))) { cur.mock = m[1]; continue; }
      if (/^screen:\s*yes/i.test(line)) { cur.screen = true; continue; }
      if ((m = line.match(/^-\s+(P\d+\.\d+)\s+(.+)$/))) {
        const body = m[2]; const at = body.lastIndexOf('→');
        cur.promises.push({ id: m[1], part: cur.n, text: (at >= 0 ? body.slice(0, at) : body).trim(), number: at >= 0 ? body.slice(at + 1).trim() : '' }); continue;
      }
      if (line.trim()) cur.prose.push(line.trim()); // a prose line may begin with a dash; only "- P<n>.<n>" is a promise
      continue;
    }
    if (list && /^-\s+/.test(line)) list.push(line.replace(/^-\s+/, '').trim());
  }
  const slug = (text.match(new RegExp(`^#\\s+Idea\\s+${D}\\s+(.+)$`, 'm')) || [, 'build'])[1].trim();
  return { title: head.title || slug, slug, page: head.page || '', card: head.card || '', for: head.for || '', hurts: head.hurts || '', exists: head.exists || '', because: head.because || '',
    purpose: head.purpose || '', done: head.done || '', look: (head.look || '').toLowerCase(), journey, parts, promises: parts.flatMap(p => p.promises), later, never, open };
}
function serializeIdea(i) {
  const out = [`# Idea — ${i.slug}`];
  for (const k of ['title', 'page', 'card', 'for', 'hurts', 'exists', 'because', 'purpose', 'done', 'look']) if (i[k]) out.push(`${k}: ${i[k]}`);
  if (i.journey.length) { out.push('', '## Journey'); for (const j of i.journey) out.push(`- ${j.picture}: ${j.caption}`); }
  for (const p of i.parts) {
    out.push('', `### Part ${p.n} — ${p.title}`); if (p.picture) out.push(`picture: ${p.picture}`); if (p.screen) out.push('screen: yes');
    for (const t of p.prose) out.push(t);
    for (const x of p.promises) out.push(`- ${x.id} ${x.text} → ${x.number}`);
    if (p.mock) out.push(`mock: ${p.mock}`); if (p.sketch) out.push(`sketch: ${p.sketch}`);
  }
  if (i.later.length) { out.push('', '## Later'); for (const x of i.later) out.push(`- ${x}`); }
  if (i.never.length) { out.push('', '## Never'); for (const x of i.never) out.push(`- ${x}`); }
  if ((i.open || []).length) { out.push('', '## Open'); for (const x of i.open) out.push(`- ${x}`); }
  return out.join('\n') + '\n';
}
function lintIdea(dir, idea, opts = {}) { // opts.noLook: the page before gate 1; mocks and sketches are made after it
  const problems = []; const lib = JSON.parse(read(path.join(PLUGIN_ROOT, 'templates', 'pictures.json')));
  const pic = (k, where) => { if (!k) problems.push(`${where}: no picture`); else if (k.startsWith('file:')) { if (!fs.existsSync(path.join(dir, k.slice(5)))) problems.push(`${where}: picture file missing ${k.slice(5)}`); } else if (!lib[k]) problems.push(`${where}: unknown picture key "${k}"`); };
  for (const k of ['title', 'purpose', 'for', 'hurts', 'exists', 'because', 'done']) if (!idea[k]) problems.push(`no ${k}: line`);
  if (idea.exists && idea.exists.split(/\s+·\s+|;\s+/).length < 2) problems.push('exists: must name at least two things used today, separated by " · ", each with where it lets the person down');
  if (idea.done && !/\d/.test(idea.done)) problems.push('done: has no number in it');
  if (idea.done && idea.done.split(/\s+/).length > 25) problems.push(`done: is ${idea.done.split(/\s+/).length} words; one number and a date, under 25 words`);
  if (idea.look && !['premium', 'clean', 'match'].includes(idea.look)) problems.push(`look: must be premium, clean or match (got "${idea.look}")`);
  if (!idea.parts.length) problems.push('no ### Part blocks');
  if (idea.journey.length < 2) problems.push('journey needs at least a first and a last moment (## Journey)');
  idea.journey.forEach((j, i) => pic(j.picture, `journey step ${i + 1}`));
  for (const p of idea.parts) {
    const words = [...p.prose, ...p.promises.map(x => x.text + ' ' + x.number)].join(' ').split(/\s+/).filter(Boolean).length;
    if (words > 150) problems.push(`part ${p.n}: ${words} words, limit 150`);
    pic(p.picture, `part ${p.n}`);
    if (!p.promises.length) problems.push(`part ${p.n}: no promises`);
    const ids = p.promises.map(x => x.id); if (new Set(ids).size !== ids.length) problems.push(`part ${p.n}: duplicate promise ids`);
    for (const x of p.promises) { if (!x.number) problems.push(`${x.id}: no number after →`); else if (!/\d/.test(x.number)) problems.push(`${x.id}: the number "${x.number}" has no digit`); if (!x.id.startsWith(`P${p.n}.`)) problems.push(`${x.id}: id does not belong to part ${p.n}`); }
    if (p.fence) problems.push(`part ${p.n}: a fenced text sketch is not rendered; use an SVG sketch or a mock`);
    if (p.sketch && !fs.existsSync(path.join(dir, p.sketch))) problems.push(`part ${p.n}: sketch file missing ${p.sketch}`); else if (p.sketch && /(?:fill|stroke)="#/.test(read(path.join(dir, p.sketch)))) problems.push(`part ${p.n}: the sketch hard-codes colours; use the token classes (f-ink, s-ink, f-acc …) so it reads in dark mode`);
    if (p.mock && !fs.existsSync(path.join(dir, p.mock))) problems.push(`part ${p.n}: mock file missing ${p.mock}`);
    for (const f of [p.mock, p.sketch, p.picture.startsWith('file:') ? p.picture.slice(5) : ''].filter(Boolean)) if (!insideDir(dir, f)) problems.push(`part ${p.n}: ${f} is outside the build folder`);
    const isScreen = p.screen || p.mock || p.sketch;
    if (!opts.noLook && isScreen && (idea.look === 'premium' || idea.look === 'clean') && !p.mock) problems.push(`part ${p.n}: a ${idea.look} look needs a mock: for this screen part`);
    if (!opts.noLook && isScreen && idea.look === 'match' && !p.sketch && !p.mock) problems.push(`part ${p.n}: a match look needs a sketch: for this screen part`);
    if (isScreen && !idea.look) problems.push(`part ${p.n} has a screen but no look: line (premium, clean or match)`);
  }
  return problems;
}

// ---------- plan.md ----------
const WRAPPERS = /^(env|command|exec|nice|time|builtin|nohup|timeout|stdbuf|xargs|caffeinate)$/;
const TEXT_TOOLS = /^(grep|egrep|fgrep|awk|sed|cut|head|tail|sort|uniq|wc|tr|find|ls|stat|file|strings|tee|rev|column|paste|xargs|nohup|nl|more|less|xxd|od|hexdump|dd|git|cd|pwd|basename|dirname|realpath|md5|md5sum|shasum|sha256sum|diff|cmp|touch|cp|mv|mkdir|rm|true|false)$/;
const NOT_PRODUCT = /^(echo|printf|cat|yes|test|\[|\[\[|true|false|:|exit|export|set|unset|alias|sleep|wait|read|local|declare|typeset|umask|ulimit)$/; // printers, tests and shell builtins: never the product
function progOf(seg) { // the program a segment runs, after env assignments and wrappers (with their options); chain = the wrappers passed
  const toks = String(seg).replace(/^[(\s]+/, '').split(/\s+/).filter(Boolean); const chain = []; let i = 0; const base = t => t.replace(/^.*\//, '').replace(/\)+$/, '');
  while (i < toks.length) {
    if (/^[A-Za-z_][A-Za-z0-9_]*=/.test(toks[i])) { i++; continue; }
    const b = base(toks[i]); if (!WRAPPERS.test(b)) return { chain, prog: b };
    chain.push(b); i++; while (i < toks.length && /^-/.test(toks[i])) { const o = toks[i++]; if (/^-[nsktIPLEdu]$/.test(o) && i < toks.length) i++; } if (b === 'timeout' && i < toks.length && /^\d/.test(toks[i])) i++;
  }
  return { chain, prog: '' };
}
const hasExpectedCI = (text, expected) => !!expected && new RegExp(`(^|[^\\p{L}\\p{N}])${escapeRe(expected)}($|[^\\p{L}\\p{N}])`, 'iu').test(text);
function trivialCmd(cmd, expected, legacy) { // legacy: a step proven before 1.0.6 keeps the old rules (no separator, text-tool or named-answer rule)
  const parts = String(cmd).split(/(\|\||&&|\||;|&)/).map(s => s.trim()).filter(Boolean); const segs = parts.filter((_, i) => i % 2 === 0), seps = parts.filter((_, i) => i % 2 === 1);
  const first = legacy ? s => { const toks = s.replace(/^[(\s]+/, '').split(/\s+/).filter(x => !/^[A-Z_][A-Z0-9_]*=/.test(x) && !/^(env|command|exec|nice|time|builtin)$/.test(x)); return (toks[0] || '').replace(/^.*\//, ''); } : s => progOf(s).prog;
  const printer = s => /^(echo|printf|cat|yes)$/.test(first(s)); const passThrough = s => /^\(?\s*cat(\s+-)?\s*\)?$/.test(s);
  if (!segs.length || segs.some(s => /^(true|false|:|exit)$/.test(first(s)))) return 'proves nothing';
  if (segs.every(s => printer(s) && !passThrough(s))) return 'prints its own answer';
  const L = segs.length - 1; if (segs.length > 1 && printer(segs[L]) && !(passThrough(segs[L]) && seps[L - 1] === '|') && seps[L - 1] !== '&&') return 'prints its own answer whatever ran before it';
  for (let i = 0; i < L; i++) if (printer(segs[i]) && !passThrough(segs[i]) && seps[i] !== '|' && !/\s>>?\s*\S/.test(segs[i])) return 'prints its own answer before the product runs';
  if (/\b(node|deno|bun|perl|ruby|python3?|php)\s+(-[a-zA-Z]*[ep][a-zA-Z]*|--eval|--print)(?=[\s=]|$)/.test(cmd) || /\b(sh|bash|zsh|dash|python3?|perl|ruby|php)\s+-[a-zA-Z]*c[a-zA-Z]*(?=\s|$)/.test(cmd)) return 'runs code typed into the command instead of the product';
  if (legacy) return null;
  if (/;|\|\||(^|[^&])&(?!&)/.test(String(cmd).replace(/\d*[<>]&\d*-?/g, ' ').replace(/&>>?/g, '>'))) return 'uses ; & or ||, which can hide a failure; use && and |';
  const textTool = s => { const p = progOf(s); const t = [...p.chain, p.prog].find(x => TEXT_TOOLS.test(x)); if (t) return t; if (p.prog === 'node' && /(^|\s)(--check|-c)(?=\s|$)/.test(s)) return 'node --check'; return null; };
  const fileProof = s => { const p = progOf(s); return /^(test|\[|\[\[)$/.test(p.prog) && !p.chain.length && /(^|\s)-[fds](?=\s|$)/.test(s); }; // a file-exists proof
  const runsProduct = s => { const p = progOf(s); return !!p.prog && !textTool(s) && !NOT_PRODUCT.test(p.prog); };
  let k = 0; while (k < L && progOf(segs[k]).prog === 'cd' && seps[k] === '&&') k++; // moving into a folder first is not the product, and not refused
  { const tool = textTool(segs[k]); if (tool) return `starts with ${tool}, which reads or lists files instead of running the product`; }
  if (L > 0 && progOf(segs[L]).prog === 'printf') return 'ends with printf, which builds its own answer whatever ran before it';
  if (expected) for (let i = 0; i <= L; i++) { const q = progOf(segs[i]); if (i === L && i > 0 && seps[i - 1] === '&&' && q.prog === 'echo' && !q.chain.length && (fileProof(segs[i - 1]) || runsProduct(segs[i - 1]))) continue; if (hasExpectedCI(segs[i], expected)) return 'names its own answer: the expected text is written into the command'; }
  if (!segs.some(runsProduct) && !segs.slice(k).every((s, i, a) => fileProof(s) || (i === a.length - 1 && i > 0 && progOf(s).prog === 'echo' && !progOf(s).chain.length))) return 'never runs the product (only file tools, tests or printers)';
  return null;
}
function provesNothing(cmd, expected) {
  const empty = fs.mkdtempSync(path.join(os.tmpdir(), 'compass-empty-')); const run = runOne(cmd, empty, { ...process.env, COMPASS_TARGET: 'http://127.0.0.1:9' }); try { fs.rmSync(empty, { recursive: true, force: true }); } catch {}
  return passes(run, expected) ? `\`${cmd}\` passes in an empty folder, so it proves nothing about this project` : null;
}
function parsePlan(text) {
  const slices = []; let cur = null; const risks = [], questions = []; const sections = {};
  for (const line of lines(text)) {
    const sec = line.match(/^##\s+(\d+)\.\s+(.+)$/); if (sec) { sections[+sec[1]] = sec[2].trim(); cur = null; continue; }
    const h = line.match(new RegExp(`^###\\s+Slice\\s+(\\d+)\\s+${D}\\s+(.+)$`));
    if (h) { cur = { n: +h[1], title: h[2].replace(/\s*\(.*\)\s*$/, '').trim(), steps: [] }; slices.push(cur); continue; }
    const s = line.match(new RegExp(`^-\\s+\\[[ xX]\\]\\s+(${STEP})\\s+(.+)$`));
    if (s && cur) {
      const rest = s[2]; const arrow = rest.search(/→\s*(P\d+\.\d+|all)\b/);
      const text_ = (arrow >= 0 ? rest.slice(0, arrow) : rest).trim().replace(/\.$/, ''); const tail = arrow >= 0 ? rest.slice(arrow + 1) : '';
      const promises = (tail.split('·')[0].match(/P\d+\.\d+/g)) || [];
      const vm = tail.match(/verify:\s*(.+?)(?:\s+·\s+[≈~]|$)/); const raw = vm ? vm[1].trim() : '';
      const cm = raw.match(/^`([^`]+)`\s*(?:→\s*(.+))?$/);
      const verify = { raw, cmd: cm ? cm[1].trim() : '', expected: cm && cm[2] ? cm[2].split(' · ')[0].trim() : '' };
      const em = tail.match(/[≈~]\s*(\d+(?:\.\d+)?)\s*(h|hr|hours?|min|minutes?|d|days?)/); let estimate = null;
      if (em) { const v = +em[1]; estimate = /^d/.test(em[2]) ? v * 8 : /^min/.test(em[2]) ? v / 60 : v; }
      cur.steps.push({ id: s[1], slice: cur.n, text: text_, promises, verify, estimate });
    }
    const r = line.match(/^-\s+(R\d+)\s+(.+)$/); if (r) risks.push({ id: r[1], text: r[2].trim() });
    const q = line.match(/^-\s+(Q\d+)\s+(.+)$/); if (q) questions.push({ id: q[1], text: q[2].trim() });
  }
  return { slices, steps: slices.flatMap(x => x.steps), risks, questions, sections, text };
}
const planSection = (plan, n) => { const m = plan.text.split(new RegExp(`^##\\s+${n}\\.\\s[^\\n]*\\n`, 'm'))[1]; return m ? m.split(/^##\s+\d+\.\s/m)[0] : ''; };

// ---------- receipts.md ----------
function parseReceipts(text) {
  const receipts = []; let cur = null;
  for (const line of lines(text)) {
    const h = line.match(new RegExp(`^##\\s+RECEIPT\\s+${D}\\s+(\\S+)\\s+·\\s+(.+?)\\s+·\\s+(.+?)\\s+·\\s+(\\S+)\\s*$`));
    if (h) { cur = { stage: h[1], slug: h[2], result: h[3].trim(), ts: h[4], lines: [], idx: receipts.length }; receipts.push(cur); continue; }
    const l = line.match(/^-\s+\[([ xX])\]\s+(.+)$/); if (l && cur) cur.lines.push({ done: l[1] !== ' ', text: l[2].trim() });
  }
  return receipts;
}
function appendReceipt(dir, stage, result, body) {
  result = String(result).trim(); body = body.map(l => String(l).trim()).filter(Boolean);
  const ts = new Date().toISOString().replace(/\.\d{3}Z$/, 'Z'); const slug = path.basename(dir);
  const text = body.map(l => (l.startsWith('[ ]') ? `- ${l}` : `- [x] ${l.replace(/^\[x\]\s*/, '')}`)).join('\n');
  fs.appendFileSync(path.join(dir, 'receipts.md'), `\n## RECEIPT — ${stage} · ${slug} · ${result} · ${ts}\n${text}\n`);
  return ts;
}
const answeredYes = r => r.lines.some(l => YES.test(l.text));

// ---------- state ----------
function computeState(dir) {
  const idea = parseIdea(read(path.join(dir, 'idea.md'))); const plan = parsePlan(read(path.join(dir, 'plan.md'))); const receipts = parseReceipts(read(path.join(dir, 'receipts.md')));
  const slug = path.basename(dir);
  const flags = { planPin: '', ideaPin: '', planSteps: 0, questions: 0, questionsOf: QUESTIONS, ideaDrafted: false, ideaApproved: false, lookApproved: false, planDrafted: false, planApproved: false, released: false, writeback: false, gate3: false, gate4: false, preflight: false, rehearsal: false, gatesGreenAt: -1, rootGreenAt: -1, lastRunRed: false, lastProvenAt: -1, lastAmendAt: -1, lastFixAt: -1, writebackAt: -1, skippedQs: [] };
  const proven = new Map(); const attacks = {}; const supersededAt = {}; const live = {}; const liveAt = {}; const unmeasured = new Set(); const decisions = [], leftovers = []; let productBad = 0, target = '';
  const asked = new Set(), skipped = new Set(); let ask = null, askOptions = [], watch = null, watchClosed = false, amends = 0, chosenRows = [];
  const g3 = { ask: -1, last: null }, g4 = { ask: -1, last: null }; let lastChange = -1; // gates 3 and 4 follow the person's last answer
  for (const r of receipts) {
    let m;
    if (isChange(r)) lastChange = r.idx;
    if (r.stage === 'amend' && /^part\s+\d+\s+edited$/.test(r.result)) supersededAt.page = supersededAt.plan = r.idx; // page and plan attacks restart after an amend; within a version they count only for the page or plan they attacked (attacked: pin)
    if (r.stage === 'build' && r.result === 'gate 3') { if (r.lines.some(l => /^answered:/.test(l.text))) g3.last = { idx: r.idx, yes: answeredOnceYes(r), ask: g3.ask }; if (hasAsk(r)) g3.ask = r.idx; }
    if (r.stage === 'deploy' && r.result === 'gate 4') { if (r.lines.some(l => /^answered:/.test(l.text))) g4.last = { idx: r.idx, yes: answeredOnceYes(r), ask: g4.ask }; if (hasAsk(r)) g4.ask = r.idx; }
    if (r.stage === 'idea') { if ((m = r.result.match(/^question\s+(\d+)\s+of\s+(\d+)/))) { asked.add(+m[1]); if (/\bskipped$/.test(r.result)) skipped.add(+m[1]); else skipped.delete(+m[1]); flags.skipped = skipped.size; flags.skippedQs = [...skipped]; flags.answered = asked.size - skipped.size; flags.questionsOf = QUESTIONS; flags.questions = asked.size; flags.questionsMissing = [...Array(flags.questionsOf)].map((_, i) => i + 1).filter(k => !asked.has(k)); } if (/^drafted$/.test(r.result)) flags.ideaDrafted = true; if (/^approved$/.test(r.result) && approvedBy(receipts, r)) flags.ideaApproved = true; if (/^look approved$/.test(r.result) && approvedBy(receipts, r)) flags.lookApproved = true; }
    if (r.stage === 'plan') { if (/^drafted$|^revised$/.test(r.result)) flags.planDrafted = true; if (/^approved$/.test(r.result) && approvedBy(receipts, r)) flags.planApproved = true; }
    if (r.stage === 'build' && r.result === 'attacks chosen') chosenRows = r.lines.map(l => l.text.match(/^row:\s*((?:A|L)\d+)\s+(\S+)\s+(\S+)/)).filter(Boolean).map(x => ({ id: x[1], promise: x[2], key: x[3] }));
    if (r.stage === 'build' && (m = r.result.match(new RegExp(`^step\\s+(${STEP})\\s+proven$`)))) { proven.set(m[1], r.idx); flags.lastProvenAt = r.idx; }
    if ((r.stage === 'build' || r.stage === 'deploy') && /^gates green$/.test(r.result)) { flags.gatesGreenAt = r.idx; const on = (r.lines.find(l => /^ran on:/.test(l.text)) || { text: '' }).text.replace(/^ran on:\s*/, '').trim(); if (on && !/^https?:\/\//.test(on) && samePath(on, repoOf(dir))) flags.rootGreenAt = r.idx; }
    if ((r.stage === 'build' || r.stage === 'deploy') && /^gates (green|red)$/.test(r.result)) flags.lastRunRed = r.result === 'gates red'; // the last recorded gate run decides
    if (isAmendEdit(r)) flags.lastAmendAt = r.idx; if (r.stage === 'build' && /^fix\s+(A|L)\d+/.test(r.result)) flags.lastFixAt = r.idx;
    if (r.stage === 'attack' && (m = r.result.match(/^((?:A|L)\d+)\s+(P\d+\.\d+|all|page|plan)\s+attempt\s+(\d)\s+(held|broke|resolved)$/))) {
      const key = `${m[1]} ${m[2]}`; const a = (attacks[key] = attacks[key] || { id: m[1], promise: m[2], attempts: [], resolved: false, klass: '' });
      const c = r.lines.find(l => /^class:/.test(l.text)); if (c) a.klass = c.text.replace(/^class:\s*/, '').split(/\s*·\s*/)[0].trim();
      const on = r.lines.find(l => /^attacked:/.test(l.text)); if (m[4] === 'resolved') { a.resolved = true; a.resolvedAt = r.idx; } else a.attempts.push({ k: +m[3], result: m[4], idx: r.idx, ...(on ? { pin: on.text.replace(/^attacked:\s*/, '').trim() } : {}) });
    }
    if (r.stage === 'deploy' && /^writeback$/.test(r.result)) productBad = 0;
    if (r.stage === 'deploy') { if (/^preflight$/.test(r.result)) flags.preflight = true; if (/^rehearsal$/.test(r.result)) flags.rehearsal = true; if (/^released$/.test(r.result)) flags.released = true; if (/^writeback$/.test(r.result)) { flags.writeback = true; flags.writebackAt = r.idx; } }
    if (r.stage === 'amend' && /edited$/.test(r.result)) amends++;
    for (const l of r.lines) {
      if ((m = l.text.match(/^decision:\s*(.+)$/))) decisions.push({ ts: r.ts, text: m[1] });
      if ((m = l.text.match(/^leftover:\s*(.+)$/))) leftovers.push({ ts: r.ts, text: m[1], at: r.idx, key: r.stage === 'attack' ? r.result.split(/\s+/).slice(0, 2).join(' ') : null });
      if ((m = l.text.match(/^(P\d+\.\d+):\s*live\s+(.+?)\s*(✓|✗)$/))) { live[m[1]] = { value: m[2], ok: m[3] === '✓' }; liveAt[m[1]] = r.idx; unmeasured.delete(m[1]); }
      if ((m = l.text.match(/^(P\d+\.\d+):\s*not measured/))) unmeasured.add(m[1]);
      if ((m = l.text.match(/^step-pin:\s*(\S+)/)) && r.stage === 'build') (flags.stepPins = flags.stepPins || {})[r.result.split(/\s+/)[1]] = m[1]; if ((m = l.text.match(/^plan-pin:\s*(\S+)/))) flags.planPin = m[1]; if ((m = l.text.match(/^idea-pin:\s*(\S+)/))) flags.ideaPin = m[1]; if ((m = l.text.match(/^plan-steps:\s*(.+?)\s*$/))) { const v = m[1]; delete flags.planStepsV2; delete flags.planStepPromises; if (/^\d+$/.test(v)) { flags.planSteps = +v; flags.planStepPins = null; } else { const ent = v.split(/\s+/).filter(x => x.includes('=')).map(x => { const [id, rest] = x.split('='); const [pin, ps] = rest.split('@'); return [id, pin, (ps || '').split(',').filter(Boolean)]; }); flags.planStepPins = Object.fromEntries(ent.map(e => [e[0], e[1]])); flags.planSteps = ent.length; if (/^v2(\s|$)/.test(v)) { flags.planStepsV2 = true; flags.planStepPromises = Object.fromEntries(ent.map(e => [e[0], e[2]])); } } }
      if ((m = l.text.match(/^spec-pin:\s*(\S+)/))) flags.specPin = m[1]; if ((m = l.text.match(/^look-pin:\s*(\S+)/))) { if (r.stage === 'idea' && r.result === 'look ready') flags.lookShownPin = m[1]; else { flags.lookPin = m[1]; if (!(r.stage === 'idea' && r.result === 'look approved' && !r.lines.some(x => /^idea-pin:/.test(x.text)))) flags.lookPinBase = m[1]; } } /* look ready pins what was shown; an approval pins what is built; a look approved inside an amend (no idea-pin) leaves the base the amend compares with */ if ((m = l.text.match(/^idea-promises:\s*(.*)$/))) flags.ideaPromises = Object.fromEntries(m[1].split(/\s+/).filter(x => x.includes('=')).map(x => x.split('=')));
      if (r.stage === 'deploy' && /^writeback$/.test(r.result)) { if ((m = l.text.match(/^all:\s*check\s+\S+\s+(✓|✗)$/)) && m[1] === '✗') productBad++; if ((m = l.text.match(/^target:\s*(.+)$/))) target = m[1]; }
      if (r.stage === 'amend' && (m = l.text.match(/^supersede:\s*(.+)$/))) { supersededAt.all = r.idx; const drop = pid => { supersededAt[pid] = r.idx; if (liveAt[pid] !== undefined && liveAt[pid] < r.idx) { delete live[pid]; } }; for (const id of m[1].split(/[\s,]+/).filter(Boolean)) { if (/^P\d+\.\d+$/.test(id)) { drop(id); for (const s of plan.steps.filter(s => s.promises.includes(id))) { proven.delete(s.id); s.promises.forEach(drop); } continue; } proven.delete(id); const st = plan.steps.find(s => s.id === id); if (st) for (const pid of st.promises) drop(pid); } } // a promise id un-proves its steps and drops its live number
      if ((m = l.text.match(/^watch:\s*until\s+(\S+)/))) { watch = m[1]; watchClosed = false; }
      if (/^watch:\s*closed/.test(l.text)) watchClosed = true;
      if (/^retract:\s*writeback/.test(l.text)) { for (const k of Object.keys(live)) delete live[k]; unmeasured.clear(); flags.writeback = false; watch = null; }
      const a = !l.done && l.text.match(/^ask:\s*(.+)$/); if (a) { const sp = splitAsk(a[1]); ask = sp.question || a[1].trim(); askOptions = sp.options.filter(o => o.label).map(o => ({ label: o.label, consequence: o.consequence })); }
      if (/^answered:/.test(l.text)) { ask = null; askOptions = []; }
    }
  }
  { const items = leftoverItems(receipts); const open = items.filter(x => !x.accepted); const L = g3.last; // gate 3: the last answer, a yes to a question asked after every item it accepts; or every item accepted where it was set aside
    if (L) { flags.gate3 = L.yes && L.ask >= 0 && !open.some(x => (x.idx > L.ask && x.idx < L.idx) || x.idx > L.idx); if (flags.gate3) flags.gate3At = L.idx; } else flags.gate3 = items.length > 0 && !open.length; // items inside the ask or the yes itself (old records) count as named
    const G = g4.last; flags.gate4 = !!(G && G.yes && G.ask >= 0 && G.ask > lastChange); } // gate 4: the last answer is a yes, to a question asked after the last change
  const pinNow = { page: Object.values(attacks).some(a => a.promise === 'page') ? attackedPin(dir, 'page') : '', plan: Object.values(attacks).some(a => a.promise === 'plan') ? attackedPin(dir, 'plan') : '' };
  const fixedAfter = (id, idx) => receipts.some(q => q.idx > idx && q.stage === 'build' && q.result === `fix ${id}`);
  const attackList = Object.values(attacks).map(a => { const cut = supersededAt[a.promise] ?? -1; const { resolvedAt, ...rest } = a; let attempts = a.attempts.filter(x => x.idx > cut);
    if (pinNow[a.promise]) { const lastAll = attempts[attempts.length - 1]; attempts = attempts.filter(x => !x.pin || x.pin === pinNow[a.promise] || (x === lastAll && x.result === 'broke' && fixedAfter(a.id, x.idx))); } // a break whose fix changed the page carries on to attempt 2
    return { key: `${a.id} ${a.promise}`, ...rest, attempts, resolved: a.resolved && resolvedAt > cut }; }).filter(a => a.attempts.length || a.resolved);
  const promises = idea.promises.map(p => {
    const steps = plan.steps.filter(s => s.promises.includes(p.id)); const done = steps.filter(s => proven.has(s.id)).length;
    const mine = attackList.filter(a => a.promise === p.id);
    let state = 'planned'; if (done > 0) state = 'building'; if (steps.length && done === steps.length) state = 'built';
    if (state === 'built' && mine.length) {
      const last = mine.map(a => a.resolved ? { result: 'held', k: 2 } : a.attempts[a.attempts.length - 1]);
      const unresolved = last.filter(x => x.result === 'broke');
      if (unresolved.length) state = unresolved.some(x => x.k >= 2) ? 'needs you' : 'broke';
      else state = mine.some(a => a.resolved) ? 'set aside' : mine.some(a => a.attempts.some(x => x.result === 'broke')) ? 'fixed' : 'held';
    }
    const lv = live[p.id] && ['built', 'held', 'fixed', 'set aside'].includes(state) ? live[p.id] : null; if (lv) state = lv.ok ? 'live' : 'live ✗';
    return { ...p, steps: steps.length, done, state, plain: PLAIN[state] || state, live: lv, unmeasured: unmeasured.has(p.id) };
  });
  const total = plan.steps.length, provenCount = plan.steps.filter(s => proven.has(s.id)).length;
  const nextStep = plan.steps.find(s => !proven.has(s.id)) || null; const allProven = total > 0 && provenCount === total;
  const curPartN = nextStep ? (idea.promises.find(p => p.id === nextStep.promises[0]) || {}).part : null; const curPart = idea.parts.find(p => p.n === curPartN) || null;
  const liveOk = promises.filter(p => p.live && p.live.ok).length, liveBad = promises.filter(p => p.live && !p.live.ok).length, open = promises.filter(p => /broke|needs/.test(p.state)).length;
  const watchOver = !!(watch && !watchClosed && today() > watch); const qOf = QUESTIONS; const lastCodeChange = Math.max(flags.lastProvenAt, flags.lastAmendAt, flags.lastFixAt); const measuredFresh = flags.writeback && flags.writebackAt > lastCodeChange; const openIt = /^https?:\/\//.test(target) ? ` · open it: ${target}` : '';
  const rowClosed = row => { const a = attackList.find(x => x.key === `${row.id} ${row.promise}`); const last = a && a.attempts[a.attempts.length - 1]; return !!(a && (a.resolved || (last && last.result === 'held'))); }; const openRows = chosenRows.filter(r => !rowClosed(r)); const partFinished = pid => { const ss = plan.steps.filter(s => s.promises.includes(pid)); return ss.length > 0 && ss.every(s => proven.has(s.id)); }; const testable = chosenRows.filter(r => r.promise === 'all' ? allProven : partFinished(r.promise)); const openTestable = testable.filter(r => !rowClosed(r)); const releasedAt = Math.max(-1, ...receipts.filter(r => r.stage === 'deploy' && r.result === 'released').map(r => r.idx)); const partLabel = total && provenCount === total - 1 ? 'the last step' : curPart ? `Part ${curPart.n}, ${curPart.title}` : 'the thin version first';
  for (let i = leftovers.length - 1; i >= 0; i--) { const L = leftovers[i]; const a = L.key && attacks[L.key]; if (a && a.attempts.some(x => x.idx > L.at && x.result === 'held')) leftovers.splice(i, 1); }
  let stage, next, line;
  if (flags.planApproved && !total) { stage = 'plan'; next = 'rewrite the plan'; line = 'Plan being rewritten · next: I rewrite the plan; nothing needed from you'; }
  else if (flags.planApproved && openTestable.length) { const pr = idea.promises.find(p => p.id === openTestable[0].promise); const pt = pr && idea.parts.find(x => x.n === pr.part); stage = 'build'; next = 'run the open attacks'; line = `Testing · ${pt ? `Part ${pt.n}, ${pt.title}` : 'the whole product'} · ${testable.length - openTestable.length} of ${testable.length} tests done · next: I keep testing; nothing needed from you`; }
  else if (flags.planApproved && !allProven && (flags.writeback || flags.released)) { stage = 'build'; next = `build ${nextStep.id}`; line = `Building again · ${partLabel} · ${provenCount} of ${total} steps done · next: I rebuild the changed part; nothing needed from you`; }
  else if (flags.planApproved && allProven && flags.lastRunRed && !measuredFresh) { stage = 'build'; next = 'fix the red checks'; line = 'Built · next: I fix the red checks'; } // the last recorded gate run is red; nothing goes live on it
  else if (flags.writeback && !measuredFresh) { stage = 'deploy'; if (releasedAt > lastCodeChange) { next = 'write back the live numbers'; line = 'Going live · next: I measure every promise on the live system'; } else if (flags.gate4) { next = 'release (the person said go)'; line = 'Going live · next: I release it'; } else { next = 'safety checks, then release the change (gate 4)'; line = `Rebuilt · ${provenCount} of ${total} steps done · next: I run the safety checks, then ask you`; } }
  else if (flags.writeback) { stage = 'live'; next = liveBad || productBad ? 'a live number is ✗; change that part' : open ? 'a promise broke after going live' : watchClosed ? 'done' : watchOver ? 're-measure the live numbers' : watch ? `watch until ${watch}` : 'done'; line = watchClosed && !liveBad && !productBad && !open ? `Done · ${idea.title} is live and every number held${openIt} · next: a new idea, when you have one` : `Live · ${liveOk} of ${promises.length} promises measured ✓${liveBad ? ` · ${liveBad} ✗` : ''}${productBad ? ' · a whole-product check is ✗' : ''}${open ? ` · ${open} broke after going live` : ''}${openIt} · ${liveBad || productBad || open ? 'next: I change that part with you' : watchOver ? 'watch period over · next: I re-measure' : watch ? `type /compass after ${day(watch)} and I measure again` : 'next: I set a check-again date'}`; }
  else if (flags.released) { stage = 'deploy'; next = 'write back the live numbers'; line = 'Going live · next: I measure every promise on the live system'; }
  else if (flags.planApproved && allProven && leftovers.length && !flags.gate3) { stage = 'build'; next = 'accept the leftovers (gate 3)'; line = `Built · ${provenCount} of ${total} steps done · next: accept what was set aside (your call)`; }
  else if (flags.planApproved && allProven && flags.gate4) { stage = 'deploy'; next = 'release (the person said go)'; line = 'Going live · next: I release it'; }
  else if (flags.planApproved && allProven) { stage = 'deploy'; const ready = flags.preflight && flags.rehearsal && flags.rootGreenAt > flags.lastProvenAt; next = ready ? 'deploy to production (gate 4)' : 'pre-flight and rehearse the undo'; line = ready ? 'Ready to go live · next: your go-ahead' : 'Built · next: I run the safety checks and practise the undo; nothing needed from you'; }
  else if (flags.planApproved) { stage = 'build'; next = `build ${nextStep.id}`; line = `Building · ${partLabel} · ${provenCount} of ${total} steps done · next: I keep building; nothing needed from you`; }
  else if (flags.planDrafted) { stage = 'plan'; next = 'approve the plan (gate 2)'; line = 'Plan ready · next: your approval, on one screen'; }
  else if (flags.ideaApproved && idea.look && !flags.lookApproved) { stage = 'idea'; next = 'the look (approve the screens)'; line = 'Idea approved · next: the screens, for your approval'; }
  else if (flags.ideaApproved) { stage = 'plan'; next = 'write the plan'; line = 'Planning · next: I read your code and write the plan; nothing needed from you'; }
  else if (flags.ideaDrafted) { stage = 'idea'; next = 'approve the Idea page (gate 1)'; line = 'Idea page ready · next: your approval'; }
  else if (flags.questions >= qOf && flags.questions > 0) { stage = 'idea'; next = 'draw the page'; line = `Interview done · ${flags.answered} answered${flags.skipped ? `, ${flags.skipped} not needed` : ''} · next: your Idea page`; }
  else if (flags.questions > 0) { const nq = (flags.questionsMissing || [])[0] || flags.questions + 1; stage = 'idea'; next = `question ${nq} of ${qOf}`; line = `Idea · ${flags.answered} question${flags.answered === 1 ? '' : 's'} answered${flags.skipped ? `, ${flags.skipped} not needed` : ''} · next: question ${nq}`; }
  else { stage = 'idea'; next = 'start the interview'; line = 'Not started · next: a short interview about your idea'; }
  const route = /^No build/.test(line) ? 'none' : /^Plan being rewritten/.test(line) ? 'plan' : /^Done ·/.test(line) ? 'done' : /^Live ·/.test(line) ? (liveBad || productBad || open ? 'amend' : watchOver ? 'watch' : 'live') : /^(Going live|Ready to go live|Rebuilt|Built · next: I run)/.test(line) ? 'deploy' : /^Built · next: I fix/.test(line) ? 'build' : /^Built ·/.test(line) ? 'gate3' : /^(Building|Testing)/.test(line) ? 'build' : /^(Planning|Plan ready)/.test(line) ? 'plan' : 'idea';
  if (ask) line = line.replace(/; nothing needed from you/, '').replace(/next: I [^·]*$/, 'next: your answer, below');
  if (idea.card && /^(Idea approved|Planning|Plan ready|Building|Testing|Built|Ready to go live|Going live|Live|Done|Rebuilt)/.test(line)) line += ` · your card: ${idea.card}`;
  const lineWithAsk = ask ? `${line} · for you: ${ask}` : line;
  return { slug, title: idea.title, page: idea.page, version: 1 + amends, stage, route, line: lineWithAsk, lineBare: line, next, ask, askOptions, card: idea.card || '', watch, watchOver, watchClosed, target, productBad, flags,
    slices: plan.slices.map(s => ({ n: s.n, title: s.title, total: s.steps.length, done: s.steps.filter(x => proven.has(x.id)).length })),
    steps: { total, proven: provenCount, next: nextStep && nextStep.id, nextText: nextStep && nextStep.text },
    parts: idea.parts.map(p => ({ n: p.n, title: p.title })), promises, risks: plan.risks, questions: plan.questions, decisions, leftovers, attacks: attackList,
    productAttacks: attackList.filter(a => a.promise === 'all').map(a => ({ id: a.id, klass: a.klass, last: a.attempts[a.attempts.length - 1] })) };
}
function className(key) { const c = parseCatalogue().find(c => c.key === key); return c ? c.name : key; }
function stepsByPart(plan, idea) {
  const partOf = id => { const p = idea.promises.find(x => x.id === id); return p ? p.part : null; }; const sk = plan.slices[0]; const skIds = new Set(sk ? sk.steps.map(s => s.id) : []); const m = { 0: [] }; for (const part of idea.parts) m[part.n] = [];
  for (const s of plan.steps) { if (skIds.has(s.id)) m[0].push(s); const parts = s.promises.map(partOf).filter(x => x !== null); const n = parts.length ? Math.min(...parts) : 0; if (n || !skIds.has(s.id)) (m[n] = m[n] || []).push(s); }
  return m;
}
function partLine(dir, n) {
  const st = computeState(dir); const ids = st.promises.filter(p => p.part === n).map(p => p.id);
  const mine = st.attacks.filter(a => ids.includes(a.promise) && /^A/.test(a.id));
  const held = mine.filter(a => !a.resolved && a.attempts.length && a.attempts.every(x => x.result === 'held')).length;
  const fixed = mine.filter(a => !a.resolved && a.attempts.some(x => x.result === 'broke') && a.attempts[a.attempts.length - 1].result === 'held').length;
  const aside = mine.filter(a => a.resolved).length;
  const open = mine.length - held - fixed - aside; const part = st.parts.find(p => p.n === n); const head = `Part ${n}${part ? `, ${part.title}` : ''}`;
  if (!mine.length) return `${head} done.`;
  return `${head} checked with ${mine.length} test${mine.length === 1 ? '' : 's'}: ${held} held${fixed ? `, ${fixed} broke and ${fixed === 1 ? 'was' : 'were'} fixed` : ''}${aside ? `, ${aside} set aside` : ''}${open ? `, ${open} still open` : ''}.`;
}

// ---------- receipt validation ----------
// every verify and gate command runs under bash -o pipefail, so a pipe keeps the product's failure
function runOne(cmd, cwd, env) { try { const out = execFileSync('bash', ['-o', 'pipefail', '-c', cmd], { cwd, encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'], timeout: 180000, env: env || process.env }); return { ok: true, out: out.trim() }; } catch (e) { return { ok: false, out: ((e.stdout || '') + (e.stderr || '')).toString().trim() || e.message, code: e.status }; } }
const escapeRe = s => String(s).replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); const hasExpected = (text, expected) => !!expected && new RegExp(`(^|[^\\p{L}\\p{N}])${escapeRe(expected)}($|[^\\p{L}\\p{N}])`, 'u').test(text);
const passes = (run, expected) => run.ok && !!expected && !/^exit\s*0$/i.test(expected) && hasExpected(run.out, expected);
const observedLine = (run, expected) => (expected && run.out.split('\n').find(l => hasExpected(l, expected))) || run.out.split('\n').find(l => l.trim()) || '';
const verifyProblem = (s, legacy) => { if (!s.verify.cmd) return 'no command'; if (!s.verify.expected) return 'no expected output'; if (/^exit\s*0$/i.test(s.verify.expected)) return 'the expected output must be text, not an exit code'; const tr = trivialCmd(s.verify.cmd, s.verify.expected, legacy); return tr ? `\`${s.verify.cmd}\` ${tr}` : null; };
function attackRows(dir) { const t = read(path.join(dir, 'attacks.md')); return [...t.matchAll(/^\|\s*((?:A|L)\d+)\s*\|\s*(\S+)\s*\|\s*(\S+)\s*\|/gm)].map(m => ({ id: m[1], promise: m[2], key: m[3] })); }
function validateReceipt(dir, stage, result, body, opts = {}) {
  if ([result, ...body].some(l => /[\r\n]/.test(String(l)))) return 'a receipt argument holds a line break; one line per argument'; result = String(result).trim(); body = body.map(l => String(l).trim()).filter(Boolean);
  if (!result) return 'the result is empty; name what happened (for example "note", "step S1.2 proven", "gate 3")';
  { const canon = result.toLowerCase().replace(/\b([sapl])(\d+(?:\.\d+)?[a-z]?)\b/g, (_, a, b) => a.toUpperCase() + b); if (canon !== result && KNOWN_RESULT.test(canon)) return `write it as: ${canon}`; }
  const base = path.basename(dir); if (/\s/.test(base)) return `the build folder name "${base}" has a space; use kebab-case`;
  if (!['idea', 'plan', 'build', 'attack', 'deploy', 'amend'].includes(stage)) return `unknown stage "${stage}"`;
  const st = computeState(dir); const plan = parsePlan(read(path.join(dir, 'plan.md'))); const idea = parseIdea(read(path.join(dir, 'idea.md'))); const receipts = parseReceipts(read(path.join(dir, 'receipts.md')));
  const clean = body.map(l => l.replace(/^\[[ x]\]\s*/, '')); const has = re => clean.some(l => re.test(l));
  let m;
  if (!opts.internal) { if (/^question\s+\d+\s+of\s+\d+/.test(result)) return 'interview answers are recorded by `answer <dir> question <k> <n>`, not typed'; const askLines = body.filter(l => /^\[ \]\s*ask:/.test(l)); if (askLines.length > 1) return 'one question per receipt'; for (const askLine of askLines) { const sp = splitAsk(askLine.replace(/^\[ \]\s*ask:\s*/, '')); if (!sp.question || sp.options.length < 2 || sp.options.some(o => o.arrows !== 1 || !o.label || !o.consequence)) return 'a question for the person carries its options: "[ ] ask: <question> · <label> (Recommended) → <what happens> · <label> → <what happens>"'; } }
  if (!opts.internal) { if (/^(gates green|gates red|preflight|writeback|attacks chosen)$/.test(result)) return `"${result}" is written only by its own verb (gates --run --record, preflight --record, writeback, attacks <dir> build)`; if (clean.some(l => /^(P\d+\.\d+:\s*(live|not measured)|all:\s*check|watch:|target:|retract:)/.test(l))) return 'live numbers, watch, target and retract lines are written only by writeback'; if (clean.some(l => /^(plan-pin|idea-pin|plan-steps|step-pin|spec-pin|look-pin|idea-promises|attacked):/.test(l))) return 'pin lines are written by the record itself'; }
  if (stage !== 'amend' && clean.some(l => /^supersede:/.test(l))) return 'only an amend receipt may supersede a step';
  for (const l of clean) { const pm = l.match(/^(decision|leftover):\s*(.*)$/); if (!pm) continue; const words = pm[2].replace(/\b(?:https?|file):\/\/\S+/g, ' '); const bad = words.match(RECORD_IDS) || words.match(BUILDER_WORDS); if (bad) return `the person reads every ${pm[1]}: line on the card; say it in plain words, without "${bad[0]}"`; }
  if (has(/^leftover:/) && (stage === 'deploy' || stage === 'amend' || (stage === 'build' && result === 'gate 3'))) return 'a leftover: is recorded on its own (receipt <dir> build note "leftover: …") or with attempt 2 resolved, never inside a gate 3, deploy or amend receipt';
  const askKey = `${stage} ${result}`; if (ASK_FOR[askKey]) { const ans = clean.filter(l => /^answered:/.test(l)); const asks = ASK_FOR[askKey];
    if (ans.length > 1) return 'one answered: line per receipt';
    if (ans.length) { if (!askedBefore(receipts, Infinity, stage, asks)) return `${result}: the question was never recorded (receipt … "${asks[0]}" "[ ] ask: …") before the answer`; if (/approved$/.test(result) && !YES.test(ans[0])) return `"${result}" with an answer that is not a yes ("${ans[0]}"); record their choice under "${stage} not approved"`;
      if (askKey === 'idea approved' || askKey === 'plan approved') { const drafts = askKey === 'idea approved' ? ['drafted'] : ['drafted', 'revised']; const latest = [...receipts].reverse().find(q => q.stage === stage && drafts.includes(q.result)); if (latest && !receipts.some(q => q.idx >= latest.idx && q.stage === stage && asks.includes(q.result) && hasAsk(q))) return `${result}: the question was asked on an earlier ${stage === 'idea' ? 'version of the page' : 'version of the plan'}; record "${stage} ${latest.result}" again with the question ("[ ] ask: …") and ask it`; }
      if (askKey === 'build gate 3') { const ask = lastIdx(receipts, q => q.stage === 'build' && q.result === 'gate 3' && hasAsk(q)); const late = leftoverItems(receipts).filter(x => !x.accepted && x.idx >= ask); if (late.length) return `gate 3: ${late.length} item${late.length > 1 ? 's were' : ' was'} set aside after the question was asked; ask again, naming every item`; }
      if (askKey === 'deploy gate 4') { const ask = lastIdx(receipts, q => q.stage === 'deploy' && q.result === 'gate 4' && hasAsk(q)); if (lastIdx(receipts, isChange) > ask) return 'gate 4: the build changed after the question was asked; run the gates again and ask again'; } }
    else if (/approved$/.test(result)) return `${result} needs the person's answer on one line: "answered: approve" (or yes / accept / looks right)`; }
  const drift = skip => driftOf(dir, st, skip);
  if (stage === 'idea' && /^(drafted|approved|look ready|look approved)$/.test(result)) { const p = lintIdea(dir, idea, { noLook: /^(drafted|approved)$/.test(result) }); if (p.length) return `the Idea page does not pass its check (${p.length}): ${p[0]}`; }
  if (stage === 'idea' && /^drafted$/.test(result)) { const txt = [idea.title, idea.purpose, idea.for, idea.hurts, idea.done, ...idea.journey.map(j => j.caption), ...idea.parts.flatMap(p => [p.title, ...p.prose, ...p.promises.map(x => `${x.text} ${x.number}`)]), ...idea.later, ...idea.never].join('\n'); const w = txt.match(PAGE_WORDS); if (w) return `the page says "${w[0]}"; the person reads this page, so say it in plain words`; }
  const rowsOpen = kind => chooseAttacks(dir, kind).filter(r => { const a = st.attacks.find(x => x.key === `${r.id} ${r.promise}`); const last = a && a.attempts[a.attempts.length - 1]; return !a || (!a.resolved && (!last || last.result === 'broke')); });
  if (stage === 'idea' && /^drafted$/.test(result)) { const qOf = QUESTIONS; const missing = st.flags.questionsMissing || [...Array(qOf)].map((_, i) => i + 1); if (missing.length) return `the interview is not finished: ${qOf - missing.length} of ${qOf} questions answered (missing ${missing.slice(0, 5).join(', ')}${missing.length > 5 ? '…' : ''})`; if ((st.flags.skippedQs || []).includes(9) && idea.parts.some(p => p.screen || p.mock || p.sketch)) return 'question 9 was marked not needed, but a part has a screen; ask it'; if (st.flags.ideaApproved) return 'the page is already approved; changes go through amend'; const open = rowsOpen('idea'); if (open.length && receipts.some(q => q.stage === 'attack' && /^A\d+\s+page\s/.test(q.result))) return `the page cannot be shown while ${open.length} of ${chooseAttacks(dir, 'idea').length} page attacks are not closed on this version of the page (${open.map(r => r.id).join(', ')}); run them, then draft`; }
  if (stage === 'idea' && /^look (ready|approved)$/.test(result)) { if (!lookReopened(receipts)) { if (st.flags.lookApproved || receipts.some(q => q.stage === 'idea' && q.result === 'look approved')) return 'the screens are already approved; changes go through amend'; if (st.flags.planDrafted || st.flags.planApproved) return 'the plan is already drafted on the approved screens; changes go through amend'; const d = drift(['plan', 'spec', 'look']); if (d) return d; } // a change question reopens the look; the amend pins the rest
    if (result === 'look approved') { const lr = [...receipts].reverse().find(q => q.stage === 'idea' && q.result === 'look ready'); const shown = lr && (lr.lines.find(l => /^look-pin:/.test(l.text)) || { text: '' }).text.replace(/^look-pin:\s*/, '').trim(); if (shown && shown !== lookPinOf(dir)) return 'the screens changed since the look question was asked; record "look ready" again with the question and ask it'; } }
  if (stage === 'plan' && /^drafted$/.test(result) && st.flags.planApproved) return 'the plan is already approved; record "plan revised" (steps may only be added)';
  if (stage === 'idea' && /^approved$/.test(result)) { if (drift(['plan', 'spec', 'look'])) return 'the Idea page changed after the person saw it; draft it again'; const open = rowsOpen('idea'); if (open.length) return `idea approved while ${open.length} of ${chooseAttacks(dir, 'idea').length} page attacks are not closed on this version of the page (${open.map(r => r.id).join(', ')})`; }
  if (stage === 'idea' && /^look approved$/.test(result) && (idea.look === 'premium' || idea.look === 'clean')) { for (const part of idea.parts) { if (!(part.screen || part.mock || part.sketch)) continue; if (!part.mock || !fs.existsSync(path.join(dir, part.mock))) return `look approved: part ${part.n} has no mock file`; const ids = part.promises.map(x => x.id); if (!st.attacks.some(a => /^L/.test(a.id) && ids.includes(a.promise) && a.attempts.length && a.attempts[a.attempts.length - 1].result === 'held')) return `look approved: part ${part.n} has no held look-panel receipt (L<n> P<id> attempt <k> held)`; } }
  if (stage === 'idea' && /^approved$/.test(result) && !st.flags.ideaDrafted) return 'idea approved before idea drafted';
  if (stage === 'plan' && /^(drafted|revised)$/.test(result) && !st.flags.planApproved) { const open = rowsOpen('plan'); if (open.length && receipts.some(q => q.stage === 'attack' && /^A\d+\s+plan\s/.test(q.result))) return `the plan cannot be shown while ${open.length} of ${chooseAttacks(dir, 'plan').length} plan attacks are not closed on this version of the plan (${open.map(r => r.id).join(', ')}); run them, then draft`; }
  if (stage === 'plan' && /^(drafted|revised)$/.test(result)) { const openQ = plan.questions.filter(q => !/\(answered/i.test(q.text)); if (openQ.length) return `${openQ.length} question${openQ.length > 1 ? 's' : ''} for the person not yet asked (mark each "- Q<n> (answered) …" after asking): ${openQ[0].text.slice(0, 60)}`; if (!st.flags.ideaApproved) return 'plan drafted before the idea was approved'; if (idea.look && !st.flags.lookApproved) return 'plan drafted before the screens were approved (look approved)'; { const d = drift(['plan', 'spec']); if (d) return d; } const p = planCheck(dir); if (p.length) return `the plan does not pass plan-check (${p.length}): ${p[0]}`; }
  if (stage === 'plan' && /^approved$/.test(result)) { if (!st.flags.planDrafted) return 'plan approved before plan drafted'; if (!plan.steps.length) return 'the plan has no step lines'; const p = planCheck(dir); if (p.length) return `the plan does not pass plan-check (${p.length}): ${p[0]}`; const open = rowsOpen('plan'); if (open.length) return `plan approved while ${open.length} of ${chooseAttacks(dir, 'plan').length} plan attacks are not closed (${open.map(r => r.id).join(', ')})`; if (drift(['idea', 'spec', 'look'])) return 'the plan changed after the person saw it; record "plan revised" and show the screen again'; { const d = drift(['plan', 'spec']); if (d) return d; } if (drift(['plan', 'idea', 'look'])) return 'spec.md changed after the person saw the plan; record "plan revised" and show the screen again'; }
  if (stage === 'plan' && /^revised$/.test(result) && st.flags.planApproved) { if (!has(/^decision:/)) return 'a revision after approval needs a "decision:" line saying what changed and why'; const legacy = legacyProofs(dir); for (const s of plan.steps) { const vp = verifyProblem(s, legacy.has(s.id)); if (vp) return `${s.id}: ${vp}`; }
    const split = (clean.find(l => /^split:/.test(l)) || '').replace(/^split:\s*/, '').trim(); // one step that is not built yet may be split into new steps; nothing else changes
    if (split) { const pins = st.flags.planStepPins || {}; if (!new RegExp(`^${STEP}$`).test(split)) return 'split: names the one step being split, as "split: S<x>.<y>"'; if (!(split in pins)) return `split: ${split} is not a step of the approved plan`; if (plan.steps.some(s => s.id === split)) return `split: ${split} is still in plan.md; a split removes it and adds two or more new steps after the last step of its part`; if (provenIds(receipts, plan).has(split)) return `split: ${split} is proven; only a step that is not built yet can be split`;
      const was = (st.flags.planStepPromises || {})[split]; if (!was || !was.length) return `split: the approved plan does not record which promises ${split} served; go through amend`; const fresh = plan.steps.filter(s => !(s.id in pins)); const got = new Set(fresh.flatMap(s => s.promises));
      if (fresh.length < 2 || got.size !== new Set(was).size || [...got].some(p => !was.includes(p))) return `split: ${split} served ${was.join(', ')}; the new steps (${fresh.map(s => s.id).join(', ') || 'none'}) must be two or more and together serve exactly those promises, and nothing else may change`; }
    for (const [id, pin] of Object.entries(st.flags.stepPins || {})) { const now = plan.steps.find(s => s.id === id); if (!now && id === split) continue; if (!now || !stepPinMatches(now, pin)) return `${id} is already proven and may not change (promises, command or expected output); a different step gets a new number`; } for (const [id, pin] of Object.entries(st.flags.planStepPins || {})) { const now = plan.steps.find(s => s.id === id); if (!now && id === split) continue; if (!now) return `${id} was in the approved plan and is missing; a revision may only add steps or split one step that is not built yet ("split: ${id}", new ids after the last step of its part), so removing or replacing a step goes through amend`; if ((st.flags.planStepsV2 ? stepPin2(now) : stepPin(now)) !== pin) return `${id} changed since the person approved it (text, promises, command, expected output or estimate); a revision may only add steps or split one step that is not built yet ("split: ${id}", new ids after the last step of its part), so a different check gets a new number, or go through amend`; } const lost = idea.promises.filter(p => !plan.steps.some(s => s.promises.includes(p.id))); if (lost.length) return `the revised plan drops ${lost.map(p => p.id).join(', ')}; removing a promise goes through amend`; if (plan.steps.length < st.flags.planSteps) return `a revision after approval may only add steps (${plan.steps.length} < ${st.flags.planSteps}); removing work goes through amend`; const d = drift(['plan']); if (d) return d; }
  if (stage === 'build' && (m = result.match(new RegExp(`^step\\s+(${STEP})\\s+proven$`)))) {
    const step = plan.steps.find(s => s.id === m[1]); if (!step) return `${m[1]} is not a step in plan.md`; if (plan.steps.filter(s => s.id === m[1]).length > 1) return `${m[1]} appears more than once in plan.md; each step needs its own number (plan-check)`;
    if (!st.flags.planApproved) return 'a step cannot be proven before the plan is approved'; { const d = drift(); if (d) return d; }
    const vp = verifyProblem(step, false) || provesNothing(step.verify.cmd, step.verify.expected); if (vp) return `${step.id}: ${vp}; fix the plan first`;
    const run = runOne(step.verify.cmd, opts.cwd || repoOf(dir)); if (!passes(run, step.verify.expected)) return `${step.id}: ran \`${step.verify.cmd}\` → "${run.ok ? run.out.split('\n').pop() : (run.out.split('\n').find(l => /error|fail|not found|cannot/i.test(l)) || run.out.split('\n')[0])}"; expected "${step.verify.expected}"${run.ok ? '' : ' (and it did not exit 0)'}`;
    opts.observed = observedLine(run, step.verify.expected); opts.cmd = step.verify.cmd; opts.stepPin = `v2:${stepPin2(step)}`;
  }
  if (stage === 'build' && /^fix (A|L)\d+/.test(result)) { const id = result.split(/\s+/)[1]; const broke = [...receipts].reverse().find(q => q.stage === 'attack' && new RegExp(`^${id}\\s+(\\S+)\\s+attempt\\s+\\d\\s+broke$`).test(q.result)); // a page or plan attack is fixed by an edit; it adds no check to the gate suite
    if (/^L/.test(id) || (broke && /^(page|plan)$/.test(broke.result.split(/\s+/)[1]))) { if (!has(/^edit:/) && !has(/^check added:/)) return `a fix for a ${/^L/.test(id) ? 'look' : broke.result.split(/\s+/)[1]} attack needs "edit: <what changed>"`; }
    else { if (!has(/^check added:/)) return 'a fix needs "check added: <path>"'; if (!has(/^red:/)) return 'a fix needs "red: <command> → <output on the old code>"'; } }
  if (stage === 'attack') {
    const am = result.match(/^((?:A|L)\d+)\s+(P\d+\.\d+|all|page|plan)\s+attempt\s+([123])\s+(held|broke|resolved)$/); if (!am) return 'an attack receipt reads "A<n> <P<id>|all|page|plan> attempt <1|2|3> <held|broke|resolved>"';
    const [, id, promise, k, res] = am; if (/^P/.test(promise) && !idea.promises.find(p => p.id === promise)) return `${promise} is not on the Idea page`;
    const rows = chooseAttacks(dir, promise === 'page' ? 'idea' : promise === 'plan' ? 'plan' : 'build'); /* the script's own choice, never attacks.md as it is on disk */ if (!/^L/.test(id) && rows.length && !rows.find(r => r.id === id && r.promise === promise)) return `${id} ${promise} is not a chosen attack`; { const d = drift(promise === 'page' ? ['idea', 'look'] : promise === 'plan' ? ['plan', 'spec'] : []); if (d) return d; } // a page or plan attack runs on the draft being prepared
    if (/^L/.test(id)) { const part = idea.parts.find(pt => pt.promises.some(x => x.id === promise)); if (!part || !(part.screen || part.mock || part.sketch)) return `${promise} is not a promise of a screen part; look receipts are for screens only`; }
    if (res === 'broke' && !has(/^reproduction:/)) return 'a broke receipt needs "reproduction: <command> → observed <x>, expected <y>"';
    if (res !== 'resolved' && !has(/^class:/)) return 'an attack receipt needs "class: <catalogue key>"';
    { const row = !/^L/.test(id) && rows.find(r => r.id === id && r.promise === promise); const c = clean.find(l => /^class:/.test(l)); const k = c && c.replace(/^class:\s*/, '').split(/\s*·\s*/)[0].trim(); if (row && c && k !== row.key) return `${id} ${promise} is a ${row.key} attack in attacks.md; this receipt says class ${k}`; }
    if (/^A/.test(id) && /^(P|all$)/.test(promise)) { const p = promise === 'all' ? { steps: st.steps.total, done: st.steps.proven } : st.promises.find(x => x.id === promise) || { steps: 0, done: 0 }; if (!p.steps || p.done < p.steps) return `${id} ${promise} attacks code that is not built yet (${p.done} of ${p.steps} step${p.steps === 1 ? '' : 's'} proven); attack it once its steps are proven`; }
    const prior = st.attacks.find(a => a.key === `${id} ${promise}`); const last = prior && prior.attempts[prior.attempts.length - 1];
    if (+k === 3) { const two = prior && [...prior.attempts].reverse().find(x => x.k === 2 && x.result === 'broke'); if (!two) return 'attempt 3 needs attempt 2 broke first'; // the question after attempt 2 broke, then one whole-line "try once more", and no Move on for it
      { const sb = r => r.stage === 'build' && r.result === `second break at ${id}`; const askR = receipts.find(r => r.idx > two.idx && sb(r) && hasAsk(r)); const yesR = askR && receipts.find(r => r.idx > askR.idx && sb(r) && r.lines.filter(l => /^answered:/.test(l.text)).length === 1 && r.lines.some(l => /^answered:\s*try once more\s*[.!]?$/i.test(l.text)));
        const movedOn = receipts.some(r => r.idx > two.idx && r.stage === 'attack' && r.result === `${id} ${promise} attempt 2 resolved`); if (!yesR || movedOn) return `attempt 3 needs the person's "try once more" to the second-break question: receipt <dir> build "second break at ${id}" "[ ] ask: …", then receipt <dir> build "second break at ${id}" "answered: try once more"${movedOn ? '; the person already chose Move on for it' : ''}`; } if (res !== 'resolved' && last && last.k === 3) return 'attempt 3 was already recorded for this attack'; }
    if (res === 'resolved') { if (!(last && last.k === +k && last.k >= 2 && last.result === 'broke')) return `resolved needs attempt ${k} broke first`; { const a = clean.filter(l => /^answered:/.test(l)); if (a.length !== 1 || !YES.test(a[0])) return 'resolved needs exactly one answer line, the person\'s yes ("answered: move on")'; } if (!has(/^leftover:/)) return 'resolved needs a "leftover:" line naming what ships as it is'; }
    else if (+k === 2) { if (!(last && last.k === 1 && last.result === 'broke')) return 'attempt 2 needs attempt 1 broke first'; if (!receipts.some(r => r.stage === 'build' && r.result === `fix ${id}` && r.idx > last.idx)) return `attempt 2 needs a "fix ${id}" receipt after attempt 1`; }
    if (+k === 1 && last) return 'attempt 1 was already recorded for this attack';
  }
  if (stage === 'build' && /^gate 3$/.test(result)) { if (has(/^ask:/) && !st.leftovers.length) return 'gate 3 asks the person to accept what was set aside, and nothing is set aside';
    if (has(/^ask:/)) { const acc = new Set(leftoverItems(receipts).filter(x => x.accepted).map(x => x.idx)); if (st.leftovers.every(L => acc.has(L.at))) return 'gate 3: nothing is waiting for your acceptance; every set-aside item was accepted at its second break'; } const d = drift(); if (d) return d; }
  if (stage === 'build' && (m = result.match(/^second break at ((?:A|L)\d+)$/)) && has(/^answered:/)) { const id = m[1]; const ans = clean.filter(l => /^answered:/.test(l)); // the second-break question takes one answer here: try once more
    if (ans.length > 1) return 'one answered: line per receipt'; if (!/^answered:\s*try once more\s*[.!]?$/i.test(ans[0])) return 'the second-break answer recorded here is only "answered: try once more"; Move on is recorded on attempt 2 resolved, and Leave this promise out goes through amend';
    const o = openAsk(receipts, r => r.stage === 'build' && r.result === `second break at ${id}`, r => (r.stage === 'build' && r.result === `second break at ${id}`) || (r.stage === 'attack' && new RegExp(`^${id}\\s+\\S+\\s+attempt\\s+[23]\\s+resolved$`).test(r.result)));
    if (!o) return `second break at ${id}: the question was never recorded (receipt <dir> build "second break at ${id}" "[ ] ask: …") before the answer`; if (o.answered || o.stale) return `second break at ${id}: that question was already answered; ask it again before recording a new answer`; }
  if (stage === 'deploy' && /^(gate 4|released|writeback)$/.test(result)) {
    if (!(st.steps.total && st.steps.proven === st.steps.total)) return `cannot ${result}: ${st.steps.proven} of ${st.steps.total} steps proven`;
    { const legacy = legacyProofs(dir); for (const s of plan.steps) { const vp = verifyProblem(s, legacy.has(s.id)) || provesNothing(s.verify.cmd, s.verify.expected); if (vp) return `cannot ${result}: ${s.id}: ${vp}`; } } { const d = drift(); if (d) return `cannot ${result}: ${d}`; }
    if (st.leftovers.length && !st.flags.gate3) return `cannot ${result}: ${st.leftovers.length} item${st.leftovers.length > 1 ? 's' : ''} set aside and not yet accepted by the person (gate 3)`;
    if (/^gate 4$/.test(result) && !(st.flags.preflight && st.flags.rehearsal)) return 'gate 4 comes after the safety checks and the rehearsed undo';
    const chosen = chooseAttacks(dir, 'build'); const expected = chosen.map(r => `${r.id} ${r.promise} ${r.key}`).join('\n'); const onDisk = attackRows(dir).filter(r => /^(P|all)/.test(r.promise)).map(r => `${r.id} ${r.promise} ${r.key}`).join('\n'); if (onDisk !== expected) return `cannot ${result}: attacks.md does not match the chosen set for this page and spec; run attacks <dir> build and close every row`;
    { const wrong = chosen.map(r => ({ r, a: st.attacks.find(x => x.key === `${r.id} ${r.promise}`) })).find(({ r, a }) => a && a.klass && a.klass !== r.key); if (wrong) return `cannot ${result}: ${wrong.r.id} ${wrong.r.promise} is a ${wrong.r.key} attack, but its receipts say class ${wrong.a.klass}; run it again as ${wrong.r.key}`; } // the script's own choice, never attacks.md as it is on disk
    const rows = chosen.filter(r => /^(P|all)/.test(r.promise)); const openRows = rows.filter(r => { const a = st.attacks.find(x => x.key === `${r.id} ${r.promise}`); const last = a && a.attempts[a.attempts.length - 1]; return !a || (!a.resolved && (!last || last.result === 'broke')); });
    if (rows.length && openRows.length) return `cannot ${result}: ${openRows.length} attack${openRows.length > 1 ? 's' : ''} not closed (${openRows.slice(0, 3).map(r => r.id + ' ' + r.promise).join(', ')})`;
    if (!rows.length) return `cannot ${result}: no attacks were chosen (run attacks <dir> build and the protocol first)`;
    if (st.flags.gatesGreenAt <= st.flags.lastProvenAt) return `cannot ${result}: the gate suite has not run green since the last proven step (gates <dir> --run --record)`;
    if (st.flags.lastRunRed) return `cannot ${result}: the last recorded gate run is red; fix the red checks, then run gates <dir> --run --record again`;
    { const at = pred => lastIdx(receipts, pred); const proved = at(q => q.stage === 'build' && new RegExp(`^step\\s+${STEP}\\s+proven$`).test(q.result)), fixed = at(q => q.stage === 'build' && /^fix\s+(A|L)\d+/.test(q.result)), amended = at(isAmendEdit), revised = at(q => q.stage === 'plan' && q.result === 'revised'), attacked = at(q => q.stage === 'attack');
      const field = (q, k) => ((q.lines.find(l => l.text.startsWith(`${k}:`)) || { text: '' }).text).slice(k.length + 1).trim(); const onRoot = q => { const on = field(q, 'ran on'); return !!on && !/^https?:\/\//.test(on) && samePath(on, repoOf(dir)); };
      const greens = receipts.filter(q => (q.stage === 'build' || q.stage === 'deploy') && q.result === 'gates green'); const gg = [...greens].reverse().find(onRoot), lastGreen = greens[greens.length - 1]; const changed = at(isChange); // only a run on this project opens the gate
      if (!gg || gg.idx < changed) { if (lastGreen && lastGreen.idx > changed && !onRoot(lastGreen)) return `cannot ${result}: the last green gate run was on ${field(lastGreen, 'ran on') || 'a place it does not name'}, not on this project; a run on a web address is recorded but does not open the gate; run gates <dir> --run --record`; return `cannot ${result}: the gate suite has not run green since the last change (a proven step, a fix, a revised plan, an amend or an attack); run gates <dir> --run --record`; }
      { const root = repoOf(dir); if (!field(gg, 'at commit') || field(gg, 'at commit') !== gitHead(root) || field(gg, 'tree') !== 'clean' || treeState(root) !== 'clean') return `cannot ${result}: the code changed since the last green run; run the gate suite again (gates <dir> --run --record)`; }
      if (at(q => q.stage === 'deploy' && q.result === 'preflight') < Math.max(proved, fixed, amended, revised, attacked)) return `cannot ${result}: the safety checks ran before the last change; run preflight <dir> --record again`;
      if (/^(released|writeback)$/.test(result) && !st.flags.gate4) return `cannot ${result}: the go-ahead (gate 4) is missing, was a no, or came before the last change; ask gate 4 again`; }
  }
  if (stage === 'deploy' && /^released$/.test(result) && !(st.flags.preflight && st.flags.rehearsal && st.flags.gate4)) return 'released needs preflight, rehearsal and an answered gate 4 first';
  if (stage === 'deploy' && /^writeback$/.test(result)) { if (!st.flags.released) return 'writeback before released'; // the live numbers measure what was released, after the last change
    const rel = lastIdx(receipts, q => q.stage === 'deploy' && q.result === 'released'), chg = lastIdx(receipts, q => (q.stage === 'build' && (new RegExp(`^step\\s+${STEP}\\s+proven$`).test(q.result) || /^fix\s+(A|L)\d+/.test(q.result))) || isAmendEdit(q)); if (rel < chg) return 'writeback before released: a step was proven, a fix made or the page amended after the last release; release the change first (gate 4, then released)'; }
  if (stage === 'amend' && !/^part\s+\d+\s+edited$/.test(result)) return 'an amend receipt reads "part <n> edited"';
  if (stage === 'amend' && (m = result.match(/^part\s+(\d+)\s+edited$/))) {
    const N = +m[1]; const partOf = id => +((String(id).match(/^P(\d+)\./) || [])[1]);
    if (!has(/^decision:/)) return 'an amend needs a "decision:" line'; const ans = clean.filter(l => /^answered:/.test(l)); if (!ans.length) return 'an amend needs the person\'s words on an "answered:" line'; if (ans.length > 1) return 'one answered: line per receipt';
    if (AMEND_NO.test(ans[0])) return `"${ans[0]}" keeps the page as it is; record it under the question's own receipt and change nothing`;
    if (!idea.parts.some(p => p.n === N) && !Object.keys(st.flags.ideaPromises || {}).some(id => partOf(id) === N)) return `there is no part ${N} on the Idea page (parts ${idea.parts.map(p => p.n).join(', ') || 'none'})`;
    { const lastAmend = lastIdx(receipts, q => q.stage === 'amend' && /^part\s+\d+\s+edited$/.test(q.result)); const q = [...receipts].reverse().find(q => (q.stage === 'amend' || q.stage === 'build') && q.idx > lastAmend && hasAsk(q));
      if (!q) return 'an amend answers a question; record it first: receipt <dir> build "change asked" "[ ] ask: Part <n>: <the change>. Build it as written, or change the page? · Build it as written (Recommended) → nothing on your page changes · Change the page → that part is re-planned and rebuilt"';
      if (receipts.some(r => r.idx > q.idx && (r.stage === 'amend' || r.stage === 'build') && hasAnswer(r))) return 'that question was already answered (an answer, yes or no, uses it up); ask it again before changing the page';
      const options = splitAsk(askLineOf(q)).options.filter(o => o.label); const pick = options.find(o => normLabel(o.label) === normLabel(ans[0])); // the person's choice, word for word
      if (!pick) return `"${ans[0].replace(/^answered:\s*/, '')}" is not one of the question's options (${options.map(o => o.label.replace(/\s*\(Recommended\)/i, '')).join(' · ')}); record the person's choice word for word`;
      if (STAY.test(pick.label)) return `"${pick.label.replace(/\s*\(Recommended\)/i, '')}" keeps the page as it is; record it under the question's own receipt and change nothing`; }
    const sup = (clean.find(l => /^supersede:/.test(l)) || '').replace(/^supersede:\s*/, '').split(/[\s,]+/).filter(Boolean);
    for (const id of sup) { if (/^P\d+\.\d+$/.test(id)) { const p = idea.promises.find(x => x.id === id); if (!p) return `supersede names ${id}, not a promise on the Idea page`; if (p.part !== N) return `supersede names ${id}, a promise of part ${p.part}, not part ${N}`; continue; } const step = plan.steps.find(s => s.id === id); if (!step) return `supersede names ${id}, not a step in plan.md`; if (!step.promises.some(p => (idea.promises.find(x => x.id === p) || {}).part === N)) return `supersede names ${id}, which serves no promise of part ${N}`; }
    const ch = changesSince(dir, st, plan, idea);
    if (ch.known && !ch.any) return 'nothing changed since the person last saw the page and the plan; make the change first (answer, plan.md), then record the amend';
    for (const s of ch.steps) { if (!s.promises) continue; const parts = [...new Set(s.promises.map(partOf))]; if (!parts.includes(N)) return `${s.id} ${s.removed ? 'was removed' : s.added ? 'was added' : 'changed'} and serves part ${parts.join(', ') || 'none'}; an amend of part ${N} changes part ${N} only`; }
    for (const p of ch.promises) if (partOf(p.id) !== N) return `${p.id} ${p.removed ? 'was removed' : p.added ? 'was added' : 'changed'}; it belongs to part ${partOf(p.id)}, and an amend of part ${N} changes part ${N} only`;
    const proven = provenIds(receipts, plan);
    for (const s of ch.steps.filter(s => !s.removed && !s.added && proven.has(s.id))) if (!sup.includes(s.id) && !s.promises.some(p => sup.includes(p))) return `${s.id} is proven and changed; list it on "supersede:" so it is proven again`;
    for (const p of ch.promises.filter(p => !p.removed && !p.added)) if (!sup.includes(p.id) && !plan.steps.some(s => s.promises.includes(p.id) && sup.includes(s.id))) return `${p.id} changed; list it on "supersede:" so its old proof and live number are dropped`;
  }
  { const notQ = r => !/^question\s+\d+\s+of\s+\d+/.test(r.result); const same = (s, re) => r => r.stage === s && re.test(r.result); // an approval or a gate yes answers a question of its kind that nothing answered yet, asked after the last amend
    const KIND = { 'idea approved': { ask: same('idea', /^drafted$/), ans: r => r.stage === 'idea' && notQ(r), name: 'idea drafted' }, 'idea look approved': { ask: same('idea', /^look ready$/), ans: r => r.stage === 'idea' && notQ(r), name: 'idea look ready' }, 'plan approved': { ask: same('plan', /^(drafted|revised)$/), ans: r => r.stage === 'plan', name: 'plan drafted' }, 'build gate 3': { ask: same('build', /^gate 3$/), ans: same('build', /^gate 3$/), name: 'build gate 3' }, 'deploy gate 4': { ask: same('deploy', /^gate 4$/), ans: same('deploy', /^gate 4$/), name: 'deploy gate 4' } }[`${stage} ${result}`];
    const a = clean.find(l => /^answered:/.test(l)); if (KIND && a && YES.test(a)) { const o = openAsk(receipts, KIND.ask, KIND.ans); if (o && (o.answered || o.stale)) return `${result}: ${o.answered ? 'that question was already answered (an answer, yes or no, uses it up)' : 'the page or the plan was amended after that question was asked'}; record the question again (receipt <dir> ${KIND.name.replace(' ', ' "')}" "[ ] ask: …") and ask it`; } }
  if (stage === 'deploy' && result === 'released') { // the record runs the release command itself, as it runs a step's proof
    const line = clean.find(l => /→/.test(l) && !/^(switch|decision|answered|note|cause|leftover):/i.test(l)); const mm = line && line.match(/^(?:[a-z][\w-]*:\s+)?`?([^`→]+?)`?\s*→\s*(.+)$/);
    if (!mm) return 'released needs the release command and what it prints: "<command> → <expected output>"; the record runs it';
    const cmd = mm[1].trim(), expected = mm[2].trim(); const tr = verifyProblem({ verify: { cmd, expected } }, false) || provesNothing(cmd, expected); if (tr) return `the release command ${tr}`;
    const run = runOne(cmd, opts.cwd || repoOf(dir)); if (!passes(run, expected)) return `released: ran \`${cmd}\` → "${run.ok ? run.out.split('\n').pop() : (run.out.split('\n').find(l => /error|fail|not found|cannot/i.test(l)) || run.out.split('\n')[0])}"; expected "${expected}"${run.ok ? '' : ' (and it did not exit 0)'}`;
    opts.ranLine = { typed: line, text: `ran: ${cmd} → ${observedLine(run, expected)}` };
  }
  return null;
}

// ---------- card ----------
const dot = { planned: '', building: 'b', built: 'b', held: 'h', fixed: 'h', live: 'l', broke: 'x', 'needs you': 'x', 'live ✗': 'x' };
function shotsFor(dir, prefix) { const d = path.join(dir, 'shots'); if (!fs.existsSync(d)) return []; return fs.readdirSync(d).filter(f => f.endsWith('.png') && (!prefix || f.startsWith(prefix))).sort().map(f => ({ name: f.replace(/\.png$/, ''), uri: `data:image/png;base64,${fs.readFileSync(path.join(d, f)).toString('base64')}` })); }
function shotRows(shots, stripPrefix) {
  const order = ['as it opens', 'first', 'empty', 'loading', 'long', 'error']; const groups = {};
  for (const s of shots) { const n = s.name.replace(stripPrefix, ''); const m = n.match(/^(.*?)-?(phone|desktop)$/); const key = m ? (m[1] || 'as it opens') : n; (groups[key] = groups[key] || {})[m ? m[2] : 'phone'] = s; }
  const split = k => { const sm = k.match(/^(.*?)-?(empty|loading|error|long|first)$/); return sm ? { screen: sm[1], state: sm[2] } : { screen: k === 'as it opens' ? '' : k, state: 'as it opens' }; };
  const screens = new Set(Object.keys(groups).map(k => split(k).screen)); const label = k => { const { screen, state } = split(k); return screens.size > 1 && screen ? `${screen.replace(/-/g, ' ')} · ${state}` : state; };
  const keys = Object.keys(groups).sort((a, b) => (order.indexOf(split(a).state) + 1 || 99) - (order.indexOf(split(b).state) + 1 || 99));
  const row = (state, g) => `<div class="shot-row"><div class="shot-label">${esc(label(state))}</div>${g.phone ? `<figure class="phone"><img src="${g.phone.uri}" alt="${esc(state)} on a phone"><figcaption>phone</figcaption></figure>` : ''}${g.desktop ? `<figure class="desk"><img src="${g.desktop.uri}" alt="${esc(state)} on a desktop"><figcaption>desktop</figcaption></figure>` : ''}</div>`;
  const shown = keys.slice(0, 2).map(k => row(k, groups[k])).join(''); const rest = keys.slice(2);
  return shown + (rest.length ? `<details><summary>${rest.length} more state${rest.length > 1 ? 's' : ''}: ${rest.map(label).join(', ')}</summary>${rest.map(k => row(k, groups[k])).join('')}</details>` : '');
}
function renderCard(st, dir) {
  const tpl = read(path.join(PLUGIN_ROOT, 'templates', 'card.html')); const pct = st.steps.total ? Math.round(100 * st.steps.proven / st.steps.total) : 0;
  const parts = st.parts.map(p => `<div class="part"><h3>Part ${p.n} · ${esc(p.title)}</h3>${st.promises.filter(x => x.part === p.n).map(x => `<div class="row"><i class="dot ${dot[x.state] || ''}"></i><span>${esc(x.text)}</span><span class="st ${/held|fixed|^live$/.test(x.state) ? 'h' : ''}${/broke|needs|✗/.test(x.state) ? ' x' : ''}">${esc(x.live ? `live: ${x.live.value} ${x.live.ok ? '✓' : '✗'}` : x.unmeasured ? 'not yet measured' : x.plain)}</span></div>`).join('')}</div>`).join('')
    + (st.productAttacks.length ? `<div class="part"><h3>Whole product</h3>${st.productAttacks.filter(a => a.last).map(a => `<div class="row"><i class="dot ${a.last.result === 'held' ? 'h' : 'x'}"></i><span>${esc(className(a.klass) || 'whole-product check')}</span><span class="st ${a.last.result === 'held' ? 'h' : 'x'}">${a.last.result === 'held' ? 'tested, passed' : 'broke, being fixed'}</span></div>`).join('')}</div>` : '');
  const plan = parsePlan(read(path.join(dir || '', 'plan.md'))); const sk = plan.slices[0]; const provenIds = new Set(); for (const s of plan.steps) { /* mark proven via state counts */ }
  const stepDone = id => st.slices.some(sl => sl.n === (plan.steps.find(x => x.id === id) || {}).slice && false);
  const doneSteps = new Set(parseReceipts(read(path.join(dir || '', 'receipts.md'))).filter(r => r.stage === 'build' && /^step\s+\S+\s+proven$/.test(r.result)).map(r => r.result.split(/\s+/)[1]));
  const ideaX = parseIdea(read(path.join(dir || '', 'idea.md'))); const byPart = stepsByPart(plan, ideaX); const cnt = steps => steps.length ? `${steps.filter(x => doneSteps.has(x.id)).length} of ${steps.length} step${steps.length === 1 ? '' : 's'}` : 'no steps yet';
  const slices = !plan.steps.length ? '<p class="sub">The plan comes next.</p>' : (byPart[0].length ? `<div class="slice sk"><span>First, a thin version of the whole thing, so problems show early (${byPart[0].length} of the steps below)</span><span class="n">${byPart[0].filter(x => doneSteps.has(x.id)).length} of ${byPart[0].length} done</span></div>` : '') + st.parts.map(p => `<div class="slice"><span class="k">${p.n}</span><span>${esc(p.title)}</span><span class="n">${cnt(byPart[p.n] || [])}</span></div>`).join('');
  const bar = plan.steps.length ? `<div class="bar"><i style="width:${pct}%"></i></div><p class="sub">${pct}% of the steps proven</p>` : '';
  const risks = st.risks.slice(0, 3).map((r, i) => `<div><i>${i + 1}</i><span>${esc(r.text)}</span></div>`).join('');
  const decisions = st.decisions.length ? st.decisions.map(d => `<div><time>${esc(day(d.ts))}</time><span>${esc(d.text)}</span></div>`).join('') : '<p class="empty">None yet.</p>';
  const leftovers = st.leftovers.length ? st.leftovers.map(d => `<div><time>${esc(day(d.ts))}</time><span>${esc(d.text)}</span></div>`).join('') : '<p class="empty">Nothing set aside. Items appear here when a problem is accepted in writing.</p>';
  const counts = {}; for (const p of st.promises) counts[p.plain] = (counts[p.plain] || 0) + 1; const summary = `${st.promises.length} promises: ${Object.entries(counts).map(([k, v]) => `${v} ${k}`).join(', ')}`;
  const ask = st.ask ? `<div class="ask"><h2>For you</h2><b>${esc(st.ask)}</b>${(st.askOptions || []).map(o => `<div class="opt"><span>${esc(o.label)}</span><span>${esc(o.consequence)}</span></div>`).join('')}</div>` : '';
  const shots = dir ? shotsFor(dir, 'final-') : []; const shotsHtml = shots.length ? `<div><h2>Screens as built</h2><div class="shots">${shotRows(shots, 'final-')}</div></div>` : '';
  return tpl.replace(/\{\{(\w+)\}\}/g, (_, k) => ({ TITLE: esc(st.title), LINE: esc(st.lineBare.replace(/ · your card: \S+$/, '')), PCT: pct, BAR: bar, ASK: ask, SLICES: slices, RISKS: risks ? `<h2 style="margin-top:6px">The biggest risks, and what I do about each</h2><div class="risks">${risks}</div>` : '', PAGE: st.page && /^https?:/.test(st.page) ? `<a href="${esc(st.page)}">Idea page</a>` : '', PARTS: parts, SUMMARY: esc(summary), DECISIONS: decisions, NDEC: st.decisions.length, LEFTOVERS: leftovers, NLEFT: st.leftovers.length, SHOTS: shotsHtml, VERSION: `v${st.version}` }[k] ?? ''));
}

// ---------- idea page ----------
function renderIdeaPage(dir, idea, st) {
  const tpl = read(path.join(PLUGIN_ROOT, 'templates', 'idea-page.html')); const lib = JSON.parse(read(path.join(PLUGIN_ROOT, 'templates', 'pictures.json')));
  const live = {}; if (st) for (const p of st.promises) if (p.live) live[p.id] = p.live; const anyLive = Object.keys(live).length > 0;
  const own = rel => (insideDir(dir, rel) ? read(path.join(dir, rel)) : ''); // only files inside the build folder reach the published page
  const pic = (key, label) => key.startsWith('file:') ? own(key.slice(5)) : `<svg viewBox="0 0 240 160" role="img" aria-label="${esc(label)}">${lib[key] || ''}</svg>`;
  const parts = idea.parts.map(p => {
    const promises = p.promises.map((x, i) => { const l = live[x.id]; const badge = l ? `<span class="n">${esc(x.number)}</span><span class="live${l.ok ? '' : ' bad'}">live: ${esc(l.value)} ${l.ok ? '✓' : '✗'}</span>` : anyLive ? `<span class="n">${esc(x.number)}</span><span class="n muted">not yet measured</span>` : `<span class="n">${esc(x.number)}</span>`; return `<li><span class="tick">${i + 1}</span><span>${esc(x.text)}</span>${badge}</li>`; }).join('');
    let look = ''; const shots = shotsFor(dir, `part-${p.n}-`); const screensWord = st && st.flags && st.flags.lookApproved ? 'approved' : 'proposed';
    if (p.mock && shots.length) look = `<div class="sketch"><div class="plabel">How it will look · the ${screensWord} screens</div><div class="shots">${shotRows(shots, `part-${p.n}-`)}</div></div>`;
    else if (p.mock) look = `<div class="sketch"><div class="plabel">How it will look · the ${screensWord} mock</div><iframe class="mock" title="mock of ${esc(p.title)}" srcdoc="${esc(own(p.mock))}"></iframe></div>`;
    else if (p.sketch) look = `<div class="sketch"><div class="plabel">How it will look</div><div class="sk">${own(p.sketch)}</div></div>`;
    return `<section id="part-${p.n}"><div class="part"><figure>${pic(p.picture, p.title)}</figure><div class="words"><div class="eyebrow">Part ${p.n}</div><h2>${esc(p.title)}</h2>${p.prose.map(t => `<p>${esc(t)}</p>`).join('')}<div class="plabel">What you will be able to do</div><ul class="promises">${promises}</ul></div></div>${look}</section>`;
  }).join('');
  const openHtml = (idea.open || []).length ? `<section id="settled"><div class="eyebrow">Settled along the way</div><h2>What we decided</h2><ul class="settled">${idea.open.map(x => { const at = x.lastIndexOf('→'); return at < 0 ? `<li>${esc(x)}</li>` : `<li><b>${esc(x.slice(0, at).trim())}</b> ${esc(x.slice(at + 1).trim())}</li>`; }).join('')}</ul></section>` : '';
  const out = (idea.later.length || idea.never.length) ? `<section id="out"><div class="eyebrow">Out, for now</div><h2>What this will not do</h2>${idea.later.length ? `<div class="plabel">Later</div><div class="never">${idea.later.map(x => `<span>${esc(x)}</span>`).join('')}</div>` : ''}${idea.never.length ? `<div class="plabel">Never</div><div class="never out">${idea.never.map(x => `<span>${esc(x)}</span>`).join('')}</div>` : ''}</section>` : '';
  const hero = idea.journey.length ? `<div class="journey">${idea.journey.map((j, i) => `<div class="step"><div class="pic">${pic(j.picture, j.caption)}</div><div class="cap"><span class="k">${i + 1}</span>${esc(j.caption)}</div></div>`).join('')}</div>` : '';
  const exists = idea.exists ? `<div class="exists"><div><b>What you use today</b>${esc(idea.exists)}</div><div><b>Why build this anyway</b>${esc(idea.because)}</div></div>` : '';
  const who = [['Who it is for', idea.for], ['What hurts today', idea.hurts], ['Done means', idea.done]].filter(([, v]) => v).map(([k, v]) => `<div><b>${k}</b>${esc(v)}</div>`).join('');
  const fmt = d => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }); const approvedR = st && st.flags && st.flags.ideaApproved ? parseReceipts(read(path.join(dir, 'receipts.md'))).filter(r => r.stage === 'idea' && r.result === 'approved').pop() : null;
  const date = approvedR ? `approved ${fmt(new Date(approvedR.ts))}` : `draft · ${fmt(new Date())}`;
  return tpl.replace(/\{\{(\w+)\}\}/g, (_, k) => ({ TITLE: esc(idea.title), PURPOSE: esc(idea.purpose), FOR: esc(idea.for), HURTS: esc(idea.hurts), DONE: esc(idea.done), EXISTS: exists, VERSION: `v${st ? st.version : 1}`, DATE: date, HERO: hero, PARTS: parts, OUT: out, NPROMISES: idea.promises.length, NPARTS: idea.parts.length, WHO: who, OPEN: openHtml, COUNTS: idea.promises.length ? `<span>${idea.promises.length} promise${idea.promises.length === 1 ? '' : 's'} across ${idea.parts.length} part${idea.parts.length === 1 ? '' : 's'}, each with a number</span>` : '', CARDLINK: idea.card ? `<span><a href="${esc(idea.card)}">Your live card</a></span>` : '', LIVENOTE: anyLive ? `<span>${Object.values(live).filter(l => l.ok).length} of ${idea.promises.length} promises measured on the live system</span>` : '' }[k] ?? ''));
}

// ---------- spec ----------
function specCheck(dir) {
  const text = read(path.join(dir, 'spec.md')); if (!text) return ['spec.md missing'];
  const idea = parseIdea(read(path.join(dir, 'idea.md'))); const ids = new Set(idea.promises.map(p => p.id)); const problems = []; let section = '', rules = 0;
  for (const line of lines(text)) { const h = line.match(/^##\s+(.+)$/); if (h) { section = h[1].trim(); continue; } if (/^-\s+/.test(line) && /^Rules/i.test(section)) { rules++; const m = line.match(/→\s*(P\d+\.\d+)\s*$/); if (!m) problems.push(`rule without a promise pointer: ${line.slice(0, 60)}`); else if (!ids.has(m[1])) problems.push(`rule points at ${m[1]}, which is not on the Idea page: ${line.slice(0, 50)}`); } }
  if (!/^##\s+Rules/m.test(text)) problems.push('no ## Rules section'); else if (!rules) problems.push('## Rules is empty');
  if (!/^##\s+Assumptions/m.test(text)) problems.push('no ## Assumptions section');
  return problems;
}

// ---------- attacks ----------
function parseCatalogue() {
  const text = read(path.join(PLUGIN_ROOT, 'shared', 'failure-catalogue.md')); const classes = []; let cur = null;
  for (const line of lines(text)) { const h = line.match(/^##\s+([a-z-]+)\s*$/); if (h) { cur = { key: h[1], likely: {}, applies: [], stages: ['build'] }; classes.push(cur); continue; } if (!cur) continue; const kv = line.match(/^(name|scope|stage|damage|applies|likely|attack|break|check):\s*(.+)$/); if (!kv) continue; if (kv[1] === 'damage') cur.damage = +kv[2]; else if (kv[1] === 'applies') cur.applies = kv[2].split(/\s+/); else if (kv[1] === 'stage') cur.stages = kv[2].split(/\s+/); else if (kv[1] === 'likely') for (const pair of kv[2].split(/\s+/)) { const [k, v] = pair.split('='); cur.likely[k] = +v; } else cur[kv[1]] = kv[2].trim(); }
  return classes;
}
const KEYWORDS = { 'wrong-output': /\b(match|matches|correct|exact|rupee|difference|total|sum|count|number)\b/i, 'missing-output': /\b(every|all|100%|none|skipped|appears)\b/i, 'duplicate-output': /\b(once|one message|twice|duplicate|single)\b/i, 'stale-data': /\b(fresh|latest|today|current|updates?|within)\b/i, 'bad-input': /\b(paste|type|typed|input|upload|any link|any file)\b/i, 'retry': /\b(again|retry|rerun|re-run|twice|idempotent)\b/i, 'silent-failure': /\b(error|fails?|cannot|can't|never silently|tells you)\b/i };
const TIME_OR_VOLUME = /\b\d{2,}\s*(rows|items|users|files|links|pdfs|people|records|per)\b|\b(thousand|million)\b/i;
const specKind = dir => { const m = read(path.join(dir, 'spec.md')).match(/^##\s+Kind\s*\n-\s*(\w+)/m); return m ? m[1].toLowerCase() : 'mixed'; };
function chooseAttacks(dir, stage) {
  const classes = parseCatalogue();
  if (stage === 'idea' || stage === 'plan') return classes.filter(c => c.stages.includes(stage)).map((c, i) => ({ id: `A${i + 1}`, promise: stage === 'idea' ? 'page' : 'plan', key: c.key, name: c.name, when: stage }));
  const idea = parseIdea(read(path.join(dir, 'idea.md'))); const kind = specKind(dir); const kinds = kind === 'mixed' ? ['visual', 'data', 'service'] : [kind];
  const build = classes.filter(c => c.stages.includes('build')); const fits = c => kinds.some(k => c.applies.includes(k)); const likely = c => Math.max(...kinds.map(k => c.likely[k] || 0)); const byKey = Object.fromEntries(build.map(c => [c.key, c]));
  const rows = []; let n = 1; const screenDone = new Set();
  const namesVolume = idea.promises.some(p => TIME_OR_VOLUME.test(p.text + ' ' + p.number));
  for (const c of build.filter(c => c.scope === 'product' && fits(c) && (c.key !== 'load' || namesVolume)).sort((a, b) => b.damage * likely(b) - a.damage * likely(a))) rows.push({ id: `A${n++}`, promise: 'all', key: c.key, name: c.name, when: 'last part', score: c.damage * likely(c) });
  for (const p of idea.promises) {
    const part = idea.parts.find(x => x.n === p.part); const forced = [];
    if (part && (part.screen || part.mock || part.sketch) && byKey['picture-mismatch'] && !screenDone.has(part.n)) { forced.push('picture-mismatch'); screenDone.add(part.n); }
    if (TIME_OR_VOLUME.test(p.text + ' ' + p.number) && byKey['load']) forced.push('load');
    for (const k of forced) rows.push({ id: `A${n++}`, promise: p.id, key: k, name: byKey[k].name, when: `part ${p.part}`, forced: true });
    const scored = build.filter(c => c.scope !== 'product' && c.key !== 'picture-mismatch' && fits(c) && !forced.includes(c.key)).map((c, i) => ({ c, i, score: c.damage * likely(c) + (KEYWORDS[c.key] && KEYWORDS[c.key].test(p.text + ' ' + p.number) ? 12 : 0) })).sort((a, b) => b.score - a.score || a.i - b.i).slice(0, 2);
    for (const s of scored) rows.push({ id: `A${n++}`, promise: p.id, key: s.c.key, name: s.c.name, when: `part ${p.part}`, score: s.score });
  }
  // ids are stable: a (promise, class) row the last "attacks chosen" receipt holds keeps its id; a new row is numbered after the highest id ever chosen
  const all = parseReceipts(read(path.join(dir, 'receipts.md'))); const rowsOf = r => r.lines.map(l => l.text.match(/^row:\s*(A\d+)\s+(\S+)\s+(\S+)/)).filter(Boolean).map(x => ({ id: x[1], promise: x[2], key: x[3] }));
  const chosenR = all.filter(r => r.stage === 'build' && r.result === 'attacks chosen'); const prev = chosenR.length ? rowsOf(chosenR[chosenR.length - 1]) : [];
  if (prev.length) { let max = Math.max(...chosenR.flatMap(rowsOf).map(r => +r.id.slice(1)), ...all.map(r => r.stage === 'attack' && r.result.match(/^A(\d+)\s+(P\d+\.\d+|all)\s/)).filter(Boolean).map(x => +x[1])); for (const r of rows) { const was = prev.find(x => x.promise === r.promise && x.key === r.key); r.id = was ? was.id : `A${++max}`; } }
  return rows;
}
function writeAttacks(dir, stage, rows) {
  const st = computeState(dir); const states = {}; for (const a of st.attacks) { const last = a.attempts[a.attempts.length - 1]; states[a.key] = a.resolved ? 'resolved' : last ? `attempt ${last.k} ${last.result}` : 'planned'; }
  fs.writeFileSync(path.join(dir, 'attacks.md'), [`# Attacks — ${path.basename(dir)} · stage ${stage}`, '', 'Chosen by scripts/compass attacks. Do not edit by hand. The state column is read from receipts.md.', '', '| Attack | Promise | Class | What it tries | When | State |', '|---|---|---|---|---|---|', ...rows.map(r => `| ${r.id} | ${r.promise} | ${r.key} | ${r.name}${r.forced ? ' (always for this promise)' : ''} | ${r.when} | ${states[`${r.id} ${r.promise}`] || 'planned'} |`), ''].join('\n'));
}
const RECEIPT_SHAPE = /^(held|broke:\s.+?\s(?:→|->)\sobserved\s.+?,\sexpected\s.+)$/;
function checkReceiptLine(message) {
  const t = String(message).replace(/\s+$/, ''); if (/\n/.test(t)) return 'rejected: the whole message must be one line';
  if (!RECEIPT_SHAPE.test(t)) return 'rejected: the line must be exactly `held` or `broke: <reproduction> → observed <x>, expected <y>`';
  const tail = t.split(/expected\s/)[1] || ''; if ((t.match(/observed/g) || []).length > 1) return 'rejected: one break per line';
  if (/\balso\b|;|\(\d\)|\b\d\)|\bnote\b|\bin addition\b|—|–|\s-\s|\banother\b|\bplus\b|\bobserved\b|\bbroke:/i.test(tail)) return 'rejected: the expected clause carries extra findings; one break per line';
  return null;
}

// ---------- the look ----------
const LOOK_ITEMS = ['hierarchy', 'spacing', 'type', 'color', 'components', 'states', 'alignment', 'polish', 'responsive', 'copy', 'depth', 'structure', 'controls'];
const LOOK_SHAPE = new RegExp(`^scores:\\s*((?:[a-z]+=[1-5]\\s*){${LOOK_ITEMS.length}})(?:\\|\\s*low:\\s*(.*))?$`);
function parseLookLine(line) { const m = LOOK_SHAPE.exec(String(line).trim()); if (!m) return null; const scores = {}; for (const pair of m[1].trim().split(/\s+/)) { const [k, v] = pair.split('='); scores[k] = +v; } if (LOOK_ITEMS.some(k => !(k in scores))) return null; const low = {}; if (m[2]) for (const part of m[2].split(';')) { const mm = part.trim().match(/^([a-z]+)@"(.+)"$/); if (mm) low[mm[1]] = mm[2]; } return { scores, low }; }
function lookScore(level, ls) {
  const bars = { premium: { min: 4, none: 2 }, clean: { min: 3, none: 1 } }; if (level === 'match') return { result: 'held', note: 'match level: no rubric; conformance only' };
  const bar = bars[level]; if (!bar) return { error: `unknown level ${level}` }; const parsed = ls.map(parseLookLine); if (parsed.some(p => !p)) return { error: 'a reviewer line is not in the required shape' };
  const medians = {}, regions = {}; for (const k of LOOK_ITEMS) { const v = parsed.map(p => p.scores[k]).sort((a, b) => a - b); medians[k] = v[Math.floor(v.length / 2)]; regions[k] = parsed.map(p => p.low[k]).filter(Boolean); }
  const failing = LOOK_ITEMS.filter(k => medians[k] < bar.min || medians[k] <= bar.none); if (!failing.length) return { result: 'held', medians };
  return { result: `broke: look below the ${level} bar → observed ${failing.map(k => `${k}=${medians[k]}${regions[k].length ? ` (${regions[k].join(' / ')})` : ''}`).join('; ')}, expected every median ≥ ${bar.min}`, medians, failing };
}
function rubricLint() { const text = read(path.join(PLUGIN_ROOT, 'shared', 'look-rubric.md')); const problems = []; for (const k of LOOK_ITEMS) { const block = text.split(`\n## ${k}\n`)[1]; if (!block) { problems.push(`item ${k} missing`); continue; } const head = block.split('\n## ')[0]; for (const f of ['name:', 'ask:', '5:', '3:', '1:']) if (!head.includes(`\n${f} `) && !head.startsWith(`${f} `)) problems.push(`${k}: ${f} missing`); } if (!/^premium:/m.test(text) || !/^clean:/m.test(text) || !/^match:/m.test(text)) problems.push('bars missing'); return problems; }
function chromePath() { return ['/Applications/Google Chrome.app/Contents/MacOS/Google Chrome', '/Applications/Chromium.app/Contents/MacOS/Chromium', '/usr/bin/google-chrome', '/usr/bin/chromium', '/usr/bin/chromium-browser'].find(p => fs.existsSync(p)) || null; }
function shots(target, outDir, name, states) {
  const chrome = chromePath(); if (!chrome) return { error: 'no Chrome or Chromium found; screenshots skipped' }; outDir = path.resolve(outDir); fs.mkdirSync(outDir, { recursive: true });
  const base = /^https?:\/\//.test(target) ? target : 'file://' + path.resolve(target); const profile = fs.mkdtempSync(path.join(os.tmpdir(), 'compass-chrome-')); const isUrl = /^https?:\/\//.test(target);
  const common = ['--headless=new', '--disable-gpu', '--no-first-run', '--hide-scrollbars', '--allow-file-access-from-files', `--user-data-dir=${profile}`, '--virtual-time-budget=6000']; const out = [];
  for (const state of ['', ...(states || []).filter(Boolean)]) {
    const url = state ? `${base}${base.includes('?') ? '&' : '?'}state=${state}` : base; const suffix = state ? `-${state}` : '';
    for (const [label, width] of [['phone', 390], ['desktop', 1200]]) {
      const wrap = path.join(outDir, `.${name}${suffix}-${label}-frame.html`);
      fs.writeFileSync(wrap, `<!doctype html><html><head><meta charset="utf-8"><style>html,body{margin:0;background:#fff}iframe{display:block;width:${width}px;border:0;margin:0 auto;background:#fff}</style></head><body><iframe id="f" src="${url}"></iframe><div id="h" hidden></div><script>const f=document.getElementById('f'),h=document.getElementById('h');let last=0,stable=0;function tick(){try{const d=f.contentDocument;const v=Math.max(d.documentElement.scrollHeight,d.body?d.body.scrollHeight:0,400);if(v===last){stable++;}else{stable=0;last=v;}f.style.height=v+'px';h.textContent=String(v);}catch(e){h.textContent='2000';}if(stable<5)setTimeout(tick,100);}f.addEventListener('load',()=>{const d=f.contentDocument;(d&&d.fonts?d.fonts.ready:Promise.resolve()).then(tick,tick);});</script></body></html>`);
      let height = 2000; const file = path.join(outDir, `${name}${suffix}-${label}.png`);
      try {
        if (isUrl) execFileSync(chrome, [...common, `--window-size=${Math.max(width, 500)},3000`, `--screenshot=${file}`, url], { stdio: 'ignore' });
        else { try { const dom = execFileSync(chrome, [...common, `--window-size=${width + 40},1200`, '--dump-dom', 'file://' + wrap], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }); const m = dom.match(/id="h"[^>]*>(\d+)</); if (m) height = Math.min(+m[1] + 20, 12000); } catch {} execFileSync(chrome, [...common, `--window-size=${Math.max(width + 40, 500)},${height}`, `--screenshot=${file}`, 'file://' + wrap], { stdio: 'ignore' }); }
      } catch (e) { try { fs.rmSync(profile, { recursive: true, force: true }); } catch {} return { error: `screenshot failed for ${label}: ${(e.message || '').split('\n')[0]}` }; }
      try { fs.unlinkSync(wrap); } catch {} if (!fs.existsSync(file)) { try { fs.rmSync(profile, { recursive: true, force: true }); } catch {} return { error: `screenshot not written: ${file}` }; } out.push(file);
    }
  }
  try { fs.rmSync(profile, { recursive: true, force: true }); } catch {}
  if ((states || []).filter(Boolean).length) { const seen = {}; for (const f of out) { const m = path.basename(f).match(/-(phone|desktop)\.png$/); if (!m) continue; const h = crypto.createHash('sha1').update(fs.readFileSync(f)).digest('hex'); const prev = (seen[m[1]] = seen[m[1]] || {})[h]; if (prev) return { error: `two states give the same picture (${path.basename(prev)} and ${path.basename(f)}); the page does not answer ?state= the way its mock does` }; seen[m[1]][h] = f; } }
  return { files: out, note: isUrl ? 'a web address is shot at a fixed height; phone width is 500 px there' : '' };
}

// ---------- gates, pre-flight, write-back, release note ----------
function gateSuite(dir) {
  const idea = parseIdea(read(path.join(dir, 'idea.md'))); const plan = parsePlan(read(path.join(dir, 'plan.md'))); const receipts = parseReceipts(read(path.join(dir, 'receipts.md')));
  const promiseChecks = []; const noCheck = []; for (const p of idea.promises) { const withCmd = plan.steps.filter(s => s.promises.includes(p.id) && s.verify.cmd && s.verify.expected); if (!withCmd.length) noCheck.push(p.id); for (const s of withCmd) promiseChecks.push({ promise: p.id, step: s.id, cmd: s.verify.cmd, expected: s.verify.expected }); }
  const breakChecks = []; for (const r of receipts) if (r.stage === 'build' && /^fix (A|L)\d+/.test(r.result)) { const id = r.result.replace(/^fix /, '').split(/\s/)[0]; const prior = receipts.slice(0, r.idx).reverse().find(x => x.stage === 'attack' && new RegExp(`^${id}\\s+(\\S+)\\s+attempt\\s+\\d\\s+broke$`).test(x.result)); const promise = prior ? prior.result.split(/\s+/)[1] : ''; for (const l of r.lines) { const m = l.text.match(/^check added:\s*(\S+)/); if (m) breakChecks.push({ attack: id, promise, file: m[1] }); } }
  return { promiseChecks, breakChecks, noCheck };
}
function runGates(dir, target) {
  const isUrl = /^https?:\/\//.test(target || ''); const cwd = isUrl ? repoOf(dir) : (target || repoOf(dir)); const env = isUrl ? { ...process.env, COMPASS_TARGET: target } : process.env;
  const { promiseChecks, breakChecks } = gateSuite(dir); const results = []; const seen = new Map();
  const provenNow = new Set(parseReceipts(read(path.join(dir, 'receipts.md'))).filter(r => r.stage === 'build' && /^step\s+\S+\s+proven$/.test(r.result)).map(r => r.result.split(/\s+/)[1]));
  const legacyNow = legacyProofs(dir);
  for (const c of promiseChecks) { if (!provenNow.has(c.step)) { const shape = verifyProblem({ verify: { cmd: c.cmd, expected: c.expected } }, legacyNow.has(c.step)); results.push({ kind: 'promise', id: `${c.promise} ← ${c.step}`, promise: c.promise, cmd: c.cmd, ok: !shape, notYet: !shape, out: shape || 'not yet built', expected: c.expected }); continue; } const key = c.cmd + '→' + c.expected + (legacyNow.has(c.step) ? '→legacy' : ''); let r = seen.get(key); if (!r) { const run = runOne(c.cmd, cwd, env); const bad = verifyProblem({ verify: { cmd: c.cmd, expected: c.expected } }, legacyNow.has(c.step)) || (passes(run, c.expected) ? provesNothing(c.cmd, c.expected) : null); r = { ok: !bad && passes(run, c.expected), out: bad ? bad : observedLine(run, c.expected), expected: c.expected }; seen.set(key, r); } results.push({ kind: 'promise', id: `${c.promise} ← ${c.step}`, promise: c.promise, cmd: c.cmd, ...r }); }
  for (const c of breakChecks) { const f = path.resolve(cwd, c.file); const cmd = /\.(js|mjs|cjs)$/.test(f) ? `node "${f}"` : /\.py$/.test(f) ? `python3 -I "${f}"` : `sh "${f}"`; const run = runOne(cmd, cwd, env); results.push({ kind: 'break', id: c.attack, promise: c.promise, cmd: c.file, ok: run.ok, out: run.out.split('\n').pop() || '', expected: 'exit 0' }); }
  return results;
}
const SECRET_PATTERNS = [/AKIA[0-9A-Z]{16}/, /\bsk-[A-Za-z0-9_-]{20,}/, /\bghp_[A-Za-z0-9]{36}\b/, /-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----/, /\b(?:password|passwd|secret|api[_-]?key|token)\s*[:=]\s*["'][^"'\s]{8,}["']/i];
function preflight(dir, cwd, opts) {
  const out = []; let ok = true; const bad = s => { out.push(`• ${s}`); ok = false; }; const good = s => out.push(`✓ ${s}`);
  const sh = c => { try { return execSync(c, { cwd, encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim(); } catch { return null; } };
  const isGit = sh('git rev-parse --is-inside-work-tree') === 'true'; const dirty = isGit ? (sh('git status --porcelain') || '').split('\n').filter(l => l && !/\s\.claude\//.test(l) && !/^\?\? \.claude\//.test(l)).join('\n') : null;
  if (!isGit) bad('restore point: NOT taken; not a git repository. Make a copy of the deploy target by hand and record its path.'); else if (dirty) bad(`restore point: NOT taken; the tree has uncommitted changes (${dirty.split('\n').length} files). Commit or stash first.`);
  const plan = parsePlan(read(path.join(dir, 'plan.md'))); const s6 = planSection(plan, 6);
  if (s6 && !/^\s*none\b/im.test(s6) && !/not applicable/i.test(s6)) { if (!opts.dataRestore) bad('data restore point: plan §6 changes data; name where the data copy is with --data-restore=<path or command>'); else if (fs.existsSync(opts.dataRestore)) good(`data restore point: ${opts.dataRestore} exists`); else if (sh(opts.dataRestore) !== null) good(`data restore point: command "${opts.dataRestore}" ran`); else bad(`data restore point: "${opts.dataRestore}" is neither a path that exists nor a command that succeeds`); } else good('data restore point: not needed (plan §6 changes no data)');
  const example = ['.env.example', '.env.sample', '.env.template'].map(f => path.join(cwd, f)).find(f => fs.existsSync(f));
  if (example) { const keys = lines(read(example)).map(l => l.match(/^\s*([A-Z][A-Z0-9_]+)\s*=/)).filter(Boolean).map(m => m[1]); if (opts.envFrom) { const listed = sh(opts.envFrom); if (listed === null) bad(`config keys: the --env-from command failed; the target was not checked`); else { const have = listed.split(/\s+/); const missing = keys.filter(k => !have.some(x => x === k || x.startsWith(k + '='))); if (missing.length) bad(`config keys on the target: ${missing.length} of ${keys.length} missing: ${missing.join(', ')}`); else good(`config keys on the target: ${keys.length} of ${keys.length} present (via --env-from)`); } } else bad(`config keys: ${keys.length} declared, checked on this machine only; production was not checked. Pass --env-from="<command that lists the target's keys>"`); } else good('config keys: none declared (no .env.example); nothing to check');
  if (opts.health) { const code = sh(`curl -s -o /dev/null -w '%{http_code}' --max-time 10 "${opts.health}"`); if (code === '200') good(`health: ${opts.health} → 200`); else bad(`health: ${opts.health} → ${code || 'no answer'}`); }
  const files = (sh('git ls-files') || '').split('\n').filter(f => f && /\.(js|mjs|ts|py|sh|json|md|yml|yaml|toml|env|txt|html|css|sql)$/.test(f) && !/\.env\.example$/.test(f)); const hits = [];
  for (const f of files) { let text = ''; try { text = fs.readFileSync(path.join(cwd, f), 'utf8'); } catch { continue; } lines(text).forEach((l, i) => { if (SECRET_PATTERNS.some(p => p.test(l))) hits.push(`${f}:${i + 1}`); }); }
  if (hits.length) bad(`secret scan: ${hits.length} hit(s): ${hits.slice(0, 5).join(', ')}${hits.length > 5 ? ', …' : ''}`); else good(`secret scan: 0 hits across ${files.length} tracked text files`);
  if (ok && isGit) { const slug = path.basename(dir).replace(/[^A-Za-z0-9._-]/g, '-'); const head = sh('git rev-parse HEAD'); const tag = `compass-restore-${slug}-${new Date().toISOString().slice(0, 19).replace(/[-:T]/g, '')}-${head.slice(0, 7)}`; sh(`git tag -a -m "compass restore point" ${tag}`); const at = sh(`git rev-parse --verify --quiet ${tag}^{commit}`); if (at && at === head) out.unshift(`✓ restore point: tag ${tag} at ${head.slice(0, 7)} (undo: git reset --hard ${tag})`); else { out.unshift('• restore point: git tag failed (signing or permissions); no undo point exists'); ok = false; } }
  return { ok, lines: out };
}
function runbook(plan) { const s = planSection(plan, 19).split(/\r?\n/).map(l => l.trim()).filter(l => l && !/^<.*>$/.test(l)); const actions = s.filter(l => /→|->/.test(l)); const runs = s.filter(l => !/→|->/.test(l)); return { lines: s, actions, ok: runs.length >= 1 && actions.length >= 1 && !/not applicable/i.test(s.join(' ')) }; }
function releaseNote(dir) {
  const st = computeState(dir); const idea = parseIdea(read(path.join(dir, 'idea.md'))); const plan = parsePlan(read(path.join(dir, 'plan.md'))); const rb = runbook(plan);
  if (!rb.ok) return { error: 'release note refused: plan §19 Runbook needs at least one "how to run it" line and one "failure → action" line' };
  const out = [`# ${idea.title} — release note`, '', idea.purpose, '']; const ok = st.promises.filter(p => p.live && p.live.ok), bad = st.promises.filter(p => p.live && !p.live.ok), un = st.promises.filter(p => !p.live);
  if (st.promises.length <= 12) { if (ok.length) { out.push('Works now:'); for (const p of ok) out.push(`- ${p.text} ✓`); } if (bad.length) { out.push('', 'Not met yet:'); for (const p of bad) out.push(`- ${p.text} (live: ${p.live.value} ✗)`); } if (un.length) { out.push('', 'Not yet measured live:'); for (const p of un) out.push(`- ${p.text}`); } }
  else { out.push(`${ok.length} of ${st.promises.length} promises show their live number. By part: ${st.parts.map(pt => { const ps = st.promises.filter(p => p.part === pt.n); return `${ps.filter(p => p.live && p.live.ok).length}/${ps.length}`; }).join(' · ')}.`); if (bad.length) { out.push('', 'Not met yet:'); for (const p of bad) out.push(`- ${p.text} (live: ${p.live.value} ✗)`); } if (un.length) out.push('', `${un.length} promise${un.length > 1 ? 's are' : ' is'} not yet measured live; marked on the Idea page.`); }
  if (st.leftovers.length) { out.push('', st.leftovers.length <= 5 ? 'Set aside, accepted in writing:' : `${st.leftovers.length} items set aside in writing; the first three:`); for (const l of st.leftovers.slice(0, st.leftovers.length <= 5 ? 5 : 3)) out.push(`- ${l.text}`); if (st.leftovers.length > 5) out.push('- the rest are on the build card'); }
  if (idea.never.length) out.push('', `By design it will never: ${idea.never.slice(0, 4).map(x => x.replace(/^(it\s+)?(will\s+)?never\s+/i, '').replace(/^[A-Z]/, c => c.toLowerCase())).join('; ')}${idea.never.length > 4 ? '; and more on the Idea page' : ''}.`);
  if (st.watchClosed) out.push('', 'The watch period is over; every number held.'); else if (st.watch) out.push('', `Watch period until ${st.watch}. After that date, type /compass and I measure again; a ✗ reopens that part.`);
  out.push('', '## How to run it', ...rb.lines.slice(0, 12)); return { text: out.join('\n') };
}

// ---------- plan check and plan card ----------
const PLAN_SECTIONS = ['Goal and promises', 'Non-goals', 'Current state', 'Proposed design', 'Alternatives considered', 'Data changes', 'Dependencies and blast radius', 'Walking skeleton', 'Slices and steps', 'Order and parallelism', 'Rollout', 'Rollback', 'Testing strategy', 'Definition of done', 'Observability', 'Failure modes', 'Security and privacy', 'Performance and capacity', 'Runbook', 'Assumptions and open questions', 'Decision log'];
function planCheck(dir) {
  const text = read(path.join(dir, 'plan.md')); if (!text) return ['plan.md missing']; const problems = []; const plan = parsePlan(text); const idea = parseIdea(read(path.join(dir, 'idea.md')));
  PLAN_SECTIONS.forEach((name, i) => { const h = plan.sections[i + 1]; if (!h) problems.push(`section ${i + 1} (${name}) missing`); else if (!h.toLowerCase().startsWith(name.toLowerCase().split(' ')[0])) problems.push(`section ${i + 1} is "${h}", expected "${name}"`); });
  const s3 = planSection(plan, 3); const repo = repoOf(dir); const cited = [...s3.matchAll(/`([^`\s]+\/[^`\s]*|[^`\s]+\.(?:md|js|mjs|ts|py|json|sh|html|css|sql|yml|yaml|toml))`/g)].map(m => m[1]);
  if (!/^\s*greenfield\b/im.test(s3) && !cited.some(c => fs.existsSync(path.isAbsolute(c) ? c : path.join(repo, c.replace(/^\.\//, ''))))) problems.push(`§3 cites no path that exists in the target repo (${cited.length} cited)`);
  if (!plan.slices.length) problems.push('no ### Slice blocks'); else if (!/skeleton/i.test(plan.slices[0].title)) problems.push(`slice 1 is "${plan.slices[0].title}", must be the walking skeleton`);
  if (!plan.steps.length) problems.push('no step lines in the shape "- [ ] S1.1 <what> → P1.1 · verify: `cmd` → expected"');
  const served = new Set(plan.steps.flatMap(s => s.promises)); for (const p of idea.promises) if (!served.has(p.id)) problems.push(`${p.id} has no step`);
  const ids = plan.steps.map(s => s.id); for (const id of [...new Set(ids.filter((x, i) => ids.indexOf(x) !== i))]) problems.push(`${id} appears more than once; each step needs its own number`); const legacy = legacyProofs(dir);
  for (const s of plan.steps) { if (!s.promises.length) problems.push(`${s.id} serves no promise`); for (const pid of s.promises) if (!idea.promises.find(p => p.id === pid)) problems.push(`${s.id} cites ${pid}, which is not on the Idea page`); if (!s.verify.cmd) problems.push(`${s.id}: verify needs one backticked command first, then "→ <expected output>"`); else if (trivialCmd(s.verify.cmd, s.verify.expected, legacy.has(s.id))) problems.push(`${s.id}: \`${s.verify.cmd}\` ${trivialCmd(s.verify.cmd, s.verify.expected, legacy.has(s.id))}; the command must exercise the product`); else if (!s.verify.expected) problems.push(`${s.id}: verify needs "→ <expected output>" after the command`); else if (/^exit\s*0$/i.test(s.verify.expected)) problems.push(`${s.id}: the expected output must be text the command prints, not an exit code`); if (s.estimate && s.estimate > 6) problems.push(`${s.id} is estimated at ${s.estimate} h; a step fits one sitting (≤ 6 h), split it`); }
  if (!fs.existsSync(path.join(dir, 'spec.md'))) problems.push('spec.md missing; the plan binds to it'); else problems.push(...specCheck(dir).map(p => 'spec: ' + p));
  if (!runbook(plan).ok) problems.push('§19 Runbook needs a "how to run it" line and a "failure → action" line');
  return problems;
}
function planCard(dir) {
  const st = computeState(dir); const plan = parsePlan(read(path.join(dir, 'plan.md'))); const idea = parseIdea(read(path.join(dir, 'idea.md')));
  const covered = st.promises.filter(p => plan.steps.some(s => s.promises.includes(p.id))).length; const claim = st.steps.total && covered === st.promises.length ? `every one of the ${st.promises.length} promises has a step` : `${covered} of ${st.promises.length} promises have a step`;
  const out = [`${st.title} · plan v${st.version} · ${idea.parts.length} part${idea.parts.length === 1 ? '' : 's'} · ${st.steps.total} step${st.steps.total === 1 ? '' : 's'} · ${claim}`, '', 'Your parts, in build order'];
  const skN = stepsByPart(plan, idea)[0].length; if (skN) out.push(`  First, a thin version of the whole thing that runs end to end (${skN} step${skN === 1 ? '' : 's'}), so problems show early.`);
  const byPart = stepsByPart(plan, idea); for (const part of idea.parts) { const n = (byPart[part.n] || []).length; out.push(`  ${String(part.n).padStart(2)}  ${part.title}  · ${n} step${n === 1 ? '' : 's'}`); }
  if (st.risks.length) { out.push('', 'The biggest risks, and what I do about each'); st.risks.slice(0, 3).forEach((r, i) => out.push(`  ${i + 1}. ${r.text}`)); }
  const answered = st.decisions.filter(d => /^you decided/i.test(d.text)); const openQs = st.questions.filter(q => !/\(answered/i.test(q.text));
  if (answered.length) { out.push('', 'You decided'); for (const d of answered) out.push(`  · ${d.text.replace(/^you decided[:\s]*/i, '')}`); }
  return out;
}

// ---------- the active build ----------
function findBuild(cwd) { const root = path.join(cwd, '.claude', 'builds'); let best = null, bestT = -1; for (const name of (fs.existsSync(root) ? fs.readdirSync(root) : [])) { const d = path.join(root, name); if (!fs.existsSync(path.join(d, 'idea.md'))) continue; const rs = parseReceipts(read(path.join(d, 'receipts.md'))); const last = Math.max(0, ...rs.map(r => Date.parse(r.ts) || 0)); const t = last || Math.max(...['receipts.md', 'idea.md', 'plan.md'].map(f => { try { return fs.statSync(path.join(d, f)).mtimeMs; } catch { return 0; } })); if (t > bestT) { bestT = t; best = d; } } return best; }

// ---------- main ----------
const [verb, ...args] = process.argv.slice(2);
const flag = (name, def) => { const a = args.find(x => x.startsWith(`--${name}=`)); return a ? a.slice(name.length + 3) : def; };
const dirArg = args[0] && !args[0].startsWith('--') ? args[0] : null; const resolveDir = () => (dirArg && dirArg !== 'auto') ? path.resolve(dirArg) : findBuild(process.cwd()); const needDir = () => { const d = resolveDir(); if (!d) die('no build folder here'); return d; };
const wrapFull = html => `<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">${html.replace(/<\/style>/, '</style></head><body>')}</body></html>`;

if (verb === 'state') { const d = resolveDir(); if (!d) { console.log(args.includes('--route') ? 'none' : args.includes('--json') ? JSON.stringify({ line: 'No build here yet.', lineBare: 'No build here yet.', route: 'none', ask: null, askOptions: [] }, null, 2) : 'No build here yet.'); process.exit(0); } const st = computeState(d); console.log(args.includes('--json') ? JSON.stringify(st, null, 2) : args.includes('--route') ? st.route : args.includes('--bare') ? st.lineBare : st.line); }
else if (verb === 'line') { const d = resolveDir(); if (d) console.log(computeState(d).line); }
else if (verb === 'card') { const dir = needDir(); const out = flag('out', path.join(dir, 'card.html')); let html = renderCard(computeState(dir), dir); if (args.includes('--full')) html = wrapFull(html); fs.writeFileSync(out, html); console.log(out); }
else if (verb === 'receipt') { const [dir, stage, result, ...rest] = args; if (!dir || !stage || !result) die('usage: compass receipt <dir> <stage> <result> [line ...]'); const opts = {}; const err = validateReceipt(path.resolve(dir), stage, result, rest, opts); if (err) die(`receipt refused: ${err}`, 2); let body = rest; if (opts.observed !== undefined) { body = rest.filter(l => !/^(\[x\]\s*)?verify:/.test(l)); body.unshift(`verify: ${opts.cmd} → ${opts.observed}`); body.push(`step-pin: ${opts.stepPin}`); }
  if (opts.ranLine) { body = body.filter(l => String(l).trim().replace(/^\[[ x]\]\s*/, '') !== opts.ranLine.typed); body.unshift(opts.ranLine.text); }
  const d = path.resolve(dir); const res = String(result).trim(); const amendEdit = stage === 'amend' && /^part\s+\d+\s+edited$/.test(res); const hadLook = computeState(d).flags.lookPin; // pins: v2 forms; the person saw these files as they are now
  if ((stage === 'plan' && /^(drafted|revised|approved)$/.test(res)) || amendEdit) body = [...body, `plan-pin: v2:${planPin2(d)}`, `plan-steps: ${planStepsLine(d)}`, `spec-pin: ${specPinOf(d)}`];
  const reopened = stage === 'idea' && /^look (ready|approved)$/.test(res) && lookReopened(parseReceipts(read(path.join(d, 'receipts.md')))); // a look redone inside an amend pins only the look; the amend pins the page and plan
  if ((stage === 'idea' && /^(drafted|approved|look ready|look approved)$/.test(res) && !reopened) || amendEdit) body = [...body, `idea-pin: v2:${ideaPin2(d)}`];
  if ((stage === 'idea' && /^(approved|look approved)$/.test(res) && !reopened) || amendEdit) body = [...body, `idea-promises: ${parseIdea(read(path.join(d, 'idea.md'))).promises.map(p => `${p.id}=${promisePin(p)}`).join(' ')}`];
  if ((stage === 'idea' && /^look (ready|approved)$/.test(res)) || (amendEdit && hadLook)) body = [...body, `look-pin: ${lookPinOf(d)}`];
  { const pa = stage === 'attack' && res.match(/^(?:A|L)\d+\s+(page|plan)\s+attempt\s+\d\s+(held|broke)$/); if (pa) body = [...body, `attacked: ${attackedPin(d, pa[1])}`]; }
  console.log(appendReceipt(d, stage, result, body)); }
else if (verb === 'part-line') { const dir = needDir(); const n = +args[1]; if (!n) die('usage: compass part-line <dir> <part number>'); console.log(partLine(dir, n)); }
else if (verb === 'answer') {
  const dir = path.resolve(args[0] || ''); const sub = args[1]; const qFlag = args.find(x => /^--question=\d+$/.test(x)); const rest = args.slice(2).filter(x => !['--verbose'].includes(x) && x !== qFlag); if (!args[0] || !sub) die('usage: compass answer <dir> set <key> "<value>" [set <key> "<value>" …] | part <n> --title= --picture= --prose= --screen --promise=… | journey "<key>: <caption>"… | later "…"… | never "…"… | open "<question> → <answer>"… | question <k> 11 [--skipped "<reason>"]; any form may end with --question=<k>');
  if (args.some(a => /[\r\n]/.test(a))) die('an answer holds a line break; one line per value');
  if (qFlag) { const k = +qFlag.split('=')[1]; if (!(k >= 1 && k <= QUESTIONS)) die(`--question=${k}: there is no such question`); } // checked before idea.md is written
  const bad = (v, why) => die(`answer refused: "${String(v).slice(0, 60)}" ${why}; write one plain sentence that starts with a word`);
  const valueOk = (v, arrowOk) => { const t = String(v).trim(); let w; // a value can never add a line idea.md reads as structure
    if (/^#/.test(t)) bad(v, 'starts with "#", which the page reads as a heading'); if (/^[-*]/.test(t)) bad(v, 'starts with "-" or "*", which the page reads as a list line or a promise'); if (/^\d+\.(\s|$)/.test(t)) bad(v, 'starts with a number and a full stop, which reads as a numbered list'); if (/^```/.test(t)) bad(v, 'starts with ```, which the page reads as a code block');
    if ((w = t.match(/^\p{L}[\p{L}\p{N}_-]*:/u))) bad(v, `starts with "${w[0]}", which the page reads as one of its own lines`); if (!arrowOk && /→/.test(t)) bad(v, 'holds "→", which the page uses only between a promise and its number'); };
  const pathOk = (p, what) => { if (!insideDir(dir, p)) die(`answer refused: ${what} ${p} is outside the build folder; keep mocks, sketches and pictures inside ${dir}`); };
  fs.mkdirSync(dir, { recursive: true }); const slug = path.basename(dir); if (/\s/.test(slug)) die('the build folder name has a space; use kebab-case');
  const text = read(path.join(dir, 'idea.md')); const idea = text ? parseIdea(text) : parseIdea(`# Idea — ${slug}\n`); idea.slug = slug; const getFlag = (n, src) => { const a = src.find(x => x.startsWith(`--${n}=`)); return a ? a.slice(n.length + 3) : null; };
  if (sub === 'set') { const pairs = []; for (const tok of rest) { if (tok === 'set') { pairs.push(null); continue; } if (tok.startsWith('--')) continue; if (!pairs.length || pairs[pairs.length - 1] === null) { if (pairs.length) pairs.pop(); pairs.push([tok, []]); } else pairs[pairs.length - 1][1].push(tok); } if (!pairs.length || pairs.some(p => !p)) die('set needs <key> "<value>"');
    for (const [k, v] of pairs) { if (!HEAD_KEYS.includes(k) || k === 'approved') die(`set: unknown key ${k}`); const val = v.join(' ').trim(); if ((k === 'page' || k === 'card') && val && !/^https?:\/\//.test(val)) die(`${k} must be a web address (https://…)`); if (k !== 'page' && k !== 'card') valueOk(val, false); idea[k] = val; } }
  else if (sub === 'open') { const items = rest.filter(x => !x.startsWith('--')); if (!items.length || items.some(x => !x.includes('→'))) die('open "<question> → <answer, or how it was resolved>"'); for (const x of items) valueOk(x, true); const qOf = s => s.slice(0, s.lastIndexOf('→')).trim(); for (const x of items) { const q = qOf(x); idea.open = (idea.open || []).filter(o => !o.includes('→') || qOf(o) !== q); idea.open.push(x.trim()); } } // the answer follows the last →
  else if (sub === 'part') { const n = +rest[0]; if (!n) die('part needs a number'); if (rest.includes('--remove')) { idea.parts = idea.parts.filter(x => x.n !== n); } else { let p = idea.parts.find(x => x.n === n); if (!p) { p = { n, title: '', picture: '', prose: [], promises: [], sketch: '', mock: '', screen: false }; idea.parts.push(p); idea.parts.sort((a, b) => a.n - b.n); }
    const t = getFlag('title', rest); const pic = getFlag('picture', rest); const prose = getFlag('prose', rest); const mock = getFlag('mock', rest); const sk = getFlag('sketch', rest);
    if (t) valueOk(t, false); if (prose) valueOk(prose, false); if (pic && pic.startsWith('file:')) pathOk(pic.slice(5), 'the picture'); else if (pic) valueOk(pic, false); if (mock) pathOk(mock, 'the mock'); if (sk) pathOk(sk, 'the sketch');
    for (const x of rest.filter(y => y.startsWith('--promise='))) { const v = x.slice(10); valueOk(v, true); valueOk(v.replace(/^P\d+\.\d+\s+/, ''), true); }
    if (t) p.title = t; if (pic) p.picture = pic; if (prose) p.prose = [prose]; if (mock) p.mock = mock; if (sk) p.sketch = sk; if (rest.includes('--screen')) p.screen = true;
    const proms = rest.filter(x => x.startsWith('--promise=')).map(x => x.slice(10)); if (proms.length) {
      const everUsed = new Set([...(read(path.join(dir, 'receipts.md')).match(/P\d+\.\d+/g) || []), ...(read(path.join(dir, 'idea.md')).match(/P\d+\.\d+/g) || []), ...idea.parts.flatMap(q => q.promises.map(x => x.id))]);
      const parsed = proms.map(s => { const at = s.lastIndexOf('→'); const m = s.match(/^(P\d+\.\d+)\s+/); return { given: m ? m[1] : null, text: (at >= 0 ? s.slice(0, at) : s).replace(/^P\d+\.\d+\s+/, '').trim(), number: at >= 0 ? s.slice(at + 1).trim() : '' }; });
      const pinnedText = {}; for (const pm of read(path.join(dir, 'receipts.md')).matchAll(/^-\s+\[[ xX]\]\s+idea-promises:\s*(.*)$/gm)) for (const kv of pm[1].split(/\s+/)) { const [pid, pin] = kv.split('='); if (pin) (pinnedText[pid] = pinnedText[pid] || new Set()).add(pin.split('.')[0]); }
      for (const x of parsed) if (x.given && pinnedText[x.given] && [...pinnedText[x.given]].some(h => h !== sha(x.text).slice(0, 8))) die(`${x.given} belonged to another sentence when the person approved the page; an id is never given to a new sentence. Leave the id off and answer gives it the next free number`);
      const taken = new Set(); for (const x of parsed) { const prev = p.promises.find(q => q.text === x.text); x.id = x.given && !taken.has(x.given) ? x.given : prev && !taken.has(prev.id) ? prev.id : null; if (x.id) taken.add(x.id); }
      let i = 1; for (const x of parsed) { if (x.id) continue; while (everUsed.has(`P${n}.${i}`) || taken.has(`P${n}.${i}`)) i++; x.id = `P${n}.${i}`; taken.add(x.id); }
      p.promises = parsed.map(x => ({ id: x.id, part: n, text: x.text, number: x.number })); } } }
  else if (sub === 'journey') { idea.journey = rest.filter(x => !x.startsWith('--')).map(s => { const m = s.match(/^([\w:./-]+):\s*(.+)$/); return m ? { picture: m[1], caption: m[2] } : null; }).filter(Boolean); for (const j of idea.journey) { valueOk(j.caption, false); if (j.picture.startsWith('file:')) pathOk(j.picture.slice(5), 'the picture'); } }
  else if (sub === 'later' || sub === 'never') { const items = rest.filter(x => !x.startsWith('--')); for (const x of items) valueOk(x, false); idea[sub] = items; }
  else if (sub === 'question') { const [k, n, ...more] = rest; if (!k || !n) die('question <k> 11 [--skipped "<reason>"]'); if (+n !== QUESTIONS) die(`the interview has ${QUESTIONS} questions; record question ${k} of ${QUESTIONS}`); if (!(+k >= 1 && +k <= QUESTIONS)) die(`question ${k} of ${QUESTIONS}: there is no such question; a re-ask keeps the same number`); const si = more.indexOf('--skipped'); if (si < 0) appendReceipt(dir, 'idea', `question ${k} of ${QUESTIONS} answered`, [`answered: question ${k}`]); else { const why = String(more[si + 1] || '').trim(); if (!SKIPPABLE.includes(+k)) die(`question ${k} cannot be skipped; only ${SKIPPABLE.join(', ')} may be, each with its reason`); if (!why) die('--skipped needs the reason, in the person\'s world ("no part has a screen")'); if (+k === 9 && idea.parts.some(p => p.screen || p.mock || p.sketch)) die('a part has a screen, so question 9 (how it should look) must be asked'); appendReceipt(dir, 'idea', `question ${k} of ${QUESTIONS} skipped`, [`skipped: ${why}`]); } }
  else die(`answer: unknown subcommand ${sub}`);
  idea.promises = idea.parts.flatMap(p => p.promises); fs.writeFileSync(path.join(dir, 'idea.md'), serializeIdea(idea));
  if (qFlag) { const k = +qFlag.split('=')[1]; appendReceipt(dir, 'idea', `question ${k} of ${QUESTIONS} answered`, [`answered: question ${k}`]); }
  const stNow = computeState(dir); const problems = lintIdea(dir, idea, { noLook: !stNow.flags.ideaApproved }); fs.writeFileSync(path.join(dir, 'idea-page.html'), renderIdeaPage(dir, idea, stNow));
  console.log(`Idea page updated · ${idea.parts.length} part${idea.parts.length === 1 ? '' : 's'} · ${idea.promises.length} promise${idea.promises.length === 1 ? '' : 's'}${problems.length ? ` · still to fill: ${problems.slice(0, 3).join('; ')}${problems.length > 3 ? ` (+${problems.length - 3})` : ''}` : ' · complete'}`);
}
else if (verb === 'idea-page') { const dir = needDir(); const idea = parseIdea(read(path.join(dir, 'idea.md'))); const problems = lintIdea(dir, idea); if (args.includes('--check')) { for (const p of problems) console.log('✗ ' + p); console.log(problems.length ? `${problems.length} problems` : '✓ idea.md is within limits'); process.exit(problems.length ? 1 : 0); } if (problems.length) { for (const p of problems) console.error('✗ ' + p); process.exit(1); } const out = flag('out', path.join(dir, 'idea-page.html')); let html = renderIdeaPage(dir, idea, computeState(dir)); if (args.includes('--full')) html = wrapFull(html); fs.writeFileSync(out, html); console.log(out); }
else if (verb === 'spec-check') { const dir = needDir(); const p = specCheck(dir); for (const x of p) console.log('✗ ' + x); console.log(p.length ? `${p.length} problems` : '✓ every rule points at a promise on the Idea page'); process.exit(p.length ? 1 : 0); }
else if (verb === 'plan-check') { const dir = needDir(); const p = planCheck(dir); for (const x of p) console.log('✗ ' + x); console.log(p.length ? `${p.length} problems` : '✓ plan: 21 sections, scan cited, skeleton first, every promise has a step, every step has a real command and an expected output, spec and runbook present'); process.exit(p.length ? 1 : 0); }
else if (verb === 'plan-card') { const dir = needDir(); const ls = planCard(dir); console.log(ls.join('\n')); if (ls.length > 40) { console.error(`plan-card is ${ls.length} lines; the screen is 40`); process.exit(3); } }
else if (verb === 'attacks') { const dir = needDir(); const stage = args[1] && !args[1].startsWith('--') ? args[1] : 'build'; const rows = chooseAttacks(dir, stage); writeAttacks(dir, stage, rows); if (stage === 'build') appendReceipt(dir, 'build', 'attacks chosen', rows.map(r => `row: ${r.id} ${r.promise} ${r.key}`)); console.log(`${rows.length} attacks for stage ${stage} → attacks.md`); if (args.includes('--json')) console.log(JSON.stringify(rows, null, 2)); }
else if (verb === 'attack-receipt-check') { if (args[0] === '--look') { const ok = !!parseLookLine(args.slice(1).join(' ')); console.log(ok ? 'ok' : `rejected: a look reviewer's last line must be \`scores: <${LOOK_ITEMS.length} items>=<1-5> | low: item@"region"; …\``); process.exit(ok ? 0 : 1); } const err = checkReceiptLine(args.join(' ')); console.log(err || 'ok'); process.exit(err ? 1 : 0); }
else if (verb === 'shots') { const target = args[0]; if (!target) die('usage: compass shots <file.html|url> [--out=dir] [--name=x] [--states=empty,error]'); const r = shots(target, flag('out', path.join(process.cwd(), 'shots')), flag('name', path.basename(target).replace(/\.\w+$/, '') || 'page'), (flag('states', '') || '').split(',').filter(Boolean)); if (r.error) die(r.error, 2); for (const f of r.files) console.log(f); }
else if (verb === 'look-score') { const [level, ...ls] = args; if (!level || ls.length !== 3) die('usage: compass look-score <premium|clean|match> "<line>" "<line>" "<line>"'); const r = lookScore(level, ls); if (r.error) die(r.error, 2); console.log(r.result); process.exit(r.result === 'held' ? 0 : 3); }
else if (verb === 'rubric-check') { const p = rubricLint(); for (const x of p) console.log('✗ ' + x); console.log(p.length ? `${p.length} problems` : `✓ rubric: ${LOOK_ITEMS.length} items with anchors, 3 bars`); process.exit(p.length ? 1 : 0); }
else if (verb === 'gates') {
  const dir = needDir(); const { promiseChecks, breakChecks, noCheck } = gateSuite(dir);
  if (args.includes('--run') && args.includes('--record')) { const tg = flag('target', null); if (tg && !/^https?:\/\//.test(tg) && !samePath(tg, repoOf(dir))) die(`gates --record runs on the project itself (${repoOf(dir)}) or on a web address; ${tg} is another folder, so its result cannot be recorded`, 2); const d = driftOf(dir, computeState(dir)); if (d) die(d, 2); }
  if (args.includes('--run')) { const at = { head: gitHead(repoOf(dir)), tree: treeState(repoOf(dir)) }; const rs = runGates(dir, flag('target', null)); /* at: the code the run tested */ for (const r of rs) console.log(`${r.ok ? '✓' : '✗'} ${r.kind === 'promise' ? 'promise' : 'break  '} ${r.id} · ${r.cmd} → ${r.out}${r.ok ? '' : ` (expected: ${r.expected})`}`); const red = rs.filter(r => !r.ok).length, notYet = rs.filter(r => r.notYet).length; if (!rs.length) { console.log('✗ no gate checks found: every step needs `command` → expected'); process.exit(1); } const green = !red && !noCheck.length; console.log(`\n${rs.length - red - notYet} of ${rs.length} gate checks green${notYet ? ` · ${notYet} not yet built` : ''}${noCheck.length ? ` · ✗ no check for: ${noCheck.join(', ')}` : ''}`); if (args.includes('--record')) appendReceipt(dir, 'build', green ? 'gates green' : 'gates red', [`ran: ${rs.length} checks, ${red} red${notYet ? `, ${notYet} not yet built` : ''}${noCheck.length ? `, no check for ${noCheck.join(', ')}` : ''}`, `ran on: ${flag('target', repoOf(dir))}`, `at commit: ${at.head}`, `tree: ${at.tree}`]); process.exit(green ? 0 : 1); }
  console.log(`Gate suite for ${path.basename(dir)}: ${promiseChecks.length} promise checks + ${breakChecks.length} checks born from breaks. Nothing else gates progress.${noCheck.length ? ` No check yet for: ${noCheck.join(', ')}` : ''}`); for (const c of promiseChecks) console.log(`  promise ${c.promise} ← ${c.step}: ${c.cmd} → ${c.expected}`); for (const c of breakChecks) console.log(`  break   ${c.attack}${c.promise ? ` (${c.promise})` : ''}: ${c.file}`);
}
else if (verb === 'preflight') { const dir = needDir(); const r = preflight(dir, repoOf(dir), { envFrom: flag('env-from', null), dataRestore: flag('data-restore', null), health: flag('health', null) }); for (const l of r.lines) console.log(l); console.log(r.ok ? '✓ pre-flight passed' : '✗ pre-flight failed; nothing deployed'); if (r.ok && args.includes('--record')) appendReceipt(dir, 'deploy', 'preflight', r.lines.map(l => l.replace(/^✓\s*/, ''))); process.exit(r.ok ? 0 : 1); }
else if (verb === 'writeback') {
  const dir = needDir(); if (args.some(a => /^P\d+\.\d+=/.test(a))) die('writeback measures; it does not take values. Run it with --target=<path or url> and it runs every promise\'s check itself.');
  let target = flag('target', ''); if (!target) die('writeback needs --target=<web address, or the folder where the product now runs>; say --target=local when it runs on this machine'); const isLocal = target === 'local'; if (isLocal) target = repoOf(dir);
  else if (!/^https?:\/\//.test(target)) { // a folder that exists, outside Compass's own record folder; anything else measures nothing
    if (/^file:/i.test(target)) die('--target takes a web address (http:// or https://), a folder that exists, or local; a file:// address is not measured');
    let real = null; try { real = fs.realpathSync(target); if (!fs.statSync(real).isDirectory()) real = null; } catch {} if (!real) die(`--target=${target} is neither a web address (http:// or https://), a folder that exists, nor local`);
    const rp = p => { try { return fs.realpathSync(p); } catch { return path.resolve(p); } }; const root = rp(repoOf(dir)), rec = rp(dir);
    if (real === root) die('that is the build folder itself; say --target=local if the product runs on this machine');
    if (real === rec || real.startsWith(rec + path.sep) || (rec.startsWith(real + path.sep) && real.startsWith(root + path.sep))) die('that is Compass\'s own record folder (.claude/builds/…), not where the product runs; say --target=local if it runs on this machine');
  }
  const watch = flag('watch-until', ''); if (watch && !(/^\d{4}-\d{2}-\d{2}$/.test(watch) && !isNaN(new Date(watch + 'T00:00:00Z')) && new Date(watch + 'T00:00:00Z').toISOString().slice(0, 10) === watch)) die('--watch-until must be a real date, YYYY-MM-DD'); if (watch && watch <= today()) die(`the check-again date must be after today (${today()})`); if (!watch && !args.includes('--close-watch')) die('writeback needs --watch-until=YYYY-MM-DD (the check-again date), or --close-watch after that date');
  if (args.includes('--close-watch')) { const s = computeState(dir); if (!s.watch) die('no watch to close: the live numbers were never written with a check-again date'); if (s.watchClosed) die('the watch is already closed'); if (!s.watchOver) die(`the watch runs until ${s.watch}; run --close-watch after that date`); }
  const err = validateReceipt(dir, 'deploy', 'writeback', [], { internal: true }); if (err) die(`writeback refused: ${err}`, 2);
  const st0 = computeState(dir); const rs = runGates(dir, target); const { noCheck } = gateSuite(dir); const body = [];
  const isUrl = /^https?:\/\//.test(target);
  if (isUrl) for (const r of rs) if (r.kind === 'promise') { const again = runOne(r.cmd, repoOf(dir), { ...process.env, COMPASS_TARGET: 'http://127.0.0.1:9' }); if (passes(again, r.expected)) r.blind = true; } // it passes against a dead address too, so it never touched the live system
  for (const p of st0.promises) { const mine = rs.filter(r => r.promise === p.id); const blind = isUrl && mine.filter(r => r.kind === 'promise').every(r => r.blind); if (!mine.length || blind) { body.push(`${p.id}: not measured (${blind ? 'its check gives the same answer with no live address' : 'no runnable check'})`); continue; } const ok = mine.every(r => r.ok); const val = (mine.find(r => r.kind === 'promise') || mine[0]).out || mine[0].expected; body.push(`${p.id}: live ${String(val).slice(0, 60)} ${ok ? '✓' : '✗'}`); }
  for (const r of rs.filter(r => r.kind === 'break' && r.promise === 'all')) body.push(`all: check ${r.cmd} ${r.ok ? '✓' : '✗'}`);
  body.push(`target: ${isLocal ? 'local (this machine)' : target}`); const allOk = !body.some(l => /✗$/.test(l)); if (watch) body.push(`watch: until ${watch}`); else if (args.includes('--close-watch') && allOk) body.push('watch: closed');
  appendReceipt(dir, 'deploy', 'writeback', body); const idea = parseIdea(read(path.join(dir, 'idea.md'))); fs.writeFileSync(path.join(dir, 'idea-page.html'), renderIdeaPage(dir, idea, computeState(dir)));
  const okN = body.filter(l => /^P\d+\.\d+: live .*✓$/.test(l)).length, badN = body.filter(l => /✗$/.test(l)).length, unN = body.filter(l => /^P\d+\.\d+: not measured/.test(l)).length; console.log(`measured on ${target}: ${okN} ✓ · ${badN} ✗ · ${unN} not measured; idea-page.html re-rendered`); process.exit(badN ? 3 : 0);
}
else if (verb === 'release-note') { const dir = needDir(); const r = releaseNote(dir); if (r.error) die(r.error, 2); fs.writeFileSync(path.join(dir, 'release-note.md'), r.text); console.log(r.text); const words = r.text.split('## How to run it')[0].split(/\s+/).filter(Boolean).length; if (words > 260) console.error(`note: the release note body is ${words} words; the person reads it in a minute at 260 or fewer`); }
else { console.log('usage: compass state|line|card|receipt|answer|idea-page|spec-check|plan-check|plan-card|attacks|attack-receipt-check|shots|look-score|rubric-check|gates|part-line|preflight|writeback|release-note'); process.exit(verb ? 1 : 0); }
