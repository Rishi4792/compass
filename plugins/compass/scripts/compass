#!/usr/bin/env node
'use strict';
// compass — the one script. No dependencies.
// Status is a pure function of three files in a build folder: idea.md, plan.md, receipts.md. Nothing else is read.
// Verbs: state · line · card · receipt · answer · idea-page · spec-check · plan-check · plan-card · attacks ·
//        attack-receipt-check · shots · look-score · rubric-check · gates · preflight · writeback · release-note

const fs = require('fs');
const path = require('path');
const os = require('os');
const { execSync, execFileSync } = require('child_process');

const PLUGIN_ROOT = path.resolve(__dirname, '..');
const D = '[—–-]'; // any dash a person or an editor might type
const read = p => { try { return fs.readFileSync(p, 'utf8'); } catch { return ''; } };
const lines = t => t.split(/\r?\n/);
const esc = s => String(s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
const day = ts => { const d = new Date(ts); return isNaN(d) ? ts : d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }); };
const today = () => new Date().toISOString().slice(0, 10);
const die = (m, code = 1) => { console.error(m); process.exit(code); };

// ---------- idea.md ----------
const HEAD_KEYS = ['title', 'page', 'for', 'hurts', 'exists', 'because', 'purpose', 'done', 'look', 'approved'];
function parseIdea(text) {
  const parts = []; const journey = []; const later = [], never = []; const head = {};
  let cur = null, list = null, inJourney = false, inFence = false;
  for (const line of lines(text)) {
    if (/^```/.test(line)) { inFence = !inFence; if (cur) cur.fence = true; continue; }
    if (inFence) continue;
    const h = line.match(new RegExp(`^###\\s+Part\\s+(\\d+)\\s+${D}\\s+(.+)$`));
    if (h) { cur = { n: +h[1], title: h[2].trim(), picture: '', prose: [], promises: [], sketch: '', mock: '', fence: false }; parts.push(cur); list = null; inJourney = false; continue; }
    if (/^##\s+Journey/.test(line)) { inJourney = true; list = null; cur = null; continue; }
    if (/^##\s+Later/.test(line)) { list = later; cur = null; inJourney = false; continue; }
    if (/^##\s+Never/.test(line)) { list = never; cur = null; inJourney = false; continue; }
    if (/^##?\s/.test(line) && !/^###/.test(line)) { list = null; cur = null; inJourney = false; }
    const kv = line.match(new RegExp(`^(${HEAD_KEYS.join('|')}):\\s*(.*)$`));
    if (kv && !cur && !inJourney) { head[kv[1]] = kv[2].trim(); continue; }
    if (inJourney) { const j = line.match(/^-\s+([\w:./-]+):\s*(.+)$/); if (j) journey.push({ picture: j[1], caption: j[2].trim() }); continue; }
    if (cur) {
      let m;
      if ((m = line.match(/^picture:\s*(\S+)/))) { cur.picture = m[1]; continue; }
      if ((m = line.match(/^sketch:\s*(\S+)/))) { cur.sketch = m[1]; continue; }
      if ((m = line.match(/^mock:\s*(\S+)/))) { cur.mock = m[1]; continue; }
      if ((m = line.match(/^-\s+(P\d+\.\d+)\s+(.+)$/))) {
        const body = m[2]; const at = body.lastIndexOf('→');
        const text_ = (at >= 0 ? body.slice(0, at) : body).trim(); const number = at >= 0 ? body.slice(at + 1).trim() : '';
        cur.promises.push({ id: m[1], part: cur.n, text: text_, number }); continue;
      }
      if (line.trim() && !/^-\s/.test(line)) cur.prose.push(line.trim());
      continue;
    }
    if (list && /^-\s+/.test(line)) list.push(line.replace(/^-\s+/, '').trim());
  }
  const slug = (text.match(new RegExp(`^#\\s+Idea\\s+${D}\\s+(.+)$`, 'm')) || [, 'build'])[1].trim();
  return { title: head.title || slug, slug, page: head.page || '', for: head.for || '', hurts: head.hurts || '', exists: head.exists || '', because: head.because || '',
    purpose: head.purpose || '', done: head.done || '', look: (head.look || '').toLowerCase(), journey, parts, promises: parts.flatMap(p => p.promises), later, never };
}
function serializeIdea(i) {
  const out = [`# Idea — ${i.slug}`];
  for (const k of ['title', 'page', 'for', 'hurts', 'exists', 'because', 'purpose', 'done', 'look']) if (i[k]) out.push(`${k}: ${i[k]}`);
  if (i.journey.length) { out.push('', '## Journey'); for (const j of i.journey) out.push(`- ${j.picture}: ${j.caption}`); }
  for (const p of i.parts) {
    out.push('', `### Part ${p.n} — ${p.title}`); if (p.picture) out.push(`picture: ${p.picture}`);
    for (const t of p.prose) out.push(t);
    for (const x of p.promises) out.push(`- ${x.id} ${x.text} → ${x.number}`);
    if (p.mock) out.push(`mock: ${p.mock}`); if (p.sketch) out.push(`sketch: ${p.sketch}`);
  }
  if (i.later.length) { out.push('', '## Later'); for (const x of i.later) out.push(`- ${x}`); }
  if (i.never.length) { out.push('', '## Never'); for (const x of i.never) out.push(`- ${x}`); }
  return out.join('\n') + '\n';
}
function lintIdea(dir, idea) {
  const problems = []; const lib = JSON.parse(read(path.join(PLUGIN_ROOT, 'templates', 'pictures.json')));
  const pic = (k, where) => { if (!k) problems.push(`${where}: no picture`); else if (k.startsWith('file:')) { if (!fs.existsSync(path.join(dir, k.slice(5)))) problems.push(`${where}: picture file missing ${k.slice(5)}`); } else if (!lib[k]) problems.push(`${where}: unknown picture key "${k}"`); };
  for (const k of ['title', 'purpose', 'for', 'hurts', 'exists', 'because', 'done']) if (!idea[k]) problems.push(`no ${k}: line`);
  if (idea.done && !/\d/.test(idea.done)) problems.push('done: has no number in it');
  if (idea.done && idea.done.split(/\s+/).length > 25) problems.push(`done: is ${idea.done.split(/\s+/).length} words; one number and a date, under 25 words`);
  if (idea.look && !['premium', 'clean', 'match'].includes(idea.look)) problems.push(`look: must be premium, clean or match (got "${idea.look}")`);
  if (!idea.parts.length) problems.push('no ### Part blocks');
  if (idea.journey.length === 1) problems.push('journey needs at least a first and a last moment');
  idea.journey.forEach((j, i) => pic(j.picture, `journey step ${i + 1}`));
  for (const p of idea.parts) {
    const words = [...p.prose, ...p.promises.map(x => x.text + ' ' + x.number)].join(' ').split(/\s+/).filter(Boolean).length;
    if (words > 150) problems.push(`part ${p.n}: ${words} words, limit 150`);
    pic(p.picture, `part ${p.n}`);
    if (!p.promises.length) problems.push(`part ${p.n}: no promises`);
    for (const x of p.promises) if (!x.number) problems.push(`${x.id}: no number after →`);
    if (p.fence) problems.push(`part ${p.n}: a fenced text sketch is not rendered; use an SVG sketch or a mock`);
    if (p.sketch && !fs.existsSync(path.join(dir, p.sketch))) problems.push(`part ${p.n}: sketch file missing ${p.sketch}`);
    if (p.mock && !fs.existsSync(path.join(dir, p.mock))) problems.push(`part ${p.n}: mock file missing ${p.mock}`);
    if ((idea.look === 'premium' || idea.look === 'clean') && p.sketch && !p.mock) problems.push(`part ${p.n}: a ${idea.look} look needs a mock: for this visual part`);
  }
  return problems;
}

// ---------- plan.md ----------
function parsePlan(text) {
  const slices = []; let cur = null; const risks = [], questions = []; const sections = {};
  for (const line of lines(text)) {
    const sec = line.match(/^##\s+(\d+)\.\s+(.+)$/); if (sec) { sections[+sec[1]] = sec[2].trim(); cur = null; continue; }
    const h = line.match(new RegExp(`^###\\s+Slice\\s+(\\d+)\\s+${D}\\s+(.+)$`));
    if (h) { cur = { n: +h[1], title: h[2].replace(/\s*\(.*\)\s*$/, '').trim(), steps: [] }; slices.push(cur); continue; }
    const s = line.match(/^-\s+\[[ xX]\]\s+(S\d+\.\d+)\s+(.+)$/);
    if (s && cur) {
      const rest = s[2];
      const arrow = rest.search(/→\s*(P\d+\.\d+|all)\b/);
      const text_ = (arrow >= 0 ? rest.slice(0, arrow) : rest).trim().replace(/\.$/, '');
      const tail = arrow >= 0 ? rest.slice(arrow + 1) : '';
      const promises = (tail.split('·')[0].match(/P\d+\.\d+/g)) || [];
      const vm = tail.match(/verify:\s*(.+?)(?:\s+·\s+≈|$)/); const raw = vm ? vm[1].trim() : '';
      const cm = raw.match(/^`([^`]+)`\s*(?:→\s*(.+))?$/);
      const verify = { raw, cmd: cm ? cm[1].trim() : '', expected: cm && cm[2] ? cm[2].trim() : '' };
      const em = tail.match(/≈\s*(\d+(?:\.\d+)?)\s*(h|hr|hours?|min|minutes?|d|days?)/); let estimate = null;
      if (em) { const v = +em[1]; estimate = /^d/.test(em[2]) ? v * 8 : /^min/.test(em[2]) ? v / 60 : v; }
      cur.steps.push({ id: s[1], slice: cur.n, text: text_, promises, verify, estimate });
    }
    const r = line.match(/^-\s+(R\d+)\s+(.+)$/); if (r) risks.push({ id: r[1], text: r[2].trim() });
    const q = line.match(/^-\s+(Q\d+)\s+(.+)$/); if (q) questions.push({ id: q[1], text: q[2].trim() });
  }
  return { slices, steps: slices.flatMap(x => x.steps), risks, questions, sections, text };
}
const planSection = (plan, n) => { const m = plan.text.split(new RegExp(`^##\\s+${n}\\.\\s[^\\n]*\\n`, 'm'))[1]; return m ? m.split(/^##\s+\d+\.\s/m)[0] : ''; };

// ---------- receipts.md ----------
function parseReceipts(text) {
  const receipts = []; let cur = null;
  for (const line of lines(text)) {
    const h = line.match(new RegExp(`^##\\s+RECEIPT\\s+${D}\\s+(\\S+)\\s+·\\s+(.+?)\\s+·\\s+(.+?)\\s+·\\s+(\\S+)\\s*$`));
    if (h) { cur = { stage: h[1], slug: h[2], result: h[3].trim(), ts: h[4], lines: [], idx: receipts.length }; receipts.push(cur); continue; }
    const l = line.match(/^-\s+\[([ xX])\]\s+(.+)$/); if (l && cur) cur.lines.push({ done: l[1] !== ' ', text: l[2].trim() });
  }
  return receipts;
}
function appendReceipt(dir, stage, result, body) {
  const ts = new Date().toISOString().replace(/\.\d{3}Z$/, 'Z'); const slug = path.basename(dir);
  const text = body.map(l => (l.startsWith('[ ]') ? `- ${l}` : `- [x] ${l.replace(/^\[x\]\s*/, '')}`)).join('\n');
  fs.appendFileSync(path.join(dir, 'receipts.md'), `\n## RECEIPT — ${stage} · ${slug} · ${result} · ${ts}\n${text}\n`);
  return ts;
}

// ---------- state ----------
function computeState(dir) {
  const idea = parseIdea(read(path.join(dir, 'idea.md')));
  const plan = parsePlan(read(path.join(dir, 'plan.md')));
  const receipts = parseReceipts(read(path.join(dir, 'receipts.md')));
  const slug = path.basename(dir);
  const flags = { questions: 0, questionsOf: 0, ideaDrafted: false, ideaApproved: false, lookApproved: false, planDrafted: false, planApproved: false, released: false, writeback: false, gate3: false, gate4: false, preflight: false, rehearsal: false };
  const proven = new Map(); // step id → receipt idx
  const attacks = {}; // `${A} ${promise}` → { id, promise, attempts:[{k,result,idx}], resolved }
  const supersededAt = {}; // promise id → receipt idx of the last supersede touching it
  const live = {}; const unmeasured = new Set(); const decisions = [], leftovers = []; let ask = null, watch = null, amends = 0;
  for (const r of receipts) {
    let m;
    if (r.stage === 'idea') { if ((m = r.result.match(/^question\s+(\d+)\s+of\s+(\d+)/))) { flags.questions = Math.max(flags.questions, +m[1]); flags.questionsOf = +m[2]; } if (/^drafted$/.test(r.result)) flags.ideaDrafted = true; if (/^approved$/.test(r.result)) flags.ideaApproved = true; if (/^look approved$/.test(r.result)) flags.lookApproved = true; }
    if (r.stage === 'plan') { if (/^drafted$|^revised$/.test(r.result)) flags.planDrafted = true; if (/^approved$/.test(r.result)) flags.planApproved = true; }
    if (r.stage === 'build' && (m = r.result.match(/^step\s+(S\d+\.\d+)\s+proven$/))) proven.set(m[1], r.idx);
    if (r.stage === 'build' && /^gate 3$/.test(r.result)) flags.gate3 = true;
    if (r.stage === 'attack' && (m = r.result.match(/^(A\d+|L\d+)\s+(P\d+\.\d+|all|page|plan)\s+attempt\s+(\d)\s+(held|broke|resolved)$/))) {
      const key = `${m[1]} ${m[2]}`; (attacks[key] = attacks[key] || { id: m[1], promise: m[2], attempts: [], resolved: false });
      if (m[4] === 'resolved') attacks[key].resolved = true; else attacks[key].attempts.push({ k: +m[3], result: m[4], idx: r.idx });
    }
    if (r.stage === 'deploy') { if (/^preflight$/.test(r.result)) flags.preflight = true; if (/^rehearsal$/.test(r.result)) flags.rehearsal = true; if (/^gate 4$/.test(r.result)) flags.gate4 = true; if (/^released$/.test(r.result)) flags.released = true; if (/^writeback$/.test(r.result)) flags.writeback = true; }
    if (r.stage === 'amend' && /edited$/.test(r.result)) amends++;
    for (const l of r.lines) {
      if ((m = l.text.match(/^decision:\s*(.+)$/))) decisions.push({ ts: r.ts, text: m[1] });
      if ((m = l.text.match(/^leftover:\s*(.+)$/))) leftovers.push({ ts: r.ts, text: m[1] });
      if ((m = l.text.match(/^(P\d+\.\d+):\s*live\s+(.+?)\s*(✓|✗)$/))) { live[m[1]] = { value: m[2], ok: m[3] === '✓' }; unmeasured.delete(m[1]); }
      if ((m = l.text.match(/^(P\d+\.\d+):\s*not measured/))) unmeasured.add(m[1]);
      if ((m = l.text.match(/^supersede:\s*(.+)$/))) for (const id of m[1].split(/[\s,]+/).filter(Boolean)) { proven.delete(id); const st = plan.steps.find(s => s.id === id); if (st) for (const pid of st.promises) supersededAt[pid] = r.idx; }
      if ((m = l.text.match(/^watch:\s*until\s+(\S+)/))) watch = m[1];
      if (/^retract:\s*writeback/.test(l.text)) { for (const k of Object.keys(live)) delete live[k]; unmeasured.clear(); flags.writeback = false; watch = null; }
      const a = !l.done && l.text.match(/^ask:\s*(.+)$/); if (a) ask = a[1];
      if (/^answered:/.test(l.text)) ask = null;
    }
  }
  const promises = idea.promises.map(p => {
    const steps = plan.steps.filter(s => s.promises.includes(p.id)); const done = steps.filter(s => proven.has(s.id)).length;
    const cut = supersededAt[p.id] || -1;
    const mine = Object.values(attacks).filter(a => a.promise === p.id).map(a => ({ ...a, attempts: a.attempts.filter(x => x.idx > cut) })).filter(a => a.attempts.length || a.resolved);
    let state = 'planned';
    if (done > 0) state = 'building';
    if (steps.length && done === steps.length) state = 'built';
    if (state === 'built' && mine.length) {
      const last = mine.map(a => a.resolved ? { result: 'held', k: 2, resolved: true } : a.attempts[a.attempts.length - 1]);
      const unresolved = last.filter(x => x.result === 'broke');
      if (unresolved.length) state = unresolved.some(x => x.k >= 2) ? 'needs you' : 'broke';
      else state = mine.some(a => a.resolved || a.attempts.some(x => x.result === 'broke')) ? 'fixed' : 'held';
    }
    const lv = live[p.id] && ['built', 'held', 'fixed'].includes(state) ? live[p.id] : null;
    if (lv) state = lv.ok ? 'live' : 'live ✗';
    return { ...p, steps: steps.length, done, state, live: lv, unmeasured: unmeasured.has(p.id) };
  });
  const total = plan.steps.length, provenCount = plan.steps.filter(s => proven.has(s.id)).length;
  const nextStep = plan.steps.find(s => !proven.has(s.id)) || null;
  const allProven = total > 0 && provenCount === total;
  const curPartN = nextStep ? (idea.promises.find(p => p.id === nextStep.promises[0]) || {}).part : null;
  const curPart = idea.parts.find(p => p.n === curPartN) || null;
  const partsDone = idea.parts.filter(pt => { const ps = promises.filter(p => p.part === pt.n); return ps.length && ps.every(p => p.steps && p.done === p.steps); }).length;
  const liveOk = promises.filter(p => p.live && p.live.ok).length, liveBad = promises.filter(p => p.live && !p.live.ok).length;
  const watchOver = !!(watch && today() > watch);

  let stage, next, line;
  const qOf = flags.questionsOf || 11;
  if (flags.writeback) { stage = 'live'; next = liveBad ? 'a live number is ✗; change that part' : watchOver ? 're-measure the live numbers' : watch ? `watch until ${watch}` : 'done'; line = `Live · ${liveOk} of ${promises.length} promises measured ✓${liveBad ? ` · ${liveBad} ✗` : ''} · ${liveBad ? 'next: I change the ✗ part with you' : watchOver ? 'watch period over · next: I re-measure' : watch ? `watch until ${day(watch)}` : 'no watch date set'}`; }
  else if (flags.released) { stage = 'deploy'; next = 'write back the live numbers'; line = 'Going live · next: I measure every promise on the live system'; }
  else if (flags.planApproved && allProven && leftovers.length && !flags.gate3) { stage = 'build'; next = 'accept the leftovers (gate 3)'; line = `Built · ${provenCount} of ${total} steps done · next: accept what was set aside (your call)`; }
  else if (flags.planApproved && allProven) { stage = 'deploy'; next = flags.preflight && flags.rehearsal ? 'deploy to production (gate 4)' : 'pre-flight and rehearse the undo'; line = flags.preflight && flags.rehearsal ? 'Ready to go live · next: your go-ahead' : 'Built · next: I run the safety checks and practise the undo'; }
  else if (flags.planApproved) { stage = 'build'; next = `build ${nextStep.id}`; line = `Building · Part ${curPart ? curPart.n : '?'} of ${idea.parts.length}${curPart ? `, ${curPart.title}` : ''} · ${provenCount} of ${total} steps done · next: I keep building; nothing needed from you`; }
  else if (flags.planDrafted) { stage = 'plan'; next = 'approve the plan (gate 2)'; line = 'Plan ready · next: your approval, on one screen'; }
  else if (flags.ideaApproved) { stage = 'plan'; next = 'write the plan'; line = 'Planning · next: I read your code and write the plan; nothing needed from you'; }
  else if (flags.ideaDrafted) { stage = 'idea'; next = 'approve the Idea page (gate 1)'; line = 'Idea page ready · next: your approval'; }
  else if (flags.questions > 0) { stage = 'idea'; next = `question ${flags.questions + 1} of ${qOf}`; line = `Idea · question ${flags.questions} of ${qOf} answered · next: question ${flags.questions + 1}`; }
  else { stage = 'idea'; next = 'start the interview'; line = 'Not started · next: a short interview about your idea'; }
  if (ask) line += ` · for you: ${ask}`;

  return { slug, title: idea.title, page: idea.page, version: 1 + amends, stage, line, next, ask, watch, watchOver, flags,
    slices: plan.slices.map(s => ({ n: s.n, title: s.title, total: s.steps.length, done: s.steps.filter(x => proven.has(x.id)).length })),
    steps: { total, proven: provenCount, next: nextStep && nextStep.id, nextText: nextStep && nextStep.text }, partsDone,
    parts: idea.parts.map(p => ({ n: p.n, title: p.title })), promises, risks: plan.risks, questions: plan.questions, decisions, leftovers,
    attacks: Object.values(attacks).map(a => ({ key: `${a.id} ${a.promise}`, ...a })),
    productAttacks: Object.values(attacks).filter(a => a.promise === 'all').map(a => ({ id: a.id, last: a.attempts[a.attempts.length - 1] })) };
}

// ---------- receipt validation ----------
function validateReceipt(dir, stage, result, body) {
  const base = path.basename(dir); if (/\s/.test(base)) return `the build folder name "${base}" has a space; use kebab-case`;
  if (!['idea', 'plan', 'build', 'attack', 'deploy', 'amend'].includes(stage)) return `unknown stage "${stage}"`;
  const st = computeState(dir); const plan = parsePlan(read(path.join(dir, 'plan.md'))); const idea = parseIdea(read(path.join(dir, 'idea.md')));
  const has = re => body.some(l => re.test(l.replace(/^\[[ x]\]\s*/, '')));
  let m;
  if (stage === 'idea' && /^approved$/.test(result) && !st.flags.ideaDrafted) return 'idea approved before idea drafted';
  if (stage === 'plan' && /^drafted$/.test(result) && !st.flags.ideaApproved) return 'plan drafted before the idea was approved';
  if (stage === 'plan' && /^approved$/.test(result) && !st.flags.planDrafted) return 'plan approved before plan drafted';
  if (stage === 'build' && (m = result.match(/^step\s+(S\d+\.\d+)\s+proven$/))) {
    const step = plan.steps.find(s => s.id === m[1]); if (!step) return `${m[1]} is not a step in plan.md`;
    if (!st.flags.planApproved) return 'a step cannot be proven before the plan is approved';
    const v = body.map(l => l.replace(/^\[[ x]\]\s*/, '')).find(l => /^verify:/.test(l));
    if (!v) return 'a proven step needs a line "verify: <command> → <output>"';
    if (!/→/.test(v)) return 'the verify line needs "→ <output>" with the fresh output';
    if (step.verify.cmd && !v.includes(step.verify.cmd)) return `the verify line must run the step's own command: ${step.verify.cmd}`;
    if (step.verify.expected && !v.split('→').slice(1).join('→').includes(step.verify.expected)) return `the output does not contain the expected "${step.verify.expected}"`;
  }
  if (stage === 'build' && /^fix (A|L)\d+/.test(result)) { if (!has(/^check added:/)) return 'a fix needs "check added: <path>"'; if (!has(/^red:/)) return 'a fix needs "red: <command> → <output on the old code>"'; }
  if (stage === 'deploy' && /^(released|writeback)$/.test(result) && !(st.steps.total && st.steps.proven === st.steps.total)) return `cannot ${result}: ${st.steps.proven} of ${st.steps.total} steps proven`;
  if (stage === 'deploy' && /^released$/.test(result) && !(st.flags.preflight && st.flags.rehearsal && st.flags.gate4)) return 'released needs preflight, rehearsal and gate 4 receipts first';
  if (stage === 'deploy' && /^writeback$/.test(result) && !st.flags.released) return 'writeback before released';
  if (stage === 'amend' && (m = result.match(/^part\s+(\d+)\s+edited$/))) {
    if (!has(/^decision:/)) return 'an amend needs a "decision:" line';
    const sup = body.map(l => l.replace(/^\[[ x]\]\s*/, '')).find(l => /^supersede:/.test(l));
    if (sup) for (const id of sup.replace(/^supersede:\s*/, '').split(/[\s,]+/).filter(Boolean)) {
      const step = plan.steps.find(s => s.id === id); if (!step) return `supersede names ${id}, not a step in plan.md`;
      if (!step.promises.some(p => (idea.promises.find(x => x.id === p) || {}).part === +m[1])) return `supersede names ${id}, which serves no promise of part ${m[1]}`;
    }
  }
  return null;
}

// ---------- card ----------
const dot = { planned: '', building: 'b', built: 'b', held: 'h', fixed: 'h', live: 'l', broke: 'x', 'needs you': 'x', 'live ✗': 'x' };
function shotsFor(dir, prefix) {
  const d = path.join(dir, 'shots'); if (!fs.existsSync(d)) return [];
  return fs.readdirSync(d).filter(f => f.endsWith('.png') && (!prefix || f.startsWith(prefix))).sort().slice(0, 8).map(f => ({ name: f.replace(/\.png$/, ''), uri: `data:image/png;base64,${fs.readFileSync(path.join(d, f)).toString('base64')}` }));
}
function renderCard(st, dir) {
  const tpl = read(path.join(PLUGIN_ROOT, 'templates', 'card.html'));
  const pct = st.steps.total ? Math.round(100 * st.steps.proven / st.steps.total) : 0;
  const parts = st.parts.map(p => {
    const rows = st.promises.filter(x => x.part === p.n).map(x => `<div class="row"><i class="dot ${dot[x.state] || ''}"></i><span>${esc(x.text)}</span><span class="st ${/held|fixed|^live$/.test(x.state) ? 'h' : ''}${/broke|needs|✗/.test(x.state) ? ' x' : ''}">${esc(x.live ? `live: ${x.live.value} ${x.live.ok ? '✓' : '✗'}` : x.unmeasured ? 'not yet measured' : x.state)}</span></div>`).join('');
    return `<div class="part"><h3>Part ${p.n} · ${esc(p.title)}</h3>${rows}</div>`;
  }).join('') + (st.productAttacks.length ? `<div class="part"><h3>Whole product</h3>${st.productAttacks.filter(a => a.last).map(a => `<div class="row"><i class="dot ${a.last.result === 'held' ? 'h' : 'x'}"></i><span>whole-product check ${esc(a.id.replace(/^A/, ''))} · attempt ${a.last.k}</span><span class="st ${a.last.result === 'held' ? 'h' : 'x'}">${esc(a.last.result)}</span></div>`).join('')}</div>` : '');
  const slices = st.slices.map(s => `<div class="slice${s.n === 1 ? ' sk' : ''}"><span class="k">${s.n}</span><span>${esc(s.title)}</span><span class="n">${s.done}/${s.total}</span></div>`).join('');
  const risks = st.risks.slice(0, 3).map((r, i) => `<div><i>${i + 1}</i><span>${esc(r.text)}</span></div>`).join('');
  const decisions = st.decisions.length ? st.decisions.map(d => `<div><time>${esc(day(d.ts))}</time><span>${esc(d.text)}</span></div>`).join('') : '<div><time>—</time><span>None yet.</span></div>';
  const leftovers = st.leftovers.length ? st.leftovers.map(d => `<div><time>${esc(day(d.ts))}</time><span>${esc(d.text)}</span></div>`).join('') : '<div><time>—</time><span>Nothing set aside. Items appear here when a problem is accepted in writing.</span></div>';
  const counts = st.promises.reduce((a, p) => (a[p.state] = (a[p.state] || 0) + 1, a), {}); const summary = Object.entries(counts).map(([k, v]) => `${v} ${k}`).join(' · ');
  const ask = st.ask ? `<div class="ask"><h2>For you</h2><b>${esc(st.ask)}</b></div>` : '';
  const shots = dir ? shotsFor(dir) : []; const shotsHtml = shots.length ? `<div><h2>Screens</h2><div class="shots">${shots.map(s => `<figure><img src="${s.uri}" alt="${esc(s.name)}"><figcaption>${esc(s.name.replace(/-/g, ' '))}</figcaption></figure>`).join('')}</div></div>` : '';
  return tpl.replace(/\{\{(\w+)\}\}/g, (_, k) => ({ TITLE: esc(st.title), LINE: esc(st.line), PCT: pct, ASK: ask, SLICES: slices, RISKS: risks ? `<h2 style="margin-top:6px">The biggest risks</h2><div class="risks">${risks}</div>` : '', PAGE: st.page && /^https?:/.test(st.page) ? `<a href="${esc(st.page)}">Idea page</a>` : '', PARTS: parts, SUMMARY: esc(summary), NPROMISES: st.promises.length, DECISIONS: decisions, NDEC: st.decisions.length, LEFTOVERS: leftovers, NLEFT: st.leftovers.length, SHOTS: shotsHtml, VERSION: `v${st.version}` }[k] ?? ''));
}

// ---------- idea page ----------
function renderIdeaPage(dir, idea, st) {
  const tpl = read(path.join(PLUGIN_ROOT, 'templates', 'idea-page.html')); const lib = JSON.parse(read(path.join(PLUGIN_ROOT, 'templates', 'pictures.json')));
  const live = {}; if (st) for (const p of st.promises) if (p.live) live[p.id] = p.live;
  const anyLive = Object.keys(live).length > 0;
  const pic = (key, label) => key.startsWith('file:') ? read(path.join(dir, key.slice(5))) : `<svg viewBox="0 0 240 160" role="img" aria-label="${esc(label)}">${lib[key] || ''}</svg>`;
  const parts = idea.parts.map(p => {
    const promises = p.promises.map(x => { const l = live[x.id]; const badge = l ? `<span class="live${l.ok ? '' : ' bad'}">live: ${esc(l.value)} ${l.ok ? '✓' : '✗'}</span>` : anyLive ? `<span class="n muted">not yet measured</span>` : `<span class="n">${esc(x.number)}</span>`; return `<li><span class="tick">✓</span><span>${esc(x.text)}</span>${badge}</li>`; }).join('');
    let look = '';
    const shots = shotsFor(dir, `part-${p.n}-`);
    if (p.mock && shots.length) look = `<div class="sketch"><div class="plabel">How it will look · the approved mock</div><div class="shots">${shots.map(s => `<figure><img src="${s.uri}" alt="${esc(s.name)}"><figcaption>${esc(s.name.replace(`part-${p.n}-`, '').replace(/-/g, ' '))}</figcaption></figure>`).join('')}</div></div>`;
    else if (p.mock) look = `<div class="sketch"><div class="plabel">How it will look · the approved mock</div><iframe class="mock" title="mock of ${esc(p.title)}" srcdoc="${esc(read(path.join(dir, p.mock)))}"></iframe></div>`;
    else if (p.sketch) look = `<div class="sketch"><div class="plabel">How it will look</div>${read(path.join(dir, p.sketch))}</div>`;
    return `<section id="part-${p.n}"><div class="part"><figure>${pic(p.picture, p.title)}</figure><div class="words"><div class="eyebrow">Part ${p.n}</div><h2>${esc(p.title)}</h2>${p.prose.map(t => `<p>${esc(t)}</p>`).join('')}<div class="plabel">What you will be able to do</div><ul class="promises">${promises}</ul></div></div>${look}</section>`;
  }).join('');
  const out = (idea.later.length || idea.never.length) ? `<section id="out"><div class="eyebrow">Out, for now</div><h2>What this will not do</h2>${idea.later.length ? `<div class="plabel">Later</div><div class="never">${idea.later.map(x => `<span>${esc(x)}</span>`).join('')}</div>` : ''}${idea.never.length ? `<div class="plabel">Never</div><div class="never out">${idea.never.map(x => `<span>${esc(x)}</span>`).join('')}</div>` : ''}</section>` : '';
  const hero = idea.journey.length
    ? `<div class="journey">${idea.journey.map((j, i) => `<div class="step"><div class="pic">${pic(j.picture, j.caption)}</div><div class="cap"><span class="k">${i + 1}</span>${esc(j.caption)}</div></div>`).join('<div class="arrow" aria-hidden="true">→</div>')}</div>`
    : `<div class="hero-fig">${idea.parts.map(p => `<div>${pic(p.picture, p.title)}</div>`).join('')}</div>`;
  const exists = idea.exists ? `<div><b>What you use today</b>${esc(idea.exists)}</div><div><b>Why build this anyway</b>${esc(idea.because)}</div>` : '';
  const date = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
  return tpl.replace(/\{\{(\w+)\}\}/g, (_, k) => ({ TITLE: esc(idea.title), PURPOSE: esc(idea.purpose), FOR: esc(idea.for), HURTS: esc(idea.hurts), DONE: esc(idea.done), EXISTS: exists, VERSION: `v${st ? st.version : 1}`, DATE: date, HERO: hero, PARTS: parts, OUT: out, NPROMISES: idea.promises.length, NPARTS: idea.parts.length, LIVENOTE: anyLive ? `<span>${Object.values(live).filter(l => l.ok).length} of ${idea.promises.length} promises measured on the live system</span>` : '' }[k] ?? ''));
}

// ---------- spec ----------
function specCheck(dir) {
  const text = read(path.join(dir, 'spec.md')); if (!text) return ['spec.md missing'];
  const idea = parseIdea(read(path.join(dir, 'idea.md'))); const ids = new Set(idea.promises.map(p => p.id));
  const problems = []; let section = '', rules = 0;
  for (const line of lines(text)) {
    const h = line.match(/^##\s+(.+)$/); if (h) { section = h[1].trim(); continue; }
    if (/^-\s+/.test(line) && /^Rules/i.test(section)) { rules++; const m = line.match(/→\s*(P\d+\.\d+)\s*$/); if (!m) problems.push(`rule without a promise pointer: ${line.slice(0, 60)}`); else if (!ids.has(m[1])) problems.push(`rule points at ${m[1]}, which is not on the Idea page: ${line.slice(0, 50)}`); }
  }
  if (!/^##\s+Rules/m.test(text)) problems.push('no ## Rules section'); else if (!rules) problems.push('## Rules is empty');
  if (!/^##\s+Assumptions/m.test(text)) problems.push('no ## Assumptions section');
  return problems;
}

// ---------- attacks ----------
function parseCatalogue() {
  const text = read(path.join(PLUGIN_ROOT, 'shared', 'failure-catalogue.md')); const classes = []; let cur = null;
  for (const line of lines(text)) {
    const h = line.match(/^##\s+([a-z-]+)\s*$/); if (h) { cur = { key: h[1], likely: {}, applies: [], stages: ['build'] }; classes.push(cur); continue; }
    if (!cur) continue; const kv = line.match(/^(name|scope|stage|damage|applies|likely|attack|break|check):\s*(.+)$/); if (!kv) continue;
    if (kv[1] === 'damage') cur.damage = +kv[2]; else if (kv[1] === 'applies') cur.applies = kv[2].split(/\s+/); else if (kv[1] === 'stage') cur.stages = kv[2].split(/\s+/);
    else if (kv[1] === 'likely') for (const pair of kv[2].split(/\s+/)) { const [k, v] = pair.split('='); cur.likely[k] = +v; } else cur[kv[1]] = kv[2].trim();
  }
  return classes;
}
const KEYWORDS = { 'wrong-output': /\b(match|matches|correct|exact|rupee|difference|total|sum|count|number)\b/i, 'missing-output': /\b(every|all|100%|none|skipped|appears)\b/i, 'duplicate-output': /\b(once|one message|twice|duplicate|single)\b/i, 'stale-data': /\b(fresh|latest|today|current|updates?|within)\b/i, 'bad-input': /\b(paste|type|typed|input|upload|any link|any file)\b/i, 'retry': /\b(again|retry|rerun|re-run|twice|idempotent)\b/i, 'silent-failure': /\b(error|fails?|cannot|can't|never silently|tells you)\b/i, 'picture-mismatch': /\b(screen|tap|list|box|button|page|looks?|layout|one line)\b/i };
const TIME_OR_VOLUME = /\b(under|within|in|≤|<)\s*\d+\s*(s|sec|seconds?|ms|min|minutes?)\b|\b\d+\s*(s|ms)\b|\b\d{2,}\s*(rows|items|users|files|links|pdfs|per)\b/i;
const specKind = dir => { const m = read(path.join(dir, 'spec.md')).match(/^##\s+Kind\s*\n-\s*(\w+)/m); return m ? m[1].toLowerCase() : 'mixed'; };
function attackStates(dir) { const st = computeState(dir); const s = {}; for (const a of st.attacks) { const last = a.attempts[a.attempts.length - 1]; s[a.key] = a.resolved ? 'resolved' : last ? `attempt ${last.k} ${last.result}` : 'planned'; } return s; }
function chooseAttacks(dir, stage) {
  const classes = parseCatalogue();
  if (stage === 'idea' || stage === 'plan') return classes.filter(c => c.stages.includes(stage)).map((c, i) => ({ id: `A${i + 1}`, promise: stage === 'idea' ? 'page' : 'plan', key: c.key, name: c.name, when: stage }));
  const idea = parseIdea(read(path.join(dir, 'idea.md'))); const kind = specKind(dir); const kinds = kind === 'mixed' ? ['visual', 'data', 'service'] : [kind];
  const build = classes.filter(c => c.stages.includes('build')); const fits = c => kinds.some(k => c.applies.includes(k)); const likely = c => Math.max(...kinds.map(k => c.likely[k] || 0));
  const byKey = Object.fromEntries(build.map(c => [c.key, c])); const rows = []; let n = 1;
  for (const c of build.filter(c => c.scope === 'product' && fits(c)).sort((a, b) => b.damage * likely(b) - a.damage * likely(a))) rows.push({ id: `A${n++}`, promise: 'all', key: c.key, name: c.name, when: 'last part', score: c.damage * likely(c) });
  for (const p of idea.promises) {
    const part = idea.parts.find(x => x.n === p.part); const forced = [];
    if (part && (part.mock || part.sketch) && byKey['picture-mismatch']) forced.push('picture-mismatch');
    if (TIME_OR_VOLUME.test(p.text + ' ' + p.number) && byKey['load']) forced.push('load');
    for (const k of forced) rows.push({ id: `A${n++}`, promise: p.id, key: k, name: byKey[k].name, when: `part ${p.part}`, forced: true });
    const scored = build.filter(c => c.scope !== 'product' && c.key !== 'picture-mismatch' && fits(c) && !forced.includes(c.key)).map((c, i) => ({ c, i, score: c.damage * likely(c) + (KEYWORDS[c.key] && KEYWORDS[c.key].test(p.text + ' ' + p.number) ? 12 : 0) })).sort((a, b) => b.score - a.score || a.i - b.i).slice(0, 2);
    for (const s of scored) rows.push({ id: `A${n++}`, promise: p.id, key: s.c.key, name: s.c.name, when: `part ${p.part}`, score: s.score });
  }
  return rows;
}
function writeAttacks(dir, stage, rows) {
  const states = attackStates(dir);
  const out = [`# Attacks — ${path.basename(dir)} · stage ${stage}`, '', 'Chosen by scripts/compass attacks. Do not edit by hand. The state column is read from receipts.md.', '', '| Attack | Promise | Class | What it tries | When | State |', '|---|---|---|---|---|---|', ...rows.map(r => `| ${r.id} | ${r.promise} | ${r.key} | ${r.name}${r.forced ? ' (always for this promise)' : ''} | ${r.when} | ${states[`${r.id} ${r.promise}`] || 'planned'} |`), ''];
  fs.writeFileSync(path.join(dir, 'attacks.md'), out.join('\n'));
}
const RECEIPT_SHAPE = /^(held|broke:\s.+?\s(?:→|->)\sobserved\s.+?,\sexpected\s.+)$/;
function checkReceiptLine(message) {
  const t = String(message).replace(/\s+$/, '');
  if (/\n/.test(t)) return 'rejected: the whole message must be one line';
  if (!RECEIPT_SHAPE.test(t)) return 'rejected: the line must be exactly `held` or `broke: <reproduction> → observed <x>, expected <y>`';
  const tail = t.split(/expected\s/)[1] || '';
  if (/\balso\b|;|\(\d\)|\b\d\)|\bnote\b|\bin addition\b/i.test(tail)) return 'rejected: the expected clause carries extra findings; one break per line';
  return null;
}

// ---------- the look ----------
const LOOK_ITEMS = ['hierarchy', 'spacing', 'type', 'color', 'components', 'states', 'alignment', 'polish', 'responsive', 'copy', 'depth', 'structure', 'controls'];
const LOOK_SHAPE = new RegExp(`^scores:\\s*((?:[a-z]+=[1-5]\\s*){${LOOK_ITEMS.length}})(?:\\|\\s*low:\\s*(.*))?$`);
function parseLookLine(line) {
  const m = LOOK_SHAPE.exec(String(line).trim()); if (!m) return null;
  const scores = {}; for (const pair of m[1].trim().split(/\s+/)) { const [k, v] = pair.split('='); scores[k] = +v; }
  if (LOOK_ITEMS.some(k => !(k in scores))) return null;
  const low = {}; if (m[2]) for (const part of m[2].split(';')) { const mm = part.trim().match(/^([a-z]+)@"(.+)"$/); if (mm) low[mm[1]] = mm[2]; }
  return { scores, low };
}
function lookScore(level, ls) {
  const bars = { premium: { min: 4, none: 2 }, clean: { min: 3, none: 1 } };
  if (level === 'match') return { result: 'held', note: 'match level: no rubric; conformance only' };
  const bar = bars[level]; if (!bar) return { error: `unknown level ${level}` };
  const parsed = ls.map(parseLookLine); if (parsed.some(p => !p)) return { error: 'a reviewer line is not in the required shape' };
  const medians = {}, regions = {};
  for (const k of LOOK_ITEMS) { const v = parsed.map(p => p.scores[k]).sort((a, b) => a - b); medians[k] = v[Math.floor(v.length / 2)]; regions[k] = parsed.map(p => p.low[k]).filter(Boolean); }
  const failing = LOOK_ITEMS.filter(k => medians[k] < bar.min || medians[k] <= bar.none);
  if (!failing.length) return { result: 'held', medians };
  return { result: `broke: look below the ${level} bar → observed ${failing.map(k => `${k}=${medians[k]}${regions[k].length ? ` (${regions[k].join(' / ')})` : ''}`).join('; ')}, expected every median ≥ ${bar.min}`, medians, failing };
}
function rubricLint() {
  const text = read(path.join(PLUGIN_ROOT, 'shared', 'look-rubric.md')); const problems = [];
  for (const k of LOOK_ITEMS) { const block = text.split(`\n## ${k}\n`)[1]; if (!block) { problems.push(`item ${k} missing`); continue; } const head = block.split('\n## ')[0]; for (const f of ['name:', 'ask:', '5:', '3:', '1:']) if (!head.includes(`\n${f} `) && !head.startsWith(`${f} `)) problems.push(`${k}: ${f} missing`); }
  if (!/^premium:/m.test(text) || !/^clean:/m.test(text) || !/^match:/m.test(text)) problems.push('bars missing');
  return problems;
}
function chromePath() { return ['/Applications/Google Chrome.app/Contents/MacOS/Google Chrome', '/Applications/Chromium.app/Contents/MacOS/Chromium', '/usr/bin/google-chrome', '/usr/bin/chromium', '/usr/bin/chromium-browser'].find(p => fs.existsSync(p)) || null; }
function shots(target, outDir, name, states) {
  const chrome = chromePath(); if (!chrome) return { error: 'no Chrome or Chromium found; screenshots skipped' };
  fs.mkdirSync(outDir, { recursive: true });
  const base = /^https?:\/\//.test(target) ? target : 'file://' + path.resolve(target);
  const profile = path.join(os.tmpdir(), 'compass-chrome-profile');
  const common = ['--headless=new', '--disable-gpu', '--no-first-run', '--hide-scrollbars', '--allow-file-access-from-files', `--user-data-dir=${profile}`, '--virtual-time-budget=4000'];
  const out = [];
  for (const state of (states && states.length ? states : [''])) {
    const url = state ? `${base}${base.includes('?') ? '&' : '?'}state=${state}` : base; const suffix = state ? `-${state}` : '';
    for (const [label, width] of [['phone', 390], ['desktop', 1200]]) {
      const wrap = path.join(outDir, `.${name}${suffix}-${label}-frame.html`);
      fs.writeFileSync(wrap, `<!doctype html><html><head><meta charset="utf-8"><style>html,body{margin:0;background:#e9edf1}iframe{display:block;width:${width}px;border:0;margin:0 auto;background:#fff}</style></head><body><iframe id="f" src="${url}"></iframe><div id="h" hidden></div><script>const f=document.getElementById('f');f.addEventListener('load',()=>{try{const h=Math.max(f.contentDocument.documentElement.scrollHeight,f.contentDocument.body.scrollHeight,400);f.style.height=h+'px';document.getElementById('h').textContent=String(h);}catch(e){f.style.height='2000px';document.getElementById('h').textContent='2000';}});</script></body></html>`);
      let height = 2000;
      try { const dom = execFileSync(chrome, [...common, `--window-size=${width + 40},1200`, '--dump-dom', 'file://' + wrap], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }); const m = dom.match(/id="h"[^>]*>(\d+)</); if (m) height = Math.min(+m[1] + 20, 12000); } catch {}
      const file = path.join(outDir, `${name}${suffix}-${label}.png`);
      execFileSync(chrome, [...common, `--window-size=${Math.max(width + 40, 500)},${height}`, `--screenshot=${file}`, 'file://' + wrap], { stdio: 'ignore' });
      try { fs.unlinkSync(wrap); } catch {}
      out.push(file);
    }
  }
  return { files: out };
}

// ---------- the gate suite, pre-flight, write-back, release note ----------
function gateSuite(dir) {
  const idea = parseIdea(read(path.join(dir, 'idea.md'))); const plan = parsePlan(read(path.join(dir, 'plan.md'))); const receipts = parseReceipts(read(path.join(dir, 'receipts.md')));
  const promiseChecks = []; const noCheck = [];
  for (const p of idea.promises) { const steps = plan.steps.filter(s => s.promises.includes(p.id)); const withCmd = steps.filter(s => s.verify.cmd); if (!withCmd.length) noCheck.push(p.id); for (const s of withCmd) promiseChecks.push({ promise: p.id, step: s.id, cmd: s.verify.cmd, expected: s.verify.expected }); }
  const breakChecks = []; for (const r of receipts) if (r.stage === 'build' && /^fix (A|L)\d+/.test(r.result)) for (const l of r.lines) { const m = l.text.match(/^check added:\s*(\S+)/); if (m) breakChecks.push({ attack: r.result.replace(/^fix /, ''), file: m[1] }); }
  return { promiseChecks, breakChecks, noCheck };
}
function runOne(cmd, cwd) { try { const out = execSync(cmd, { cwd, encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'], timeout: 180000 }); return { ok: true, out: out.trim() }; } catch (e) { return { ok: false, out: ((e.stdout || '') + (e.stderr || '')).toString().trim() || e.message, code: e.status }; } }
function runGates(dir, cwd) {
  const { promiseChecks, breakChecks } = gateSuite(dir); const results = []; const seen = new Map();
  for (const c of promiseChecks) {
    const key = c.cmd + '→' + c.expected; let r = seen.get(key);
    if (!r) { const run = runOne(c.cmd, cwd); const expectExit = !c.expected || /^exit\s*0$/i.test(c.expected); const pass = expectExit ? run.ok : run.out.includes(c.expected); r = { ok: pass, out: run.out.split('\n').pop() || '', expected: c.expected || 'exit 0' }; seen.set(key, r); }
    results.push({ kind: 'promise', id: `${c.promise} ← ${c.step}`, cmd: c.cmd, ...r });
  }
  for (const c of breakChecks) { const f = path.resolve(cwd, c.file); const cmd = /\.(js|mjs|cjs)$/.test(f) ? `node "${f}"` : /\.py$/.test(f) ? `python3 -I "${f}"` : `sh "${f}"`; const run = runOne(cmd, cwd); results.push({ kind: 'break', id: c.attack, cmd: c.file, ok: run.ok, out: run.out.split('\n').pop() || '', expected: 'exit 0' }); }
  return results;
}
const SECRET_PATTERNS = [/AKIA[0-9A-Z]{16}/, /\bsk-[A-Za-z0-9_-]{20,}/, /\bghp_[A-Za-z0-9]{36}\b/, /-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----/, /\b(?:password|passwd|secret|api[_-]?key|token)\s*[:=]\s*["'][^"'\s]{8,}["']/i];
function preflight(dir, cwd, opts) {
  const out = []; let ok = true; const bad = s => { out.push(`• ${s}`); ok = false; }; const good = s => out.push(`✓ ${s}`);
  const sh = c => { try { return execSync(c, { cwd, encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim(); } catch { return null; } };
  const slug = path.basename(dir).replace(/[^A-Za-z0-9._-]/g, '-');
  if (sh('git rev-parse --is-inside-work-tree') === 'true') {
    const dirty = sh('git status --porcelain'); const tag = `compass-restore-${slug}-${new Date().toISOString().slice(0, 19).replace(/[-:T]/g, '')}-${(sh('git rev-parse --short HEAD') || 'nohead')}`;
    if (dirty) bad(`restore point: NOT taken; the tree has uncommitted changes (${dirty.split('\n').length} files). Commit or stash first.`);
    else { sh(`git tag -a -m "compass restore point" ${tag}`); const head = sh('git rev-parse HEAD'); const at = sh(`git rev-parse --verify --quiet ${tag}^{commit}`); if (at && at === head) good(`restore point: tag ${tag} at ${head.slice(0, 7)} (undo: git reset --hard ${tag})`); else bad('restore point: git tag failed (signing or permissions); no undo point exists'); }
  } else bad('restore point: NOT taken; not a git repository. Make a copy of the deploy target by hand and record its path.');
  const plan = parsePlan(read(path.join(dir, 'plan.md'))); const s6 = planSection(plan, 6);
  if (s6 && !/^\s*none\b/im.test(s6) && !/not applicable/i.test(s6)) { if (opts.dataRestore) good(`data restore point: ${opts.dataRestore}`); else bad('data restore point: plan §6 changes data; name where the data copy is with --data-restore=<path or command>'); } else good('data restore point: not needed (plan §6 changes no data)');
  const example = ['.env.example', '.env.sample', '.env.template'].map(f => path.join(cwd, f)).find(f => fs.existsSync(f));
  if (example) {
    const keys = lines(read(example)).map(l => l.match(/^\s*([A-Z][A-Z0-9_]+)\s*=/)).filter(Boolean).map(m => m[1]);
    if (opts.envFrom) { const listed = (sh(opts.envFrom) || '').split(/\s+/); const missing = keys.filter(k => !listed.some(x => x === k || x.startsWith(k + '='))); if (missing.length) bad(`config keys on the target: ${missing.length} of ${keys.length} missing: ${missing.join(', ')}`); else good(`config keys on the target: ${keys.length} of ${keys.length} present (via --env-from)`); }
    else { const envFile = fs.existsSync(path.join(cwd, '.env')) ? read(path.join(cwd, '.env')) : ''; const present = new Set([...Object.keys(process.env), ...lines(envFile).map(l => (l.match(/^\s*([A-Z][A-Z0-9_]+)\s*=/) || [])[1]).filter(Boolean)]); const missing = keys.filter(k => !present.has(k)); bad(`config keys: checked on this machine only (${keys.length - missing.length} of ${keys.length} present here${missing.length ? `; missing: ${missing.join(', ')}` : ''}). Production was not checked; pass --env-from="<command that lists the target's keys>"`); }
  } else good('config keys: none declared (no .env.example); nothing to check');
  if (opts.health) { const code = sh(`curl -s -o /dev/null -w '%{http_code}' --max-time 10 "${opts.health}"`); if (code === '200') good(`health: ${opts.health} → 200`); else bad(`health: ${opts.health} → ${code || 'no answer'}`); }
  const files = (sh('git ls-files') || '').split('\n').filter(f => f && /\.(js|mjs|ts|py|sh|json|md|yml|yaml|toml|env|txt|html|css|sql)$/.test(f) && !/\.env\.example$/.test(f));
  const hits = []; for (const f of files) { let text = ''; try { text = fs.readFileSync(path.join(cwd, f), 'utf8'); } catch { continue; } lines(text).forEach((l, i) => { if (SECRET_PATTERNS.some(p => p.test(l))) hits.push(`${f}:${i + 1}`); }); }
  if (hits.length) bad(`secret scan: ${hits.length} hit(s): ${hits.slice(0, 5).join(', ')}${hits.length > 5 ? ', …' : ''}`); else good(`secret scan: 0 hits across ${files.length} tracked text files`);
  return { ok, lines: out };
}
function runbook(plan) { const s = planSection(plan, 19).split(/\r?\n/).map(l => l.trim()).filter(l => l && !/^<.*>$/.test(l)); const actions = s.filter(l => /→|->/.test(l)); return { lines: s, actions, ok: s.length >= 2 && actions.length >= 1 && !/not applicable/i.test(s.join(' ')) }; }
function releaseNote(dir) {
  const st = computeState(dir); const idea = parseIdea(read(path.join(dir, 'idea.md'))); const plan = parsePlan(read(path.join(dir, 'plan.md'))); const rb = runbook(plan);
  if (!rb.ok) return { error: 'release note refused: plan §19 Runbook needs at least one "how to run it" line and one "failure → action" line' };
  const out = [`# ${idea.title} — release note`, '', idea.purpose, ''];
  const ok = st.promises.filter(p => p.live && p.live.ok), bad = st.promises.filter(p => p.live && !p.live.ok), un = st.promises.filter(p => !p.live);
  if (st.promises.length <= 12) { out.push('What you can now do:'); for (const p of st.promises) out.push(`- ${p.text}${p.live ? ` (live: ${p.live.value} ${p.live.ok ? '✓' : '✗'})` : ' (not yet measured live)'}`); }
  else { out.push(`${ok.length} of ${st.promises.length} promises show their live number. By part: ${st.parts.map(pt => { const ps = st.promises.filter(p => p.part === pt.n); return `${ps.filter(p => p.live && p.live.ok).length}/${ps.length}`; }).join(' · ')}.`); if (bad.length) { out.push('', 'Not met yet:'); for (const p of bad) out.push(`- ${p.text} (live: ${p.live.value} ✗)`); } }
  if (un.length) out.push('', `${un.length} promise${un.length > 1 ? 's are' : ' is'} not yet measured live; marked on the Idea page.`);
  if (st.leftovers.length) { out.push('', st.leftovers.length <= 5 ? 'Set aside, accepted in writing:' : `${st.leftovers.length} items set aside in writing; the first three:`); for (const l of st.leftovers.slice(0, st.leftovers.length <= 5 ? 5 : 3)) out.push(`- ${l.text.replace(/\s+[—–-]\s.*$/, '')}`); if (st.leftovers.length > 5) out.push('- the rest are on the build card'); }
  if (idea.never.length) out.push('', `Not included, by design: ${idea.never.slice(0, 4).join('; ')}${idea.never.length > 4 ? '; and more on the Idea page' : ''}.`);
  if (st.watch) out.push('', `Watch period until ${st.watch}. After it, Compass re-measures; a ✗ reopens that part.`);
  out.push('', '## How to run it', ...rb.lines.slice(0, 12));
  return { text: out.join('\n') };
}

// ---------- plan check and plan card ----------
const PLAN_SECTIONS = ['Goal and promises', 'Non-goals', 'Current state', 'Proposed design', 'Alternatives considered', 'Data changes', 'Dependencies and blast radius', 'Walking skeleton', 'Slices and steps', 'Order and parallelism', 'Rollout', 'Rollback', 'Testing strategy', 'Definition of done', 'Observability', 'Failure modes', 'Security and privacy', 'Performance and capacity', 'Runbook', 'Assumptions and open questions', 'Decision log'];
function planCheck(dir) {
  const text = read(path.join(dir, 'plan.md')); if (!text) return ['plan.md missing'];
  const problems = []; const plan = parsePlan(text); const idea = parseIdea(read(path.join(dir, 'idea.md')));
  PLAN_SECTIONS.forEach((name, i) => { const h = plan.sections[i + 1]; if (!h) problems.push(`section ${i + 1} (${name}) missing`); else if (!h.toLowerCase().startsWith(name.toLowerCase().split(' ')[0])) problems.push(`section ${i + 1} is "${h}", expected "${name}"`); });
  const s3 = planSection(plan, 3); const repo = path.resolve(dir, '..', '..', '..');
  const cited = [...s3.matchAll(/`([^`\s]+\/[^`\s]*|[^`\s]+\.(?:md|js|mjs|ts|py|json|sh|html|css|sql|yml|yaml|toml))`/g)].map(m => m[1]);
  const exists = cited.filter(c => fs.existsSync(path.isAbsolute(c) ? c : path.join(repo, c.replace(/^\.\//, ''))));
  if (!/^\s*greenfield\b/im.test(s3) && !exists.length) problems.push(`§3 cites no path that exists in the target repo (${cited.length} cited)`);
  if (!plan.slices.length) problems.push('no ### Slice blocks'); else if (!/skeleton/i.test(plan.slices[0].title)) problems.push(`slice 1 is "${plan.slices[0].title}", must be the walking skeleton`);
  const served = new Set(plan.steps.flatMap(s => s.promises)); for (const p of idea.promises) if (!served.has(p.id)) problems.push(`${p.id} has no step`);
  for (const s of plan.steps) {
    if (!s.promises.length) problems.push(`${s.id} serves no promise`);
    for (const pid of s.promises) if (!idea.promises.find(p => p.id === pid)) problems.push(`${s.id} cites ${pid}, which is not on the Idea page`);
    if (!s.verify.cmd) problems.push(`${s.id}: verify needs one backticked command first, then "→ <expected output>"`); else if (!s.verify.expected) problems.push(`${s.id}: verify needs "→ <expected output>" after the command`);
    if (s.estimate && s.estimate > 6) problems.push(`${s.id} is estimated at ${s.estimate} h; a step fits one sitting (≤ 6 h), split it`);
  }
  if (!fs.existsSync(path.join(dir, 'spec.md'))) problems.push('spec.md missing; the plan binds to it'); else problems.push(...specCheck(dir).map(p => 'spec: ' + p));
  if (!runbook(plan).ok) problems.push('§19 Runbook needs a "how to run it" line and a "failure → action" line');
  return problems;
}
function planCard(dir) {
  const st = computeState(dir); const out = [];
  out.push(`${st.title} · plan v${st.version} · ${st.slices.length} slices · ${st.steps.total} steps · ${st.promises.length} promises, all traced`, '', 'Slices, in order');
  for (const s of st.slices) out.push(`  ${String(s.n).padStart(2)}  ${s.title}${s.n === 1 ? ' (the skeleton: runs end to end first)' : ''}  · ${s.total} steps`);
  if (st.risks.length) { out.push('', 'The biggest risks, and what I do about each'); st.risks.slice(0, 3).forEach((r, i) => out.push(`  ${i + 1}. ${r.text}`)); }
  if (st.questions.length) { out.push('', 'Questions for you'); for (const q of st.questions) out.push(`  · ${q.text}`); }
  return out;
}

// ---------- the active build ----------
function findBuild(cwd) {
  const root = path.join(cwd, '.claude', 'builds'); let best = null, bestT = -1;
  for (const name of (fs.existsSync(root) ? fs.readdirSync(root) : [])) {
    const d = path.join(root, name); if (!fs.existsSync(path.join(d, 'idea.md'))) continue;
    const rs = parseReceipts(read(path.join(d, 'receipts.md'))); const last = rs.length ? Date.parse(rs[rs.length - 1].ts) || 0 : 0;
    const t = last || Math.max(...['receipts.md', 'idea.md', 'plan.md'].map(f => { try { return fs.statSync(path.join(d, f)).mtimeMs / 1e6; } catch { return 0; } }));
    if (t > bestT) { bestT = t; best = d; }
  }
  return best;
}

// ---------- main ----------
const [verb, ...args] = process.argv.slice(2);
const flag = (name, def) => { const a = args.find(x => x.startsWith(`--${name}=`)); return a ? a.slice(name.length + 3) : def; };
const dirArg = args[0] && !args[0].startsWith('--') ? args[0] : null;
const resolveDir = () => (dirArg && dirArg !== 'auto') ? path.resolve(dirArg) : findBuild(process.cwd());
const needDir = () => { const d = resolveDir(); if (!d) die('no build folder here'); return d; };
const wrapFull = html => `<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">${html.replace(/<\/style>/, '</style></head><body>')}</body></html>`;
const renderAndWriteCard = dir => { const out = flag('out', path.join(dir, 'card.html')); let html = renderCard(computeState(dir), dir); if (args.includes('--full')) html = wrapFull(html); fs.writeFileSync(out, html); return out; };

if (verb === 'state') { const d = resolveDir(); if (!d) { console.log('No build here. Type /compass to start one.'); process.exit(0); } const st = computeState(d); console.log(args.includes('--json') ? JSON.stringify(st, null, 2) : st.line); }
else if (verb === 'line') { const d = resolveDir(); if (d) console.log(computeState(d).line); }
else if (verb === 'card') { console.log(renderAndWriteCard(needDir())); }
else if (verb === 'receipt') {
  const [dir, stage, result, ...rest] = args; if (!dir || !stage || !result) die('usage: compass receipt <dir> <stage> <result> [line ...]');
  const err = validateReceipt(path.resolve(dir), stage, result, rest); if (err) die(`receipt refused: ${err}`, 2);
  console.log(appendReceipt(path.resolve(dir), stage, result, rest));
}
else if (verb === 'answer') {
  const dir = path.resolve(args[0] || ''); const sub = args[1]; const rest = args.slice(2);
  if (!args[0] || !sub) die('usage: compass answer <dir> set <key> "<value>" | part <n> --title= --picture= --prose= --promise=… | journey "<key>: <caption>"… | later "…"… | never "…"… | question <k> <n>');
  fs.mkdirSync(dir, { recursive: true }); const slug = path.basename(dir); if (/\s/.test(slug)) die('the build folder name has a space; use kebab-case');
  const text = read(path.join(dir, 'idea.md')); const idea = text ? parseIdea(text) : parseIdea(`# Idea — ${slug}\n`); idea.slug = slug;
  const getFlag = (n, src) => { const a = src.find(x => x.startsWith(`--${n}=`)); return a ? a.slice(n.length + 3) : null; };
  if (sub === 'set') { const [k, ...v] = rest; if (!HEAD_KEYS.includes(k) || k === 'approved') die(`set: unknown key ${k}`); idea[k] = v.join(' '); }
  else if (sub === 'part') { const n = +rest[0]; if (!n) die('part needs a number'); let p = idea.parts.find(x => x.n === n); if (!p) { p = { n, title: '', picture: '', prose: [], promises: [], sketch: '', mock: '' }; idea.parts.push(p); idea.parts.sort((a, b) => a.n - b.n); }
    const t = getFlag('title', rest); if (t) p.title = t; const pic = getFlag('picture', rest); if (pic) p.picture = pic; const prose = getFlag('prose', rest); if (prose) p.prose = [prose]; const mock = getFlag('mock', rest); if (mock) p.mock = mock; const sk = getFlag('sketch', rest); if (sk) p.sketch = sk;
    const proms = rest.filter(x => x.startsWith('--promise=')).map(x => x.slice(10)); if (proms.length) { p.promises = proms.map((s, i) => { const at = s.lastIndexOf('→'); const m = s.match(/^(P\d+\.\d+)\s+/); return { id: m ? m[1] : `P${n}.${i + 1}`, part: n, text: (at >= 0 ? s.slice(0, at) : s).replace(/^P\d+\.\d+\s+/, '').trim(), number: at >= 0 ? s.slice(at + 1).trim() : '' }; }); }
    if (args.includes('--remove')) idea.parts = idea.parts.filter(x => x.n !== n); }
  else if (sub === 'journey') { idea.journey = rest.filter(x => !x.startsWith('--')).map(s => { const m = s.match(/^([\w:./-]+):\s*(.+)$/); return m ? { picture: m[1], caption: m[2] } : null; }).filter(Boolean); }
  else if (sub === 'later') idea.later = rest.filter(x => !x.startsWith('--'));
  else if (sub === 'never') idea.never = rest.filter(x => !x.startsWith('--'));
  else if (sub === 'question') { const [k, n] = rest; if (!k || !n) die('question <k> <n>'); appendReceipt(dir, 'idea', `question ${k} of ${n} answered`, [`answered: question ${k}`]); }
  else die(`answer: unknown subcommand ${sub}`);
  idea.promises = idea.parts.flatMap(p => p.promises);
  fs.writeFileSync(path.join(dir, 'idea.md'), serializeIdea(idea));
  const problems = lintIdea(dir, idea); const st = computeState(dir);
  fs.writeFileSync(path.join(dir, 'idea-page.html'), renderIdeaPage(dir, idea, st));
  console.log(`Idea page updated · ${idea.parts.length} parts · ${idea.promises.length} promises${problems.length ? ` · still to fill: ${problems.length}` : ' · complete'}`);
  if (args.includes('--verbose')) for (const p of problems) console.log('  · ' + p);
}
else if (verb === 'idea-page') {
  const dir = needDir(); const idea = parseIdea(read(path.join(dir, 'idea.md'))); const problems = lintIdea(dir, idea);
  if (args.includes('--check')) { for (const p of problems) console.log('✗ ' + p); console.log(problems.length ? `${problems.length} problems` : '✓ idea.md is within limits'); process.exit(problems.length ? 1 : 0); }
  if (problems.length) { for (const p of problems) console.error('✗ ' + p); process.exit(1); }
  const out = flag('out', path.join(dir, 'idea-page.html')); let html = renderIdeaPage(dir, idea, computeState(dir)); if (args.includes('--full')) html = wrapFull(html); fs.writeFileSync(out, html); console.log(out);
}
else if (verb === 'spec-check') { const dir = needDir(); const p = specCheck(dir); for (const x of p) console.log('✗ ' + x); console.log(p.length ? `${p.length} problems` : '✓ every rule points at a promise on the Idea page'); process.exit(p.length ? 1 : 0); }
else if (verb === 'plan-check') { const dir = needDir(); const p = planCheck(dir); for (const x of p) console.log('✗ ' + x); console.log(p.length ? `${p.length} problems` : '✓ plan: 21 sections, scan cited, skeleton first, every promise has a step, every step has a command and an expected output, spec and runbook present'); process.exit(p.length ? 1 : 0); }
else if (verb === 'plan-card') { const dir = needDir(); const ls = planCard(dir); console.log(ls.join('\n')); if (ls.length > 40) { console.error(`plan-card is ${ls.length} lines; the screen is 40`); process.exit(3); } }
else if (verb === 'attacks') { const dir = needDir(); const stage = args[1] && !args[1].startsWith('--') ? args[1] : 'build'; const rows = chooseAttacks(dir, stage); writeAttacks(dir, stage, rows); console.log(`${rows.length} attacks for stage ${stage} → attacks.md`); if (args.includes('--json')) console.log(JSON.stringify(rows, null, 2)); }
else if (verb === 'attack-receipt-check') { if (args[0] === '--look') { const ok = !!parseLookLine(args.slice(1).join(' ')); console.log(ok ? 'ok' : 'rejected: a look reviewer\'s last line must be `scores: <13 items>=<1-5> | low: item@"region"; …`'); process.exit(ok ? 0 : 1); } const err = checkReceiptLine(args.join(' ')); console.log(err || 'ok'); process.exit(err ? 1 : 0); }
else if (verb === 'shots') { const target = args[0]; if (!target) die('usage: compass shots <file.html|url> [--out=dir] [--name=x] [--states=empty,error]'); const r = shots(target, flag('out', path.join(process.cwd(), 'shots')), flag('name', path.basename(target).replace(/\.\w+$/, '') || 'page'), (flag('states', '') || '').split(',').filter(Boolean)); if (r.error) die(r.error, 2); for (const f of r.files) console.log(f); }
else if (verb === 'look-score') { const [level, ...ls] = args; if (!level || ls.length !== 3) die('usage: compass look-score <premium|clean|match> "<line>" "<line>" "<line>"'); const r = lookScore(level, ls); if (r.error) die(r.error, 2); console.log(r.result); process.exit(r.result === 'held' ? 0 : 3); }
else if (verb === 'rubric-check') { const p = rubricLint(); for (const x of p) console.log('✗ ' + x); console.log(p.length ? `${p.length} problems` : `✓ rubric: ${LOOK_ITEMS.length} items with anchors, 3 bars`); process.exit(p.length ? 1 : 0); }
else if (verb === 'gates') {
  const dir = needDir(); const { promiseChecks, breakChecks, noCheck } = gateSuite(dir);
  if (args.includes('--run')) { const rs = runGates(dir, flag('target', process.cwd())); for (const r of rs) console.log(`${r.ok ? '✓' : '✗'} ${r.kind === 'promise' ? 'promise' : 'break  '} ${r.id} · ${r.cmd} → ${r.out}${r.ok ? '' : ` (expected: ${r.expected})`}`); const red = rs.filter(r => !r.ok).length; if (!rs.length) { console.log('✗ no gate checks found: every step needs `command` → expected'); process.exit(1); } console.log(`\n${rs.length - red} of ${rs.length} gate checks green${noCheck.length ? ` · no check for: ${noCheck.join(', ')}` : ''}`); process.exit(red ? 1 : 0); }
  console.log(`Gate suite for ${path.basename(dir)}: ${promiseChecks.length} promise checks + ${breakChecks.length} checks born from breaks. Nothing else gates progress.${noCheck.length ? ` No check yet for: ${noCheck.join(', ')}` : ''}`);
  for (const c of promiseChecks) console.log(`  promise ${c.promise} ← ${c.step}: ${c.cmd} → ${c.expected || 'exit 0'}`); for (const c of breakChecks) console.log(`  break   ${c.attack}: ${c.file}`);
}
else if (verb === 'preflight') { const dir = needDir(); const r = preflight(dir, process.cwd(), { envFrom: flag('env-from', null), dataRestore: flag('data-restore', null), health: flag('health', null) }); for (const l of r.lines) console.log(l); console.log(r.ok ? '✓ pre-flight passed' : '✗ pre-flight failed; nothing deployed'); process.exit(r.ok ? 0 : 1); }
else if (verb === 'writeback') {
  const dir = needDir(); if (args.some(a => /^P\d+\.\d+=/.test(a))) die('writeback measures; it does not take values. Run it with --target=<path or url> and it runs every promise\'s check itself.');
  const target = flag('target', process.cwd()); const watch = flag('watch-until', ''); const st0 = computeState(dir);
  if (!st0.flags.released) die('writeback before released: record the release first', 2);
  const rs = runGates(dir, target); const { noCheck } = gateSuite(dir); const body = [];
  for (const p of st0.promises) { const mine = rs.filter(r => r.kind === 'promise' && r.id.startsWith(p.id + ' ')); if (!mine.length) { body.push(`${p.id}: not measured (no runnable check)`); continue; } const ok = mine.every(r => r.ok); const val = mine.map(r => r.out).filter(Boolean).slice(0, 1).join('') || mine[0].expected; body.push(`${p.id}: live ${val.slice(0, 60)} ${ok ? '✓' : '✗'}`); }
  body.push(`target: ${target}`); if (watch) body.push(`watch: until ${watch}`);
  appendReceipt(dir, 'deploy', 'writeback', body);
  const idea = parseIdea(read(path.join(dir, 'idea.md'))); fs.writeFileSync(path.join(dir, 'idea-page.html'), renderIdeaPage(dir, idea, computeState(dir)));
  const okN = body.filter(l => /✓$/.test(l)).length, badN = body.filter(l => /✗$/.test(l)).length;
  console.log(`measured on ${target}: ${okN} ✓ · ${badN} ✗ · ${noCheck.length} not measured; idea-page.html re-rendered`); process.exit(badN ? 3 : 0);
}
else if (verb === 'release-note') { const dir = needDir(); const r = releaseNote(dir); if (r.error) die(r.error, 2); fs.writeFileSync(path.join(dir, 'release-note.md'), r.text); console.log(r.text); const words = r.text.split(/\s+/).length; if (words > 260) { console.error(`release note is ${words} words; keep it under 260 including the runbook`); process.exit(3); } }
else { console.log('usage: compass state|line|card|receipt|answer|idea-page|spec-check|plan-check|plan-card|attacks|attack-receipt-check|shots|look-score|rubric-check|gates|preflight|writeback|release-note'); process.exit(verb ? 1 : 0); }
